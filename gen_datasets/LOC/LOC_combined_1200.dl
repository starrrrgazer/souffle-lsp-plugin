//triangle

.type Text <: symbol

.decl addrecurse(b:number, result:Text, level:number)

addrecurse(b,cat(cat("*",result),"*"),level+1) :- addrecurse(b,result,level), level!=b.

addrecurse(12,"*",0).


.decl out(result:Text)
.output out()

out(result) :- addrecurse(_,result,_).


// ==== END: d:\work24\souffle-lsp-plugin\example\triangle\triangle.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-multilvl\comp-parametrized-multilvl.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt



.comp NumGenerator {
    .decl R(n:number)
}

.comp LotsOfNumGenerator : NumGenerator {
    R(0).
    R(n+1) :- R(n), n <= 10.
}

.comp BiggerNumGenerator : LotsOfNumGenerator {
    R(22).
}

.comp NumSelector<T> {
    .init generator = T
    .decl Selected(n: number)
    Selected(n) :- generator.R(n), generator.R(n*2).
}

.comp GoodNumSelector<T> : NumSelector<T> {
    Selected(42).
}

.comp Main<TSelector, TGenerator> {
    .init selector = TSelector<TGenerator>
    .decl Out(n:number)
.output Out()
    Out(x) :- selector.Selected(x).
}

.init main1 = Main<NumSelector, LotsOfNumGenerator>
.init main2 = Main<GoodNumSelector, LotsOfNumGenerator> // selects 42, even if it is not generated
.init main3 = Main<NumSelector, BiggerNumGenerator> // selects 22 = 2*11


// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-multilvl\comp-parametrized-multilvl.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\fib1\fib1.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl fib(n:number, x:number)

fib(0, 0).
fib(1, 1).

fib(n+1, x+y) :- fib(n, x), fib(n-1, y), n < 20.

.output fib

// ==== END: d:\work24\souffle-lsp-plugin\example\fib1\fib1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Solves the n-queens problem

// Side length of the board.
.decl size( n : number )
.input size()


// The maximal compatible sets -- n queens.
.decl solution( qs : QueenList )
.printsize solution
solution(qs) :- compatible(qs, s), size(s).


// Natural numbers from 1 to the size of the board.
.decl up_to_size( x : number )
up_to_size(1).
up_to_size(x + 1) :- up_to_size(x), !size(x).


// A cartesian coordinate for a board square.
.type Position = [ x : number, y : number ]


// This relation holds the position of each square of the board.
.decl on_board( p : Position )
on_board([x, y]) :- up_to_size(x), up_to_size(y).


// Mutually-non-attacking list of queen positions.
.type QueenList = [ p : Position, qs : QueenList ]


// Arguments are not on the same diagonal.
.decl non_diagonals( p : Position, q : Position )
non_diagonals([px, py], [qx, qy]) :- px - qx != py - qy, qx - px != py - qy, on_board([px, py]), on_board([qx, qy]).


// Holds if p and q do not attack each other.
.decl sympathetic( p : Position, q : Position )
sympathetic(p, q) :- non_diagonals(p, q), px != qx, py != qy, p=[px, py], q=[qx,qy].


// Holds if the head of qs is mutually non-attacking with its tail, which should itself be compatible.
// Generated column by column, left to right.
.decl compatible( qs : QueenList, n : number )
compatible([p, nil], 1) :- on_board(p). //, p = [1,y].
compatible([p, [head, tail]], n+1) :- sympathetic(p, head), compatible([p, tail], n), compatible([head, tail], n), p = [px, py], head = [hx, hy], px > hx.

// ==== END: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Relation(a:symbol, b:symbol, step:number,turn:symbol)
Relation(a, c, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
    			a!=c.

Relation(d, e, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
			Relation(d, e, step, a),
    			a!=c,
			d!=a,
			d!=b.



.output Relation

Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","d",0,"a").
Relation("d","e",0,"a").
Relation("e","f",0,"a").
Relation("f","a",0,"a").


/*
 // Small test case:
Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","a",0,"a").
*/

.decl Josephus(a:symbol)
Josephus(a) :-
			Relation(a, b, step, a),
			Relation(b, a, step, a).
.output Josephus

// ==== END: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\fib\fib.dl ====
.type Integer <: symbol

.decl plus_mod (x:Integer, y:Integer, r:Integer)
.decl succ (a:Integer, b:Integer)
.decl f(x:Integer, y:Integer)
.output f()

f("0", "0").
f("1", "1").
f(i, r) :- succ(prev, i), succ(pprev, prev),f(prev, x), f(pprev, y), plus_mod(x, y, r).


plus_mod("0", "0", "0").
plus_mod("0", "1", "1").
plus_mod("1", "0", "1").
plus_mod("1", "1", "2").
plus_mod("0", "2", "2").
plus_mod("2", "0", "2").
plus_mod("2", "1", "0").
plus_mod("1", "2", "0").
plus_mod("2", "2", "1").


succ("0", "1").
succ("1", "2").
succ("2", "3").
succ("3", "4").
succ("4", "5").
succ("5", "6").
succ("6", "7").
succ("7", "8").
succ("8", "9").
succ("9", "10").
succ("10", "11").
succ("11", "12").
succ("12", "13").
succ("13", "14").
succ("14", "15").
succ("15", "16").
succ("16", "17").
succ("17", "18").
succ("18", "19").
succ("19", "20").


// ==== END: d:\work24\souffle-lsp-plugin\example\fib\fib.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Y),
  orbits(_,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Subtracts the number of `-` from the number of `+`

.type index <: number
.type counter <: number
.type program <: symbol

.decl torun(p : program)
.input torun

.decl progress(i : index, c : counter, p : program)
progress(0,0,p) :- torun(p).
progress(i+1,c+1,p) :- progress(i,c,p), "+"=substr(p,i,1).
progress(i+1,c-1,p) :- progress(i,c,p), "-"=substr(p,i,1).
progress(i+1,c,p) :-
    progress(i,c,p),
    i < strlen(p),
    "+" != substr(p,i,1),
    "-" != substr(p,i,1).

.decl result(c : counter, p : program)
result(c,p) :- progress(strlen(p),c,p).
.output result

// ==== END: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Var <: symbol

.decl conf(num : number)
conf(x+1) :- conf(x), !lim(x).
conf(0).

.decl lim(x : number)
.input lim()

.decl var_index(var : Var, index : number)
var_index("a", 0).
var_index("b", 1).
var_index("c", 2).

.decl translation(conf : number, var : Var, truthy : number)
translation(n, var, 1) :- var_index(var, k), conf(n), ((2^k) band n) != 0.
translation(n, var, 0) :- var_index(var, k), conf(n), ((2^k) band n) = 0.

.decl circuit_and(result: Var, op1: Var, op2: Var)
.input circuit_and()
.decl circuit_or(result: Var, op1: Var, op2: Var)
.input circuit_or()
.decl circuit_not(result: Var, op1: Var)
.input circuit_not()
.decl circuit_result(result: Var)
.input circuit_result()

.decl evaluate(conf: number, var: Var, truthy: number)
evaluate(conf, var, value) :-
 translation(conf, var, value).
evaluate(conf, var, v1 band v2) :-
 circuit_and(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, v1 bor v2) :-
 circuit_or(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, lnot v1) :-
 circuit_not(var, op1),
 evaluate(conf, op1, v1).

.decl satisfy(conf: number, var : Var)
.output satisfy()
satisfy(conf, inputvar) :-
 circuit_result(var),
 evaluate(conf, var, 1),
 var_index(inputvar, _),
 translation(conf, inputvar, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2020, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// This example shows a simple rewrite system using records
// and equivalence relations. An expression is expressed via
// recursively defined records. Each sub-tree in the expression
// can be rewritten. Equivalent terms are put into the same
// equivalence class.

// Expression
.type Expr=[
   op:symbol,   // operand: +,-,*,+, <=, !, >=, <, >
   left:Expr,   // left operand (if needed)
   right:Expr,  // right operand (if needed)
   nval:number, // number if op is "num"; otherwise not used
   var:symbol   // variable symbol if op is "var"; otherwise not used
]

// Input expressions
.decl A(e:Expr)
A(
   ["!",
      ["<",
       ["+",["num",nil,nil,10,""],["B",nil,nil,20,""],0, ""],
       ["+",["num",nil,nil,30,""],["B",nil,nil,40,""],0, ""], 0,""],
      nil,
      0,""]).

// Term-Rewriter
.decl S(e1:Expr, e2:Expr) eqrel

// Populate input
S(e, e) :-
   A(e).

// Put sub-expression into equivalence class
S(right,right) :-
   S([_,_,right,_,_],_).

S(left,left) :-
   S([_,left,_,_,_],_).

// Recombine sub-expressions from equivalence classes
S([op, newLeft, newRight, num, sym], x) :-
  S([op, left, right, num, sym], x),
  S(left, newLeft),
  S(right, newRight).

// Rewrite rules (examples)

// rewrite rule num1 + num2 => num3 where num3 is num1+num2
S(["num", nil, nil, a+b, ""],x) :-
   S(["+", ["num", _, _, a, _],
           ["num", _, _, b, _], _, _], x).

// rewrite rule !(a < b) => a >= b
S([">=", a, b, 0, ""],x) :-
   S(["!", ["<", a, b, _, _], nil, _, _],x).

// compute size of each expression
.decl ExprSize(x:Expr, m:number)
ExprSize(nil, 0).
ExprSize([op, left, right, num, sym], d1 + d2 + 1) :-
   S([op, left, right, num, sym], _),
   ExprSize(left, d1),
   ExprSize(right, d2).

// find smallest expression for each input
// the solution might not be unique.
.decl B(e1:Expr, e2:Expr)
B(e1, e2) :-
   A(e1),
   min_d = min d: {S(e1, e2), ExprSize(e2, d)},
   S(e1,e2),
   ExprSize(e2, min_d).

.output B

// ==== END: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====

