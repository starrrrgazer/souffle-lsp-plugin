// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tc\tc.dl ====
//// Reproduced from [FD92]
//// Adopted from DES

.type Node <: symbol

.decl tcl  (node1:Node, node2:Node)
.output tcl  ()
.decl tcr  (node1:Node, node2:Node)
.output tcr  ()
.decl base (node1:Node, node2:Node)
.output base ()
.input base ()
.decl tc (node1:Node, node2:Node)
.output tc ()

// Left-Recursive Transitive Closure
tcl(X, Y) :- base(X,Y).
tcl(X,Y) :- tcl(X,Z), base(Z,Y).

// Right-recursive Transitive Closure
tcr(X,Y) :- base(X,Y).
tcr(X,Y) :- base(X, Z),tcr(Z,Y).

// Double-recursive Transitive Closure
tc(X,Y) :- base(X,Y).
tc(X,Y) :- tc(X,Z),tc(Z,Y).

// base relation
base("a","b").
base("b","c").
base("c","d").

// ==== END: d:\work24\souffle-lsp-plugin\example\tc\tc.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp Impl {
    .decl R(x: number)
    R(0). R(1). R(2).
}

.comp A<T> {
    .init impl = T
    .decl Base(x: number)
    Base(x) :- impl.R(x).
}

.comp Derived<K> : A<K> {
    .decl Deriv(x:number)
    Deriv(42).
    Deriv(n) :- Base(n).
}

.init d = Derived<Impl>
.init a = A<Impl>

.decl DerivedOut(x: number)
.output DerivedOut()
.decl AOut(x: number)
.output AOut()

DerivedOut(x) :- d.Deriv(x).
AOut(x) :- a.Base(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\ranpo\ranpo.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, _, e, _), In(a, b, c, _, e, _, i).
A(3,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(4,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(5,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(6,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(7, i) :- Check(_,_, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(_, b, _, d, _, f), In(_, b, _, d, _, f, i).
A(9, i) :- Check(a, b, _, d, _, f), In(a, b, _, d, _, f, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\ranpo\ranpo.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Node <: symbol
.type Card <: number

.decl Edge			(m:Node, n:Node)
.input Edge

Edge(m, n) :- Edge(n, m).

.decl Leaf			(n:Node)
.decl NotLeaf		(n:Node)

NotLeaf(n) :- Edge(a, n), Edge(b, n), a != b.
Leaf(n) :- Edge(_, n), !NotLeaf(n).

.decl InSubtree		(m:Node, n:Node, a:Node)

InSubtree(m, n, n) :- Edge(m, n).
InSubtree(m, n, a) :- Edge(m, n), Edge(n, p), InSubtree(n, p, a), m != p.

.decl TreeCard		(c:Card)
.decl SubtreeCard	(m:Node, n:Node, c:Card)

TreeCard(a + b) :- a = sum 1 : Leaf(_), b = sum 1 : NotLeaf(_).

SubtreeCard(m, n, c) :- Edge(m, n), c = sum 1 : InSubtree(m, n, _).

.decl Centroid		(n:Node)
.decl NotCentroid	(n:Node)

NotCentroid(n) :- TreeCard(c), SubtreeCard(n, _, d), d > c/2.
Centroid(n) :- Edge(n, _), !NotCentroid(n).

.output Centroid

// ==== END: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

// some subsets
.decl A( x : number )
.decl B( x : number )
.decl C( x : number )
.decl D( x : number )
.decl E( x : number )


// A
A(0).

// B
B(1).
B(2).
B(3).

// C
C(4).
C(5).
C(6).

// D
D(3).
D(4).

// E
E(6).
E(7).

// the universe
.decl U( x : number )
.output U()
U(X) :- A(X) ; B(X) ; C(X) ; D(X); E(X) .

// an empty set
.decl N( x : number )
.output N()
N(X) :- A(X), B(X).


.decl R1( x : number )
.output R1()
R1(X) :- A(X) ; B(X) , D(X) .

.decl R2( x : number )
.output R2()
R2(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R3( x : number )
.output R3()
R3(X) :- U(X) , !( B(X) , D(X) ) .

.decl R4( x : number )
.output R4()
R4(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R5( x : number )
.output R5()
R5(X) :- U(X) , !!!( B(X) ; D(X) ) .

.decl R6( x : number )
.output R6()
R6(X) :- (!B(X) ; D(X)) , U(X) .


// ==== END: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

