// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute the factorial function.

// fact(i, n) holds iff i! = n
.decl fact(i:number, n:number)
.output fact()

// Calculate only up to the lowest value satisfying lim(n)
.decl lim(n:number)
.input lim()

fact(I+1, N*(I+1)) :- fact(I, N), !lim(I).

// Ground Fact: 0! := 1
fact(0, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\factorial\factorial.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\traffic\traffic.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Street <: symbol

.decl greenSignal(s:Street)
.decl hasTraffic(s:Street)
.decl intersect(s1:Street, s2:Street)
.decl crashable(s1:Street, s2:Street)
.decl crashes(s:Street)

.output crashable
.output crashes

crashable(X, Y) :- intersect(X, Y), greenSignal(X), greenSignal(Y).
crashes(X) :- hasTraffic(X), crashable(X, Y), hasTraffic(Y).
crashes(X) :- hasTraffic(X), crashable(Y, X), hasTraffic(Y).

greenSignal("Abercrombie St").
greenSignal("Cleveland St").
greenSignal("Shepard St").
greenSignal("Elizabeth St").
greenSignal("Goulburn St").

hasTraffic("Abercrombie St").
hasTraffic("Lawson St").
hasTraffic("Elizabeth St").
hasTraffic("Goulburn St").

intersect("Abercrombie St", "Lawson St").
intersect("Cleveland St", "Shepard St").
intersect("Elizabeth St", "Goulburn St").

