.type Integer <: symbol

.decl succ (a:Integer, b:Integer)
.decl equal(x:Integer, y:Integer, r:Integer)
.output equal()
.decl isEqual(r:Integer)
.output isEqual()

equal("0", "0", "1").
equal(m, n, r) :- succ(pm, m) , succ(pn, n), equal(pm, pn, r).

isEqual(r) :- equal("5", "7", r).

succ("0", "1").
succ("1", "2").
succ("2", "3").
succ("3", "4").
succ("4", "5").
succ("5", "6").
