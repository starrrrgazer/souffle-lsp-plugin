// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find all disconnected node pairs
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find the connected nodes
.decl Connected(n:Node, m:Node)
Connected(n, n) :- Edge(n, _, _).
Connected(n, n) :- Edge(_, n, _).
Connected(n, m) :- Edge(n, m, _).
Connected(n, m) :- Edge(n, z, _), Connected(z, m).

// Find nodes without a connection
.decl DisConnected(n:Node, m:Node)
.output DisConnected()
DisConnected(n, m) :- Edge(n, _, _), Edge(_, m, _), !Connected(n, m).
DisConnected(n, m) :- Edge(n, _, _), Edge(m, _, _), !Connected(n, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(5,i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(6,i) :- Check(a, b, c, d, e, _), In(a, b, c, d, e, _, i).

A(7, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(9, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(10, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(11, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).

A(12, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(13, i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(14, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(15, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).

A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(18, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).

A(19, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====

