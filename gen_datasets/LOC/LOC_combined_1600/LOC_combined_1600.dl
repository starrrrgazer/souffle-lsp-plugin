// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Tests rules containing body literals that are independent of the
// head arguments (i.e. they are 'constant' wrt. head arguments).

.decl a(x:number)
a(x) :- b(x), c(y), d(y).

.decl b(x:number)
b(0).
b(x+1) :- a(x), x < 1000000.

.decl c(x:number)
c(0).
c(x+2) :- c(x), x < 1000.

.decl d(x:number)
d(0).
d(x+3) :- d(x), x < 1000.

.decl query(x:number)
.output query()
query(x) :- a(x), x < 10.

// ==== END: d:\work24\souffle-lsp-plugin\example\independent_body3\independent_body3.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type State <: number
.type Letter <: symbol

.decl Q				(q:State)
.decl Init			(q:State)
.decl Final			(q:State)
.decl Tr			(q:State, a:Letter, r:State)

.input Final
.input Tr

Init(0).

Q(q) :- Tr(q, _, _).

.decl Dis			(q:State, r:State)

Dis(q, r) :- Q(q), Q(r), Final(q), !Final(r).
Dis(q, r) :- Tr(q, a, s), Tr(r, a, t), Dis(s, t).
Dis(q, r) :- Dis(r, q).

.decl Equiv		(q:State, r:State)

Equiv(q, r) :- Q(q), Q(r), !Dis(q, r).

.decl NotMinEquiv	(q:State, r:State)
.decl MinEquiv		(q:State, r:State)

NotMinEquiv(q, r) :- Equiv(q, r), Equiv(q, s), s < r.
MinEquiv(q, r) :- Equiv(q, r), !NotMinEquiv(q, r).

.output MinEquiv

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====
//// Farmer-Wolf-Goat-Cabbage Puzzle
//// Adopted from DES

.type Node <: symbol

.decl safe  (node1:Node, node2:Node, node3:Node, node4:Node)
.output safe  ()
.decl state (node1:Node, node2:Node, node3:Node, node4:Node)
.output state ()
.decl opp   (node1:Node, node2:Node)
.output opp   ()

// Initial state
state("n","n","n","n").
// Farmer takes Wolf
state(X,X,U,V) :-
  safe(X,X,U,V),
  opp(X,X1),
  state(X1,X1,U,V).
// Farmer takes Goat
state(X,Y,X,V) :-
  safe(X,Y,X,V),
  opp(X,X1),
  state(X1,Y,X1,V).
// Farmer takes Cabbage
state(X,Y,U,X) :-
  safe(X,Y,U,X),
  opp(X,X1),
  state(X1,Y,U,X1).
// Farmer goes by himself
state(X,Y,U,V) :-
  safe(X,Y,U,V),
  opp(X,X1),
  state(X1,Y,U,V).

// Opposite shores (n/s)
opp("n","s").
opp("s","n").

// Farmer is with Goat

// TODO: This triggers segfault
// safe(X,Y,X,V) :- safe(X,_,X,_).

// Rewrite non-ground rule  'safe(X,Y,X,V)' to:
safe("n","s","n","s").
safe("n","n","n","n").
safe("n","s","n","n").
safe("n","n","n","s").
safe("s","s","s","s").
safe("s","n","s","n").
safe("s","s","s","n").
safe("s","n","s","s").

// Farmer is not with Goat
safe(X,X,X1,X) :- opp(X,X1).


// ==== END: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====
// Type declarations
.type S <: symbol

// Set output flag depending on stage
.decl A (x:S, y:S)
.output A ()

// Transitive Closure
A(x,z) :- A(x,y), A(y,z).

// Facts
A("a","b").
A("b","c").
A("c","d").
A("d","e").

// ==== END: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====

