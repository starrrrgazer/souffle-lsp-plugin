// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====
// Type declarations
.type S <: symbol

// Set output flag depending on stage
.decl A (x:S, y:S)
.output A ()

// Transitive Closure
A(x,z) :- A(x,y), A(y,z).

// Facts
