// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2020, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// This example shows a simple rewrite system using records
// and equivalence relations. An expression is expressed via
// recursively defined records. Each sub-tree in the expression
// can be rewritten. Equivalent terms are put into the same
// equivalence class.

// Expression
.type Expr=[
   op:symbol,   // operand: +,-,*,+, <=, !, >=, <, >
   left:Expr,   // left operand (if needed)
   right:Expr,  // right operand (if needed)
   nval:number, // number if op is "num"; otherwise not used
   var:symbol   // variable symbol if op is "var"; otherwise not used
]

// Input expressions
.decl A(e:Expr)
A(
   ["!",
      ["<",
       ["+",["num",nil,nil,10,""],["B",nil,nil,20,""],0, ""],
       ["+",["num",nil,nil,30,""],["B",nil,nil,40,""],0, ""], 0,""],
      nil,
      0,""]).

// Term-Rewriter
.decl S(e1:Expr, e2:Expr) eqrel

// Populate input
S(e, e) :-
   A(e).

// Put sub-expression into equivalence class
S(right,right) :-
   S([_,_,right,_,_],_).

S(left,left) :-
   S([_,left,_,_,_],_).

// Recombine sub-expressions from equivalence classes
S([op, newLeft, newRight, num, sym], x) :-
  S([op, left, right, num, sym], x),
  S(left, newLeft),
  S(right, newRight).

// Rewrite rules (examples)

// rewrite rule num1 + num2 => num3 where num3 is num1+num2
S(["num", nil, nil, a+b, ""],x) :-
   S(["+", ["num", _, _, a, _],
           ["num", _, _, b, _], _, _], x).

// rewrite rule !(a < b) => a >= b
S([">=", a, b, 0, ""],x) :-
   S(["!", ["<", a, b, _, _], nil, _, _],x).

// compute size of each expression
.decl ExprSize(x:Expr, m:number)
ExprSize(nil, 0).
ExprSize([op, left, right, num, sym], d1 + d2 + 1) :-
   S([op, left, right, num, sym], _),
   ExprSize(left, d1),
   ExprSize(right, d2).

// find smallest expression for each input
// the solution might not be unique.
.decl B(e1:Expr, e2:Expr)
B(e1, e2) :-
   A(e1),
   min_d = min d: {S(e1, e2), ExprSize(e2, d)},
   S(e1,e2),
   ExprSize(e2, min_d).

.output B

// ==== END: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl gen(x : number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//factors excluding 1
.decl factor(num : number, fc : number)
factor(x, fc) :- gen(x), gen(fc), x % fc = 0, fc != 1.

//finds if there exist two numbers which multiply to x
.decl prod(num : number)
prod(x) :- gen(x), gen(a), gen(b), b != x, a != x, x = a*b.

//finds the prime factors
.decl p_factor(x : number, fc : number)
.output p_factor()
p_factor(x, fc) :- factor(x, fc), !prod(fc).

// ==== END: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\access-policy\access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:\work24\souffle-lsp-plugin\example\access-policy\access-policy.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

.type Node <: symbol
.decl flight      (node1:Node, node2:Node, node3:Node)
.decl QAflies   (node1:Node, node2:Node)
.output QAflies   ()
.decl VAflies   (node1:Node, node2:Node)
.output VAflies   ()
.decl QAonly   (node1:Node, node2:Node)
.output QAonly   ()

QAflies(X,Y) :- flight("QA",X,Y).
QAflies(X,Y) :- flight("QA",X,Z), QAflies(Z,Y).

VAflies(X,Y) :- flight("VA",X,Y).
VAflies(X,Y) :- flight("VA",X,Z), VAflies(Z,Y).

QAonly(X,Y)  :- QAflies(X,Y), ! VAflies(X,Y).

flight("QA","AU","CHI").
flight("QA","AU","JPN").
flight("QA","JPN","DEN").
flight("QA","JPN","CHI").
flight("QA","AU","CHI").
flight("VA","AU","CHI").
flight("VA","JPN","ZA").
flight("VA","JPN","DEN").
flight("VA","DEN","ZA").

// ==== END: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()
.decl satellite (x:D,y:D)
.output satellite ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

satellite(X,Y) :-
  orbits(X,Y),
  !intermediate(X,Y),
  !star(Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).



// ==== END: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Solves the n-queens problem

// Side length of the board.
.decl size( n : number )
.input size()


// The maximal compatible sets -- n queens.
.decl solution( qs : QueenList )
.printsize solution
solution(qs) :- compatible(qs, s), size(s).


// Natural numbers from 1 to the size of the board.
.decl up_to_size( x : number )
up_to_size(1).
up_to_size(x + 1) :- up_to_size(x), !size(x).


// A cartesian coordinate for a board square.
.type Position = [ x : number, y : number ]


// This relation holds the position of each square of the board.
.decl on_board( p : Position )
on_board([x, y]) :- up_to_size(x), up_to_size(y).


// Mutually-non-attacking list of queen positions.
.type QueenList = [ p : Position, qs : QueenList ]


// Arguments are not on the same diagonal.
.decl non_diagonals( p : Position, q : Position )
non_diagonals([px, py], [qx, qy]) :- px - qx != py - qy, qx - px != py - qy, on_board([px, py]), on_board([qx, qy]).


// Holds if p and q do not attack each other.
.decl sympathetic( p : Position, q : Position )
sympathetic(p, q) :- non_diagonals(p, q), px != qx, py != qy, p=[px, py], q=[qx,qy].


// Holds if the head of qs is mutually non-attacking with its tail, which should itself be compatible.
// Generated column by column, left to right.
.decl compatible( qs : QueenList, n : number )
compatible([p, nil], 1) :- on_board(p). //, p = [1,y].
compatible([p, [head, tail]], n+1) :- sympathetic(p, head), compatible([p, tail], n), compatible([head, tail], n), p = [px, py], head = [hx, hy], px > hx.

// ==== END: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Topological Ordering

// Gives a topological ordering over the vertices of an input graph. Note that is works only on input graph is acyclic.

// Graph

// Vertices
.decl vertices(v:symbol)
.input vertices()
.decl vertex(v:symbol)
.output vertex()
vertex(v) :- vertices(v).

// Edges
.decl edges(v1:symbol, v2:symbol)
.input edges()
.decl edge(v1:symbol, v2:symbol)
.output edge()
edge(v1, v2) :- vertex(v1), vertex(v2), edges(v1, v2).

// Tests if vertex v1 proceeds vertex v2 in the ordering.
.decl is_before(v1:symbol, v2:symbol)
.output is_before()

// Tests if vertex v1 succeeds vertex v2 in the ordering.
.decl is_after(v1:symbol, v2:symbol)
.output is_after()

// Gives the possible indices of the vertices in the ordering.
.decl indices(v:symbol, i:number)
.output indices()

// Gives the exact index of the vertex in the ordering.
.decl index(v:symbol, i:number)
.output index()

// Vertex x is before vertex y if the graph has an edge from x to y.
is_before(x, y) :-
    edge(x, y).

// Vertex x is before vertex y if some vertex z is before x and z is before y.
is_before(x, y) :-
    is_before(x, z),
    is_before(z, y).

// Vertex x is after vertex y if the graph has an edge from y to x.
is_after(x, y) :-
    edge(y, x).

// Vertex x is after vertex y if some vertex z is after x and y is after z.
is_after(x, y) :-
    is_after(z, x),
    is_after(y, z).

// The index of a vertex x is 0 if it has no inbound or outbound edges.
indices(x, 0) :-
    vertex(x),
    !edge(_, x),
    !edge(x, _).

// The index of a vertex x is 1 if it has no inbound but only outbound edges.
indices(x, 1) :-
    vertex(x),
    !edge(_, x),
    edge(x, _).

// The possible indices of a vertex x are 1 more than the index of some vertex y if that vertex y is before x but not after x.
indices(x, i+1) :-
    is_before(y, x),
    !is_before(x, y),
    is_after(x, y),
    indices(y, i).

// The exact index of a vertex is the maximum of its possible indices.
index(x, i) :-
    indices(x, i),
    !indices(x, i+1).

// ==== END: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\profile_json\profile_json.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt
//
// profile_json.dl
//
// Example for logging in json format.
//

// The '.json' extension here is recognised, and so logging will be
// produced in JSON format.
.pragma "profile" "profile_json.json"

.decl p(x:number, y:number)
.input p

.decl q(x:number, y:number)
.output q

q(x, y) :- p(x, y).
q(x, z) :- p(x, y), q(y, z).

// ==== END: d:\work24\souffle-lsp-plugin\example\profile_json\profile_json.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Node <: symbol
.type Card <: number

.decl Edge			(m:Node, n:Node)
.input Edge

Edge(m, n) :- Edge(n, m).

.decl Leaf			(n:Node)
.decl NotLeaf		(n:Node)

NotLeaf(n) :- Edge(a, n), Edge(b, n), a != b.
Leaf(n) :- Edge(_, n), !NotLeaf(n).

.decl InSubtree		(m:Node, n:Node, a:Node)

InSubtree(m, n, n) :- Edge(m, n).
InSubtree(m, n, a) :- Edge(m, n), Edge(n, p), InSubtree(n, p, a), m != p.

.decl TreeCard		(c:Card)
.decl SubtreeCard	(m:Node, n:Node, c:Card)

TreeCard(a + b) :- a = sum 1 : Leaf(_), b = sum 1 : NotLeaf(_).

SubtreeCard(m, n, c) :- Edge(m, n), c = sum 1 : InSubtree(m, n, _).

.decl Centroid		(n:Node)
.decl NotCentroid	(n:Node)

NotCentroid(n) :- TreeCard(c), SubtreeCard(n, _, d), d > c/2.
Centroid(n) :- Edge(n, _), !NotCentroid(n).

.output Centroid

// ==== END: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\array\array.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Array
// Simple array data structure.

// The default or NULL value for an element of the array.
.decl default(null:number)
.input default()

// The parameters to the array, including its length.
.decl parameters(length:number)
.input parameters()

// The values of the elements in the array, specified by index. Note that any unspecified elements will take the default value.
.decl values(index:number, value:number)
.input values()

// The indices of the array, used as a background set to ground the index parameter of elements.
.decl indices(index:number)
.output indices()
indices(0).
indices(i+1) :- indices(i), parameters(l), i >= 0, i+1 < l.

// The elements of the array, referenced by an index, and having a specified value. Note that if a value is not specified an element takes the default value.
.decl element(index:number, value:number)
.output element()
element(i, NULL) :- indices(i), !values(i, _), default(NULL).
element(i, x) :- indices(i), values(i, x).

// The value of the element to the left of the element specified by the index, or the default value if it is out of the array bounds.
.decl left(index:number, value:number)
left(i, NULL) :- !element(i-1, _), element(i, _), default(NULL).
left(i, x) :- element(i-1, x), element(i, _).

// The value of the element to the right of the element specified by the index, or the default value if it is out of bounds.
.decl right(index:number, value:number)
right(i, NULL) :- !element(i+1, _), element(i, _), default(NULL).
right(i, x) :- element(i+1, x), element(i, _).

// The local neighbourhood of a specified element, giving the value of that element, and the elements surrounding it.
.decl neighbourhood(index:number,
  left:number, current:number, right:number)
.output neighbourhood()
neighbourhood(i, l, c, r) :-
  left(i, l), element(i, c), right(i, r).

// ==== END: d:\work24\souffle-lsp-plugin\example\array\array.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find all disconnected node pairs
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find the connected nodes
.decl Connected(n:Node, m:Node)
Connected(n, n) :- Edge(n, _, _).
Connected(n, n) :- Edge(_, n, _).
Connected(n, m) :- Edge(n, m, _).
Connected(n, m) :- Edge(n, z, _), Connected(z, m).

// Find nodes without a connection
.decl DisConnected(n:Node, m:Node)
.output DisConnected()
DisConnected(n, m) :- Edge(n, _, _), Edge(_, m, _), !Connected(n, m).
DisConnected(n, m) :- Edge(n, _, _), Edge(m, _, _), !Connected(n, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2021, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// define edge relation of a directed graph
.decl e(x:number, y:number, c:number)

e(1,2,1).
e(2,2,1).
e(2,3,1).
e(3,4,1).
e(1,4,100).

// define shortest path relation
.decl sp(x:number, y:number, c:number) btree_delete

//
// subsumption
//
// A longer path is subsumed by a shorter path, i.e.,
// the longer path is discarded from the relation.
sp(x,y,c1) <= sp(x,y, c2) :-
  c2 <= c1.

//
// base case
//
sp(x,y,c) :-
  e(x,y,c).

//
// inductive case
//
sp(x,z,c1 + c2) :-
  sp(x,y,c1),
  e(y,z,c2).

.output sp

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(3,i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).
A(4,i) :- Check(a, b, _, d, _, _), In(a, b, _, d, _, _, i).
A(5,i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(6,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(7, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(8, i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(9, i) :- Check(_, b, _, _, _, _), In(_, b, _, _, _, _, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find all disconnected node pairs
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find the connected nodes
.decl Connected(n:Node, m:Node)
Connected(n, n) :- Edge(n, _, _).
Connected(n, n) :- Edge(_, n, _).
Connected(n, m) :- Edge(n, m, _).
Connected(n, m) :- Edge(n, z, _), Connected(z, m).

// Find nodes without a connection
.decl DisConnected(n:Node, m:Node)
.output DisConnected()
DisConnected(n, m) :- Edge(n, _, _), Edge(_, m, _), !Connected(n, m).
DisConnected(n, m) :- Edge(n, _, _), Edge(m, _, _), !Connected(n, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\grid.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Grid
// Simple grid data structure.

// The default or NULL value for an element of the array.
.decl default(null:number)
.input default()

// The parameters to the grid, including its number of rows and columns.
.decl parameters(rows:number, columns:number)
.input parameters()

// The values of the elements in the grid, specified by row and column index. Note that any unspecified elements will take the default value.
.decl values(row:number, column:number, value:number)
.input values()

// The row and column indices of the grid, used as a background set to ground the row and column parameter of elements.
.decl indices(row:number, column:number)
.output indices()
indices(0, 0).
indices(i+1, j) :- indices(i, j), parameters(I, J), i >= 0, i+1 < I, j >= 0, j < J.
indices(i, j+1) :- indices(i, j), parameters(I, J), i >= 0, i < I, j >= 0, j+1 < J.

// The elements of the grid, referenced by a row and column index, and having a specified value. Note that if a value is not specified an element takes the default value.
.decl element(row:number, column:number, value:number)
.output element()
element(i, j, 0) :- indices(i, j), !values(i, j, _).
element(i, j, x) :- indices(i, j), values(i, j, x).

// The value of the element above the element specified by the index, or the default value if it is out of the grid bounds.
.decl up(row:number, column:number, value:number)
up(i, j, NULL) :- element(i, j, _), !element(i-1, j, _), default(NULL).
up(i, j, x) :- element(i, j, _), element(i-1, j, x).

// The value of the element below the element specified by the index, or the default value if it is out of the grid bounds.
.decl down(row:number, column:number, value:number)
down(i, j, NULL) :- element(i, j, _), !element(i+1, j, _), default(NULL).
down(i, j, x) :- element(i, j, _), element(i+1, j, x).

// The value of the element to the left of the element specified by the index, or the default value if it is out of the grid bounds.
.decl left(row:number, column:number, value:number)
left(i, j, NULL) :- element(i, j, _), !element(i, j-1, _), default(NULL).
left(i, j, x) :- element(i, j, _), element(i, j-1, x).

// The value of the element to the right of the element specified by the index, or the default value if it is out of the grid bounds.
.decl right(row:number, column:number, value:number)
right(i, j, NULL) :- element(i, j, _), !element(i, j+1, _), default(NULL).
right(i, j, x) :- element(i, j, _), element(i, j+1, x).

// The value of the element diagonally above and left of the element specified by the index, or the default value if it is out of the grid bounds.
.decl up_left(row:number, column:number, value:number)
up_left(i, j, NULL) :- element(i, j, _), !element(i-1, j-1, _), default(NULL).
up_left(i, j, x) :- element(i, j, _), element(i-1, j-1, x).

// The value of the element diagonally above and right of the element specified by the index, or the default value if it is out of the grid bounds.
.decl up_right(row:number, column:number, value:number)
up_right(i, j, NULL) :- element(i, j, _), !element(i-1, j+1, _), default(NULL).
up_right(i, j, x) :- element(i, j, _), element(i-1, j+1, x).

// The value of the element diagonally below and left of the element specified by the index, or the default value if it is out of the grid bounds.
.decl down_left(row:number, column:number, value:number)
down_left(i, j, NULL) :- element(i, j, _), !element(i+1, j-1, _), default(NULL).
down_left(i, j, x) :- element(i, j, _), element(i+1, j-1, x).

// The value of the element diagonally below and right of the element specified by the index, or the default value if it is out of the grid bounds.
.decl down_right(row:number, column:number, value:number)
down_right(i, j, NULL) :- element(i, j, _), !element(i+1, j+1, _), default(NULL).
down_right(i, j, x) :- element(i, j, _), element(i+1, j+1, x).

// The local neighbourhood of a specified element, giving the value of that element, and the elements surrounding it.
.decl neighbourhood(row:number, column:number,
  up_left:number, up:number, up_right:number,
  left:number, current:number, right:number,
  down_left:number, down:number, down_right:number)
.output neighbourhood()
neighbourhood(i, j, ul, u, ur, l, x, r, dl, d, dr) :-
 up_left(i, j, ul), up(i, j, u), up_right(i, j, ur),
 left(i, j, l), element(i, j, x), right(i, j, r),
 down_left(i, j, dl), down(i, j, d), down_right(i, j, dr).

// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\grid.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\lubm\lubm.dl ====
// The Lehigh University Benchmark (LUBM)
// http://swat.cse.lehigh.edu/projects/lubm/
// ported by Anthony Potter
//
// Unary relations
.decl University (a:symbol)
.output University ()
.input University ()
.decl Person (a:symbol)
.output Person ()
.decl Employee (a:symbol)
.output Employee ()
.decl Faculty (a:symbol)
.output Faculty ()
.decl Professor (a:symbol)
.output Professor ()
.decl Course (a:symbol)
.output Course ()
.input Course ()
.decl AssociateProfessor (a:symbol)
.input AssociateProfessor ()
.decl AssistantProfessor (a:symbol)
.input AssistantProfessor ()
.decl Organization (a:symbol)
.output Organization ()
.decl Chair (a:symbol)
.output Chair ()
.decl Work (a:symbol)
.output Work ()
.decl Lecturer (a:symbol)
.output Lecturer ()
.input Lecturer ()
.decl Student (a:symbol)
.output Student ()
.decl GraduateStudent (a:symbol)
.input GraduateStudent ()
.decl ResearchAssistant (a:symbol)
.input ResearchAssistant ()
.decl GraduateCourse (a:symbol)
.input GraduateCourse ()
.decl UndergraduateStudent (a:symbol)
.input UndergraduateStudent ()
.decl ResearchGroup (a:symbol)
.output ResearchGroup ()
.input ResearchGroup ()
.decl Publication (a:symbol)
.output Publication ()
.input Publication ()
.decl TeachingAssistant (a:symbol)
.output TeachingAssistant ()
.input TeachingAssistant ()
.decl FullProfessor (a:symbol)
.input FullProfessor ()
.decl Department (a:symbol)
.input Department ()

// Binary relations
.decl hasAlumnus (a:symbol, b:symbol)
.output hasAlumnus ()
.decl degreeFrom (a:symbol, b:symbol)
.output degreeFrom ()
.decl member (a:symbol, b:symbol)
.output member ()
.decl teachingAssistantOf (a:symbol, b:symbol)
.input teachingAssistantOf ()
.decl headOf (a:symbol, b:symbol)
.input headOf ()
.decl teacherOf (a:symbol, b:symbol)
.input teacherOf ()
.decl publicationAuthor (a:symbol, b:symbol)
.input publicationAuthor ()
.decl doctoralDegreeFrom (a:symbol, b:symbol)
.input doctoralDegreeFrom ()
.decl undergraduateDegreeFrom (a:symbol, b:symbol)
.input undergraduateDegreeFrom ()
.decl mastersDegreeFrom (a:symbol, b:symbol)
.input mastersDegreeFrom ()
.decl subOrganizationOf (a:symbol, b:symbol)
.output subOrganizationOf ()
.input subOrganizationOf ()
.decl takesCourse (a:symbol, b:symbol)
.input takesCourse ()
.decl worksFor (a:symbol, b:symbol)
.output worksFor ()
.input worksFor ()
.decl memberOf (a:symbol, b:symbol)
.output memberOf ()
.input memberOf ()
.decl advisor (a:symbol, b:symbol)
.input advisor ()
.decl emailAddress (a:symbol, b:symbol)
.input emailAddress ()
.decl telephone (a:symbol, b:symbol)
.input telephone ()
.decl name (a:symbol, b:symbol)
.input name ()
.decl researchInterest (a:symbol, b:symbol)
.input researchInterest ()

// Ontology
University(Y) :- mastersDegreeFrom(_,Y) .
degreeFrom(X,Y) :- hasAlumnus(Y,X) .
hasAlumnus(X,Y) :- degreeFrom(Y,X) .
Employee(X) :- Faculty(X) .
Faculty(X) :- Professor(X) .
Professor(X) :- AssociateProfessor(X) .
Person(Y) :- member(_,Y) .
Professor(X) :- AssistantProfessor(X) .
Professor(X) :- Chair(X) .
worksFor(X,Y) :- headOf(X,Y) .
Person(X) :- degreeFrom(X,_) .
University(Y) :- degreeFrom(_,Y) .
Person(Y) :- hasAlumnus(_,Y) .
TeachingAssistant(X) :- Person(X), teachingAssistantOf(X,Y), Course(Y) .
Chair(X) :- Person(X), headOf(X,Y), Department(Y) .
memberOf(X,Y) :- member(Y,X) .
member(X,Y) :- memberOf(Y,X) .
Course(Y) :- teacherOf(_,Y) .
University(X) :- hasAlumnus(X,_) .
Person(X) :- telephone(X,_) .
Organization(Y) :- subOrganizationOf(_,Y) .
memberOf(X,Y) :- worksFor(X,Y) .
Person(X) :- Employee(X) .
Person(X) :- advisor(X,_) .
Organization(X) :- member(X,_) .
Organization(X) :- Department(X) .
Faculty(X) :- Lecturer(X) .
Person(Y) :- publicationAuthor(_,Y) .
Professor(Y) :- advisor(_,Y) .
Work(X) :- Course(X) .
Professor(X) :- FullProfessor(X) .
degreeFrom(X,Y) :- doctoralDegreeFrom(X,Y) .
TeachingAssistant(X) :- teachingAssistantOf(X,_) .
Person(X) :- undergraduateDegreeFrom(X,_) .
Organization(X) :- University(X) .
Person(X) :- doctoralDegreeFrom(X,_) .
University(Y) :- doctoralDegreeFrom(_,Y) .
Course(Y) :- teachingAssistantOf(_,Y) .
University(Y) :- undergraduateDegreeFrom(_,Y) .
degreeFrom(X,Y) :- mastersDegreeFrom(X,Y) .
Person(X) :- GraduateStudent(X) .
Person(X) :- ResearchAssistant(X) .
Student(X) :- UndergraduateStudent(X) .
degreeFrom(X,Y) :- undergraduateDegreeFrom(X,Y) .
Publication(X) :- publicationAuthor(X,_) .
Person(X) :- mastersDegreeFrom(X,_) .
Organization(X) :- ResearchGroup(X) .
Faculty(X) :- teacherOf(X,_) .
Person(X) :- Chair(X) .
Employee(X) :- Person(X), worksFor(X,Y), Organization(Y) .
Course(X) :- GraduateCourse(X) .
Student(X) :- Person(X), takesCourse(X,Y), Course(Y) .
Person(X) :- TeachingAssistant(X) .
Organization(X) :- subOrganizationOf(X,_) .
Person(X) :- Student(X) .
Person(X) :- emailAddress(X,_) .
subOrganizationOf(X,Z) :- subOrganizationOf(X,Y), subOrganizationOf(Y,Z) .

