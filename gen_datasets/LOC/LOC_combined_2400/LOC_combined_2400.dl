// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shortest paths between all nodes, the slow way
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find all paths
.decl Length   (n:Node, m:Node, l:number)
Length(x,y,t)  :- t=l, Edge(x,y,l).
Length(x,y,t+l)  :- Edge(x,z,l), Length(z,y,t).

// Filter out the longest path
.decl ShortestPath(n:Node, m:Node, l:number)
.output ShortestPath()
ShortestPath(x, y, a) :- Length(x, y, _), a = min Z : Length(x, y, Z).

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_path\shortest_path.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\inline_nats\inline_nats.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Inlining is very effective here, as it avoids needing to compute the
// 10000^2 tuples for nat_pair.

.decl nat(x:number)
nat(0).
nat(x+1) :- x < 10000, nat(x).

.decl nat_pair(x:number, y:number) inline
nat_pair(x, y) :- nat(x), nat(y).

.decl query(x:number)
query(x) :- nat_pair(x, x), x < 2.

.output query()



// ==== END: d:\work24\souffle-lsp-plugin\example\inline_nats\inline_nats.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shorted outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
.output OutDegree()

OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
.output InDegree()

InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

// ==== END: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tree\tree.dl ====

.type Node <: symbol

.decl S      (node1:Node, node2:Node)
.output S      ()
.decl T      (node1:Node, node2:Node)
.output T      ()
.decl R      (node1:Node, node2:Node, node3:Node)

S (x1, x3) :- T(x1, x2), R(x2, _, x3).
T (x1, x4) :- R(x1, _, x2), R(x2, _, x3), T(x3, x4).
T (x1, x3) :- R(x1, a, x2), R(x2, a, x3).


R("1", "a", "2").
R("2", "b", "3").
R("3", "a", "4").
R("4", "a", "5").
R("5", "a", "6").

// ==== END: d:\work24\souffle-lsp-plugin\example\tree\tree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

.type node = number

// defines the interface and some basic properties
.comp Closure {
    .decl edge(a:node,b:node)
    .decl link(a:node,b:node)
.output link()

    link(X,Y) :- edge(X,Y).
}

// strategy A
.comp LeftRecursive : Closure {
    link(X,Z) :- link(X,Y), edge(Y,Z).
}

// strategy B
.comp RightRecursive : Closure {
    link(X,Z) :- edge(X,Y), link(Y,Z).
}

// strategy C
.comp QuadraticRecursive : Closure {
    link(X,Z) :- link(X,Y), link(Y,Z).
}


// get input data
.decl less(a:node,b:node)
less(1,2).
less(2,3).
less(3,4).
less(4,5).
less(5,6).


// init strategies
.init A = LeftRecursive
.init B = RightRecursive
.init C = QuadraticRecursive

// wire in input data
A.edge(X,Y) :- less(X,Y).
B.edge(X,Y) :- less(X,Y).
C.edge(X,Y) :- less(X,Y).




// ==== END: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath2\minpath2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Path(source:symbol,destination:symbol,path:number)

Path(a,c,w) :-
  Edge(a,c,w).

Path(a,c,w1+w2) :-
  Path(a,b,w1),
  Edge(b,c,w2),
  h = sum w :Edge(_,_,w),
  (w1+w2) < h.

.decl ConnectedNodes(source:symbol,destination:symbol)

ConnectedNodes(a,b) :-
  Path(a,b,_).

.decl ShortestPath(source:symbol,destination:symbol,weight:number)

ShortestPath(a,b,w1) :-
  ConnectedNodes(a,b),
  w1 = min w2 : Path(a,b,w2).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath2\minpath2.dl ====

