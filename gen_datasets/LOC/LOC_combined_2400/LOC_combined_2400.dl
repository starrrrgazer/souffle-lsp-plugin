// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:/work24/souffle-lsp-plugin/example/catalan/catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tak\tak.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// The Takeuchi benchmark function.
// Each tak(n, 0, n+1) requires T(n) recursive calls, which sequence this program generates.


/* X, Y, Z : Parameters of the tak function;
 * V       : The value of tak(X, Y, Z);
 * Q       : The number of branches used in evaluating V */
.decl tak(X:number, Y:number, Z:number, V:number, Q:number)

tak(X,Y,Z,Y,0) :- Y >= X, natural(X), natural(Y), natural(Z).
tak(X,Y,Z,V,Q1+Q2+Q3+Q4+1) :- tak(X-1,Y,Z,V1,Q1), tak(Y-1,Z,X,V2,Q2), tak(Z-1,X,Y,V3,Q3),
                              tak(V1,V2,V3,V,Q4), Y < X.


/* Restrict the range in which tak is evaluated. */
.decl natural(N:number)

natural(-8).
natural(n+1) :- natural(n), n < 8.


/* N : index
 * Q : the value of the N'th Takeuchi number. */
.decl query(N: number, Q:number)
.output query()

query(N, Q) :- tak(N, 0, N+1, _, Q), N >= 0, N < 10.



// ==== END: d:\work24\souffle-lsp-plugin\example\tak\tak.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Type Node
.type Node <: symbol

//
// Edges non circular
//

.decl Edge        (n:Node, m:Node, w:number)

Edge("0","1",3).
Edge("1","2",5).
Edge("2","3",1).
Edge("1","4",-6).
Edge("4","2",-1).

//
// Reachable
//

.decl Reachable   (n:Node, m:Node, i:number)
.output Reachable   ()

Reachable(x,y,r)  :- r=w, Edge(x,y,w).
Reachable(x,y,d+w)  :- Edge(x,z,w), Reachable(z,y,d).


.decl ShortestDuplicates(n:Node, m:Node, i:number)
.output ShortestDuplicates()

ShortestDuplicates(x,y,a) :- Reachable(x,y,a), Reachable(x,y,b), a<b.

// ==== END: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Topological Ordering

// Gives a topological ordering over the vertices of an input graph. Note that is works only on input graph is acyclic.

// Graph

// Vertices
.decl vertices(v:symbol)
.input vertices()
.decl vertex(v:symbol)
.output vertex()
vertex(v) :- vertices(v).

// Edges
.decl edges(v1:symbol, v2:symbol)
.input edges()
.decl edge(v1:symbol, v2:symbol)
.output edge()
edge(v1, v2) :- vertex(v1), vertex(v2), edges(v1, v2).

// Tests if vertex v1 proceeds vertex v2 in the ordering.
.decl is_before(v1:symbol, v2:symbol)
.output is_before()

// Tests if vertex v1 succeeds vertex v2 in the ordering.
.decl is_after(v1:symbol, v2:symbol)
.output is_after()

// Gives the possible indices of the vertices in the ordering.
.decl indices(v:symbol, i:number)
.output indices()

// Gives the exact index of the vertex in the ordering.
.decl index(v:symbol, i:number)
.output index()

// Vertex x is before vertex y if the graph has an edge from x to y.
is_before(x, y) :-
    edge(x, y).

// Vertex x is before vertex y if some vertex z is before x and z is before y.
is_before(x, y) :-
    is_before(x, z),
    is_before(z, y).

// Vertex x is after vertex y if the graph has an edge from y to x.
is_after(x, y) :-
    edge(y, x).

// Vertex x is after vertex y if some vertex z is after x and y is after z.
is_after(x, y) :-
    is_after(z, x),
    is_after(y, z).

// The index of a vertex x is 0 if it has no inbound or outbound edges.
indices(x, 0) :-
    vertex(x),
    !edge(_, x),
    !edge(x, _).

// The index of a vertex x is 1 if it has no inbound but only outbound edges.
indices(x, 1) :-
    vertex(x),
    !edge(_, x),
    edge(x, _).

// The possible indices of a vertex x are 1 more than the index of some vertex y if that vertex y is before x but not after x.
indices(x, i+1) :-
    is_before(y, x),
    !is_before(x, y),
    is_after(x, y),
    indices(y, i).

// The exact index of a vertex is the maximum of its possible indices.
index(x, i) :-
    indices(x, i),
    !indices(x, i+1).

// ==== END: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/magic_access-policy/magic_access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

// A copy of the `access-policy' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:/work24/souffle-lsp-plugin/example/magic_access-policy/magic_access-policy.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/2sat/2sat.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Var <: symbol
.type Neg <: symbol
.type Val <: symbol
.type Card <: number
.type Ans <: symbol

.decl Clause		(m:Neg, u:Var, n:Neg, v:Var)
.input Clause

.decl Not			(m:Neg, n:Neg)

Not("Pos", "Neg").
Not("Neg", "Pos").

.decl Impl			(m:Neg, u:Var, n:Neg, v:Var)

// Translate clauses into implications, (x V y) becomes (not x => y) and (not y => x)
Impl(m, u, n, v) :- Not(m, p), Clause(p, u, n, v).
Impl(m, u, n, v) :- Not(m, p), Clause(n, v, p, u).

// Closure under transitivity of implication
Impl(m, u, n, v) :- Impl(m, u, p, w), Impl(p, w, n, v).

.decl Incon			(u:Var)

// Any inconsistencies?
Incon(u) :- Impl("Pos", u, "Neg", u), Impl("Neg", u, "Pos", u).

.decl Satisfiable	(s:Ans)

Satisfiable("Yes") :- !Incon(_).
Satisfiable("No") :- Incon(_).

.output Satisfiable

// ==== END: d:/work24/souffle-lsp-plugin/example/2sat/2sat.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath3\minpath3.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2019, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Shortest Path Computation
//

.type Node <: symbol
.type Distance <: number

//
// start node
//
.decl start(u:Node)
.input start

//
//  edge relation of directed graph
//

.decl edge(u:Node, v:Node, dist:Distance)
.input edge

//
// node relation
//

.decl node(u:Node)

node(u) :-
   edge(u, _, _);
   edge(_, u, _).

//
// order predecessor nodes by ordinal Distance
//

.decl lessPred(u1:Node, u2:Node, v:Node)

lessPred(u1, u2, v) :-
   edge(u1, v, _),
   edge(u2, v, _),
   ord(u1) < ord(u2).

//
// compute strict transitive predecessor nodes
//

.decl transPred(u1:Node, u2:Node, v:Node)

transPred(u1, u3, v) :-
   lessPred(u1, u2, v),
   lessPred(u2, u3, v).

//
// successor relation among predecessor node
//

.decl succPred(before:Node, after:Node, v:Node)
succPred(u1, u2, v) :-
   lessPred(u1, u2, v),
   !transPred(u1, u2, v).

//
// determine first predecessor of a node
//

.decl firstPred(u:Node, v:Node)

firstPred(u, v) :-
   edge(u, v, _),
   !succPred(_, u, v).

//
// determine last predecessor of a node
//

.decl lastPred(u:Node, v:Node)

lastPred(u, v) :-
   edge(u, v, _),
   !succPred(u, _, v).

//
// step function that computes stepwise the shortest distance
// of a node.
//

.decl step(i:number, u:Node, w:Distance, next:Node)

/* compute shortest distance for first predecessor node
 * NB: this step is performed assuming that the computation
 * hasn't finished yet.
 */
step(i+1, v, d1 + d2, u) :-
   again(i),
   shortestStepPath(i, u, d2),
   firstPred(u, v),
   edge(u, v, d1).

/* compute shortest distance for subsequent predecessor nodes;
 * one of the previous predecessors was smaller than shortest path from
 * current predecessor.
 */

step(i, v, d, u2) :-
   step(i, v, d, u1),
   succPred(u1, u2, v),
   edge(u2, v, d1),
   shortestStepPath(i-1, u2, d2),
   d <= d1 + d2.

/* compute shortest distance for subsequent predecessor nodes;
 * all previous predecessors' shortest paths are longer than the
 * shortest path of current predecessors.
 */

step(i, v, d1 + d2, u2) :-
   step(i, v, d, u1),
   succPred(u1, u2, v),
   edge(u2, v, d1),
   shortestStepPath(i-1, u2, d2),
   d1 + d2 < d.

//
// compute shortest distance of a node in the i-th step
//

.decl shortestStepPath(i:number, u:Node, d:Distance)

/* initial shortest distance for start node for first step */
shortestStepPath(i, u, 0) :-
   again(i),
   start(u).

/* initial shortest distance for all other nodes for subsequent steps */
shortestStepPath(0, u, largeDist) :-
   node(u),
   !start(u),
   largeDist = sum d: {edge(_,_,d)}.

/* shortest distance for all other steps */
shortestStepPath(i, v, d) :-
   step(i, v, d, u),
   lastPred(u, v).

//
// Predicate which determines whether another step is required.
//

.decl again(i:Distance)

/* at least two iterations are required */
again(0).
again(1).

/* if we find at least one node whose result has changed in the
 * previous step, a new step is required.
 */

again(i+1) :-
   shortestStepPath(i, u, wi),
   shortestStepPath(i-1, u, wi_1),
   i > 0,
   wi < wi_1.

//
// last step
//

.decl lastStep(i:number)

lastStep(i) :-
   again(i),
   !again(i+1).

//
// shortest path
//

.decl shortestPath(u:Node, dist:Distance)

shortestPath(u, d) :-
   lastStep(i),
   shortestStepPath(i, u, d).

.output shortestPath


// ==== END: d:\work24\souffle-lsp-plugin\example\minpath3\minpath3.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(5,i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(6,i) :- Check(a, b, c, d, e, _), In(a, b, c, d, e, _, i).

A(7, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(9, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(10, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(11, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).

A(12, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(13, i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(14, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(15, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).

A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(18, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).

A(19, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




