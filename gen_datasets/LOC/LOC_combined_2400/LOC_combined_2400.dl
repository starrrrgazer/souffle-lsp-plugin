// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====
//
// An example computing all palendroms of a given length.
//

.type Letter <: symbol

.decl str(id:number, a:number, l:Letter, b:number)
.decl len(id:number, l:number)


//////////////////////////////////////////////////////////////////
//          index range          //
//////////////////////////////////////////////////////////////////

.decl p(x:number)

p(0).
p(x) :- str(_,_,_,x).




//////////////////////////////////////////////////////////////////
//          palindromes          //
//////////////////////////////////////////////////////////////////


.decl palin_aux(s:number, a:number, b:number)
palin_aux(s,x,x) :- str(s,_,_,_), p(x).
palin_aux(s,x,y) :- str(s,x,_,y).
palin_aux(s,x,y) :- str(s,x,a,t), palin_aux(s,t,r), str(s,r,a,y).

.decl palindrome(s:number)
.output palindrome()
palindrome(s) :- palin_aux(s,0,l), len(s,l).



//////////////////////////////////////////////////////////////////
//       words to be tested      //
//////////////////////////////////////////////////////////////////

// hello
str(0,0,"h",1).
str(0,1,"e",2).
str(0,2,"l",3).
str(0,3,"l",4).
str(0,4,"o",5).
len(0,5).


// racecar
str(1,0,"r",1).
str(1,1,"a",2).
str(1,2,"c",3).
str(1,3,"e",4).
str(1,4,"c",5).
str(1,5,"a",6).
str(1,6,"r",7).
len(1,7).


// noon
str(2,0,"n",1).
str(2,1,"o",2).
str(2,2,"o",3).
str(2,3,"n",4).
len(2,4).

// never odd or even
str(3,0,"n",1).
str(3,1,"e",2).
str(3,2,"v",3).
str(3,3,"e",4).
str(3,4,"r",5).
str(3,5,"o",6).
str(3,6,"d",7).
str(3,7,"d",8).
str(3,8,"o",9).
str(3,9,"r",10).
str(3,10,"e",11).
str(3,11,"v",12).
str(3,12,"e",13).
str(3,13,"n",14).
len(3,14).



// ==== END: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Relation(a:symbol, b:symbol, step:number,turn:symbol)
Relation(a, c, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
    			a!=c.

Relation(d, e, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
			Relation(d, e, step, a),
    			a!=c,
			d!=a,
			d!=b.



.output Relation

Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","d",0,"a").
Relation("d","e",0,"a").
Relation("e","f",0,"a").
Relation("f","a",0,"a").


/*
 // Small test case:
Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","a",0,"a").
*/

.decl Josephus(a:symbol)
Josephus(a) :-
			Relation(a, b, step, a),
			Relation(b, a, step, a).
.output Josephus

// ==== END: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\hmmer\hmmer.dl ====
//
// Preliminary Version of a points-to analysis for C
//

.type Var <: symbol
.type Obj <: symbol

.decl DirectFlow(v:Var,w:Var)
.input DirectFlow()
.decl Load(v:Var,w:Var)
.input Load()
.decl Store(v:Var,w:Var)
.input Store()
.decl ExtReturn(v:Var,w:Var)
.input ExtReturn()
.decl EscapePtr(v:Var)
.input EscapePtr()
.decl HeapAlloc(v:Var,o:Obj)
.input HeapAlloc()
.decl StackAlloc(v:Var,o:Obj)
.input StackAlloc()
.decl Function(v:Var,o:Obj)
.input Function()
.decl Global(v:Var,o:Obj)
.input Global()

.decl LptrVar (v:Var)
.decl IsPtr (v:Var,o:Obj)
.decl Memory(o1:Obj,o2:Obj)
.decl IsReachable(v:Var,o:Obj)
.decl CFormat(o:Obj)
.decl CPtrLoad(v1:Var,v2:Var)
.output CPtrLoad()
.decl CPtrStore(v1:Var,v2:Var)
.output CPtrStore()

LptrVar(v) :- StackAlloc(v,_).
LptrVar(v) :- HeapAlloc(v,_).
LptrVar(v) :- Load(_,v).
LptrVar(v) :- Store(_,v).
LptrVar(v) :- DirectFlow(v,w), LptrVar(w).
LptrVar(v) :- DirectFlow(w,v), LptrVar(w).


IsPtr(v,o) :- HeapAlloc(v,o).
IsPtr(v,o) :- StackAlloc(v,o).
IsPtr(dest,o) :- DirectFlow(src,dest), IsPtr(src,o).
IsPtr(dest,o) :- Load(dest, addr), IsPtr(addr, o1), Memory(o1,o).
IsPtr(v,o) :- ExtReturn(arg,v), IsReachable(arg,o).

IsPtr(v,o) :- Global(v, o).

Memory(o1,o2) :- Store(src,addr), IsPtr(src,o2), IsPtr(addr, o1).

IsReachable(v,o) :- IsPtr(v,o).
IsReachable(v,o) :- Memory(o1,o), IsReachable(v,o1).

CFormat(o) :- EscapePtr(v), IsReachable(v,o).


IsPtr(v,"ttt_obj") :- ExtReturn(_,v).

CFormat("ttt_obj") :- ExtReturn(_,_).
Memory("ttt_obj", "ttt_obj") :- ExtReturn(_,_).


CPtrLoad(dest, addr) :- Load(dest, addr), IsPtr(addr, o), CFormat(o), LptrVar(dest).
CPtrStore(src, addr) :- Store(src, addr), IsPtr(addr, o), CFormat(o), LptrVar(src).

CFormat(o) :- CPtrLoad(_,v), IsPtr(v,o).
CFormat(o) :- CPtrStore(_,v), IsPtr(v,o).

CFormat(o) :- Load(v,addr), IsPtr(addr,o), !LptrVar(v).
CFormat(o) :- Store(v,addr), IsPtr(addr,o), !LptrVar(v).



// ==== END: d:\work24\souffle-lsp-plugin\example\hmmer\hmmer.dl ====

