// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Topological Ordering

// Gives a topological ordering over the vertices of an input graph. Note that is works only on input graph is acyclic.

// Graph

// Vertices
.decl vertices(v:symbol)
.input vertices()
.decl vertex(v:symbol)
.output vertex()
vertex(v) :- vertices(v).

// Edges
.decl edges(v1:symbol, v2:symbol)
.input edges()
.decl edge(v1:symbol, v2:symbol)
.output edge()
edge(v1, v2) :- vertex(v1), vertex(v2), edges(v1, v2).

// Tests if vertex v1 proceeds vertex v2 in the ordering.
.decl is_before(v1:symbol, v2:symbol)
.output is_before()

// Tests if vertex v1 succeeds vertex v2 in the ordering.
.decl is_after(v1:symbol, v2:symbol)
.output is_after()

// Gives the possible indices of the vertices in the ordering.
.decl indices(v:symbol, i:number)
.output indices()

// Gives the exact index of the vertex in the ordering.
.decl index(v:symbol, i:number)
.output index()

// Vertex x is before vertex y if the graph has an edge from x to y.
is_before(x, y) :-
    edge(x, y).

// Vertex x is before vertex y if some vertex z is before x and z is before y.
is_before(x, y) :-
    is_before(x, z),
    is_before(z, y).

// Vertex x is after vertex y if the graph has an edge from y to x.
is_after(x, y) :-
    edge(y, x).

// Vertex x is after vertex y if some vertex z is after x and y is after z.
is_after(x, y) :-
    is_after(z, x),
    is_after(y, z).

// The index of a vertex x is 0 if it has no inbound or outbound edges.
indices(x, 0) :-
    vertex(x),
    !edge(_, x),
    !edge(x, _).

// The index of a vertex x is 1 if it has no inbound but only outbound edges.
indices(x, 1) :-
    vertex(x),
    !edge(_, x),
    edge(x, _).

// The possible indices of a vertex x are 1 more than the index of some vertex y if that vertex y is before x but not after x.
indices(x, i+1) :-
    is_before(y, x),
    !is_before(x, y),
    is_after(x, y),
    indices(y, i).

// The exact index of a vertex is the maximum of its possible indices.
index(x, i) :-
    indices(x, i),
    !indices(x, i+1).

// ==== END: d:\work24\souffle-lsp-plugin\example\topological_ordering\topological_ordering.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the highest in and out degree nodes in the graph
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

.decl HighestOutDegree(d:number)
.output HighestOutDegree()
HighestOutDegree(d) :- OutDegree(_, _), d = max D : OutDegree(_, D).

.decl HighestInDegree(d:number)
.output HighestInDegree()
HighestInDegree(d) :- InDegree(_, _), d = max D : InDegree(_, D).


// ==== END: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Limit(weight:number)
Limit(h) :- h = sum w : Edge(_,_,w).

.decl Path(source:symbol,destination:symbol,path:number)
Path(a,c,w) :- Edge(a,c,w).
Path(a,c,w1+w2) :-
  Limit(h),
  Edge(a,b,w1),
  Path(b,c,w2),
    w2 < h-w1.

.decl FindingShorterPath(source:symbol,destination:symbol,weight:number)
FindingShorterPath(a,b,w1) :-
  Path(a,b,w1),
  Path(a,b,w2),
  w2<w1.

.decl ShortestPath(source:symbol,destination:symbol,weight:number)
ShortestPath(a,b,w) :-
  Path(a,b,w),
  !FindingShorterPath(a,b,w).

.output ShortestPath




