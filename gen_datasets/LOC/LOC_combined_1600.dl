.decl edge   (node1:Node, node2:Node)
.output edge   ()

edge("a","b").
edge("a","c").
edge("b","a").
edge("b","d").

path(X,Y) :- path(X,Z), edge(Z,Y).
path(X,Y) :- edge(X,Y).


