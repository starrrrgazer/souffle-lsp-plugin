// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

.type node = number

// defines the interface and some basic properties
.comp Closure {
    .decl edge(a:node,b:node)
    .decl link(a:node,b:node)
.output link()

    link(X,Y) :- edge(X,Y).
}

// strategy A
.comp LeftRecursive : Closure {
    link(X,Z) :- link(X,Y), edge(Y,Z).
}

// strategy B
.comp RightRecursive : Closure {
    link(X,Z) :- edge(X,Y), link(Y,Z).
}

// strategy C
.comp QuadraticRecursive : Closure {
    link(X,Z) :- link(X,Y), link(Y,Z).
}


// get input data
.decl less(a:node,b:node)
less(1,2).
less(2,3).
less(3,4).
less(4,5).
less(5,6).


// init strategies
.init A = LeftRecursive
.init B = RightRecursive
.init C = QuadraticRecursive

// wire in input data
A.edge(X,Y) :- less(X,Y).
B.edge(X,Y) :- less(X,Y).
C.edge(X,Y) :- less(X,Y).




// ==== END: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====
// Stratifiable two-people game
// Equivalent to the nonstratifiable:
// winning(X) :- move(X,Y), not(winning(X)).
// April, 2011
// Adopted from DES

.type Node <: symbol

.decl move (node1:Node, node2:Node)
.output move ()
.decl odd_move (node1:Node, node2:Node)
.output odd_move ()
.decl canMove (node1:Node)
.output canMove ()
.decl possible_winning (node1:Node)
.output possible_winning ()
.decl winning (node1:Node)
.output winning ()

move("1","2").
move("2","3").
move("3","4").
move("1","3").
move("1","5").

canMove(X):- move(X,_).

possible_winning(X):- odd_move(X,Y), !canMove(Y).

winning(X):- move(X,Y), !possible_winning(Y).

odd_move(X,Y) :- move(X,Y).

odd_move(X,Y) :- move(X,Z1), move(Z1,Z2), odd_move(Z2,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====

