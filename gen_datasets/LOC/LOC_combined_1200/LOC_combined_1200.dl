//// Test Case adopted from Ocaml datalog

.decl reachable  (node1:number, node2:number)
.output reachable  ()
.decl increasing (node1:number, node2:number)
.output increasing ()
.decl edge       (node1:number, node2:number)

reachable(X,Y)  :- edge(X,Y).
reachable(X,Y)  :- edge(X,Z), reachable(Z,Y).
increasing(X,Y) :- edge(X,Y), X < Y.
increasing(X,Y) :- edge(X,Z), X < Z, increasing(Z,Y).

edge(0, 1).
edge(1, 2).
edge(2, 3).
edge(3, 4).
edge(4, 5).
edge(5, 6).
edge(6, 7).
edge(7, 8).
edge(8, 9).
edge(9, 10).
edge(10, 0).

// ==== END: d:\work24\souffle-lsp-plugin\example\graph\graph.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\func\func.dl ====
.type String <: symbol

.decl f(v:String, f:String)
.decl succ (v:String, f:String)
.decl arg (v:String, i:String, a:String)
.decl args (a:String, b:String, c:String)
.decl eq  (a:String, b:String)
.output eq  ()


succ("1", "2").
succ("2", "3").
succ("3", "4").

f("x", "g").
f("y", "f").

arg("x", "1", "A").
arg("x", "2", "B").
arg("x", "3", "Z").

arg("y", "1", "C").
arg("y", "2", "D").
arg("y", "3", "W").

eq(a, b) :- f(v, a), f(w, b), args(v, w, "3").

args(v, w, i) :- succ(p, i), arg(v, i, k), arg(w, i, k), args(v, w, p).
args(v, w, "1") :- arg(v, "1", _), arg(w, "1", _).

// ==== END: d:\work24\souffle-lsp-plugin\example\func\func.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\k-permutations\k-permutations.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl S(s:symbol)
.decl P(s:symbol)

.input S

P(x) :- S(x).
P(cat(x, cat(",", y))) :- S(x), P(y), !contains(x, y).

.output P

