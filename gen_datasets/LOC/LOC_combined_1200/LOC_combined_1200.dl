// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\earley\earley.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Label <: number

.type NT <: symbol
.type Letter <: symbol
.type Symbol = NT | Letter

.type Pos <: number

// Head stored in position 0 of prod
.decl Prod				(x:Label, p:Pos, s:Symbol)
.decl String			(c:Pos, a:Letter)
.input Prod
.input String

.decl EndProd			(x:Label, p:Pos)
.decl EndString			(c:Pos)

.decl NotEndProd		(x:Label, p:Pos)
.decl NotEndString		(c:Pos)

NotEndProd(x, p) :- Prod(x, p, _), Prod(x, q, _), p < q.
EndProd(x, p + 1) :- Prod(x, p, _), !NotEndProd(x, p).

NotEndString(c) :- String(c, _), String(d, _), c < d.
EndString(c + 1) :- String(c, _), !NotEndString(c).

// Adapted from Earley parser - Wikipedia

// Current parse position in the string is c, production x has been matched
// up to position p in the body starting at position j in the input string.
.decl State			(c:Pos, x:Label, p:Pos, j:Pos)

// Initialization: at input position 1, production 1 has matched 0 symbols from origin 1.
State(1, 1, 1, 1).

// Prediction
State(c, x, 1, c) :- State(c, y, p, _), Prod(x, 0, n), Prod(y, p, n).

// Scanning
State(c + 1, x, p + 1, j) :- String(c, a), State(c, x, p, j), Prod(x, p, a).

// Completion
State(c, x, p + 1, j) :- State(c, y, q, k), EndProd(y, q), Prod(y, 0, n), State(k, x, p, j), Prod(x, p, n).

.type Answer <: symbol
.decl Accept			(s:Answer)

Accept("Yes") :- State(c, 1, q, 1), EndString(c), EndProd(1, q).
.output Accept

// ==== END: d:\work24\souffle-lsp-plugin\example\earley\earley.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tc\tc.dl ====
//// Reproduced from [FD92]
//// Adopted from DES

.type Node <: symbol

.decl tcl  (node1:Node, node2:Node)
.output tcl  ()
.decl tcr  (node1:Node, node2:Node)
.output tcr  ()
.decl base (node1:Node, node2:Node)
.output base ()
.input base ()
.decl tc (node1:Node, node2:Node)
.output tc ()

// Left-Recursive Transitive Closure
tcl(X, Y) :- base(X,Y).
tcl(X,Y) :- tcl(X,Z), base(Z,Y).

// Right-recursive Transitive Closure
tcr(X,Y) :- base(X,Y).
tcr(X,Y) :- base(X, Z),tcr(Z,Y).

// Double-recursive Transitive Closure
tc(X,Y) :- base(X,Y).
tc(X,Y) :- tc(X,Z),tc(Z,Y).

// base relation
base("a","b").
base("b","c").
base("c","d").

