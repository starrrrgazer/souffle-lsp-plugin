// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\func\func.dl ====
.type String <: symbol

.decl f(v:String, f:String)
.decl succ (v:String, f:String)
.decl arg (v:String, i:String, a:String)
.decl args (a:String, b:String, c:String)
.decl eq  (a:String, b:String)
.output eq  ()


succ("1", "2").
succ("2", "3").
succ("3", "4").

f("x", "g").
f("y", "f").

arg("x", "1", "A").
arg("x", "2", "B").
arg("x", "3", "Z").

arg("y", "1", "C").
arg("y", "2", "D").
arg("y", "3", "W").

eq(a, b) :- f(v, a), f(w, b), args(v, w, "3").

args(v, w, i) :- succ(p, i), arg(v, i, k), arg(w, i, k), args(v, w, p).
args(v, w, "1") :- arg(v, "1", _), arg(w, "1", _).

