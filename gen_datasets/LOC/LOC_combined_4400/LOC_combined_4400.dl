//
// profile_json.dl
//
// Example for logging in json format.
//

// The '.json' extension here is recognised, and so logging will be
// produced in JSON format.
.pragma "profile" "profile_json.json"

.decl p(x:number, y:number)
.input p

.decl q(x:number, y:number)
.output q

q(x, y) :- p(x, y).
q(x, z) :- p(x, y), q(y, z).

