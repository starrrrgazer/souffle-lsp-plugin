// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

.type node = number

// defines the interface and some basic properties
.comp Closure {
    .decl edge(a:node,b:node)
    .decl link(a:node,b:node)
.output link()

    link(X,Y) :- edge(X,Y).
}

// strategy A
.comp LeftRecursive : Closure {
    link(X,Z) :- link(X,Y), edge(Y,Z).
}

// strategy B
.comp RightRecursive : Closure {
    link(X,Z) :- edge(X,Y), link(Y,Z).
}

// strategy C
.comp QuadraticRecursive : Closure {
    link(X,Z) :- link(X,Y), link(Y,Z).
}


// get input data
.decl less(a:node,b:node)
less(1,2).
less(2,3).
less(3,4).
less(4,5).
less(5,6).


// init strategies
.init A = LeftRecursive
.init B = RightRecursive
.init C = QuadraticRecursive

// wire in input data
A.edge(X,Y) :- less(X,Y).
B.edge(X,Y) :- less(X,Y).
C.edge(X,Y) :- less(X,Y).




// ==== END: d:\work24\souffle-lsp-plugin\example\strategies\strategies.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl gen(x : number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//factors excluding 1
.decl factor(num : number, fc : number)
factor(x, fc) :- gen(x), gen(fc), x % fc = 0, fc != 1.

//finds if there exist two numbers which multiply to x
.decl prod(num : number)
prod(x) :- gen(x), gen(a), gen(b), b != x, a != x, x = a*b.

//finds the prime factors
.decl p_factor(x : number, fc : number)
.output p_factor()
p_factor(x, fc) :- factor(x, fc), !prod(fc).

// ==== END: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Subtracts the number of `-` from the number of `+`

.type index <: number
.type counter <: number
.type program <: symbol

.decl torun(p : program)
.input torun

.decl progress(i : index, c : counter, p : program)
progress(0,0,p) :- torun(p).
progress(i+1,c+1,p) :- progress(i,c,p), "+"=substr(p,i,1).
progress(i+1,c-1,p) :- progress(i,c,p), "-"=substr(p,i,1).
progress(i+1,c,p) :-
    progress(i,c,p),
    i < strlen(p),
    "+" != substr(p,i,1),
    "-" != substr(p,i,1).

.decl result(c : counter, p : program)
result(c,p) :- progress(strlen(p),c,p).
.output result

// ==== END: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\independent_body3\independent_body3.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Tests rules containing body literals that are independent of the
// head arguments (i.e. they are 'constant' wrt. head arguments).

.decl a(x:number)
a(x) :- b(x), c(y), d(y).

.decl b(x:number)
b(0).
b(x+1) :- a(x), x < 1000000.

.decl c(x:number)
c(0).
c(x+2) :- c(x), x < 1000.

.decl d(x:number)
d(0).
d(x+3) :- d(x), x < 1000.

.decl query(x:number)
.output query()
query(x) :- a(x), x < 10.

