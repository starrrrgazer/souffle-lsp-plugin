//
// Compute Ackermann function
//

// attribute types
.type Integer <: symbol

// declarations
.decl succ (a:Integer, b:Integer)
.decl greaterThanZ(a:Integer)
.decl ack(a:Integer, b:Integer, c:Integer)
.output ack()

// IDB
ack("0", N, Ans) :-
    succ(N, Ans).

ack(M, "0", Ans) :-
    greaterThanZ(M),
    succ(X, M),
    ack(X, "1", Ans).

ack(M, N, Ans) :-
    greaterThanZ(M),
    greaterThanZ(N),
    succ(X, M),
    succ(Y, N),
    ack(M, Y, Ans2),
    ack(X, Ans2, Ans).

// EDB
