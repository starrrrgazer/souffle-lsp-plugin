//
// Compute the sum of a graph
//

.decl Edge      (x:number, y:number, z:number)
.decl Linksum      (x:number, y:number, z:number)
.output Linksum      ()
.decl A (x:number, y:number, z:number)
.decl R (x:number, y:number)

Linksum(X,Y,N) :- Edge(X,Y,N).
Linksum(X,Y,R) :- Edge(X,Z,N), Linksum(Z,Y,M), A(M, N, R).

A(X,Y,X+Y) :- R(X,Y).

Edge(1,2,1).
Edge(1,3,1).
Edge(2,6,1).
Edge(2,4,1).
Edge(4,2,1).
Edge(3,5,1).
Edge(3,4,1).
Edge(5,6,1).

R(0,0).
R(1,0).
R(1,1).
R(2,0).
R(2,1).
R(2,2).
R(0,3).
R(1,3).
R(3,2).
R(3,3).
R(0,4).
R(4,1).
R(2,4).
R(3,4).
R(4,4).
R(0,5).
R(1,5).
R(2,5).
R(3,5).
R(4,5).
R(5,5).
R(5,0).
R(5,1).
R(5,2).
R(5,3).
R(5,4).
R(5,5).

// ==== END: d:\work24\souffle-lsp-plugin\example\linksum\linksum.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\circuit_eval\circuit_eval.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
//	Forward circuit evaluation
// 	Yield the value of each wire, given the input wire assignments
//


.type Var <: symbol
.type Bool <: symbol

//bitwise gates
.decl g_and(res : Var, o1 : Var, o2 : Var)
.input g_and()
.decl g_or(res : Var, o1 : Var, o2 : Var)
.input g_or()
.decl g_not(res : Var, o1 : Var)
.input g_not()

//the input values for wires
.decl set_input(x : Var, y : Bool)
.input set_input()
//querying a wire's value
.decl g_assignment(x : Var, y : Bool)
.output g_assignment()

g_assignment(x, "true") :-
	set_input(x, "true");
	g_and(x, o1, o2), g_assignment(o1, "true"), g_assignment(o2, "true");
	g_or(x, o1, _), g_assignment(o1, "true");
	g_or(x, _, o2), g_assignment(o2, "true");
 	g_not(x, o1), g_assignment(o1, "false").

g_assignment(x, "false") :-
	set_input(x, "false");
	g_and(x, o1, _), g_assignment(o1, "false");
 	g_and(x, _, o2), g_assignment(o2, "false");
	g_or(x, o1, o2), g_assignment(o1, "false"), g_assignment(o2, "false"),
	g_not(x, o1), g_assignment(o1, "true").

//same as g_assignment, however only outputs non-inputs
.decl yield_outs(x : Var, val : Bool)
.output yield_outs()
yield_outs(x, val) :-
	!set_input(x, _), g_assignment(x, val).

// ==== END: d:\work24\souffle-lsp-plugin\example\circuit_eval\circuit_eval.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Simulates a Deterministic Finite Automata to parse strings

.type state <: symbol
.type string <: symbol
.type index <: number

.decl transition(from : state, on : string, to : state)
.input transition

.decl accepting(x : state)
.input accepting

.decl start(x : state)
.input start

.decl toparse(x : string)
.input toparse

// When parsing `in` we have processed `i` characters and are at state `cur`
.decl parse(in : string, cur : state, i : index)
parse(in,cur,0) :- toparse(in), start(cur).
parse(in,new,i+j) :-
    parse(in,old,i),
    transition(old,diff,new),
    j=strlen(diff),
    diff=substr(in,i,j).
// The rule above can cause the AST translator to fail in old versions of Souffle

.decl accept(in : string)
accept(in) :- parse(in,cur,strlen(in)), accepting(cur).

.decl out(s : string, result : symbol)
out(s, "Accept") :- accept(s).
out(s, "Reject") :- toparse(s), !accept(s).
.output out

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====

