// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized\comp-parametrized.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp CallGraph {
    .decl CallGraphEdge(caller: number, callee: number)
.output CallGraphEdge()
    .decl Node(n: number)
    Node(1).
    Node(n + 1) :- Node(n), n < 10.
}

.comp CHACallGraph : CallGraph {
    CallGraphEdge(x, y + 1) :- Node(x), Node(y+1), x = y.
    CallGraphEdge(x + 1, y) :- Node(x+1), Node(y), x = y, x < 5.
}

.comp CICallGraph : CallGraph {
    CallGraphEdge(1,4).
}

.comp Main<CallGraphFlavour> {
    .init cg = CallGraphFlavour

    .decl NoWayBack(x: number, y: number)
.output NoWayBack()
    NoWayBack(x, y) :-
        cg.Node(x), cg.Node(y),
        cg.CallGraphEdge(x, y), !cg.CallGraphEdge(y, x).
}

.init cha_main = Main<CHACallGraph>
.init ci_main = Main<CICallGraph>

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized\comp-parametrized.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the highest in and out degree nodes in the graph
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

.decl HighestOutDegree(d:number)
.output HighestOutDegree()
HighestOutDegree(d) :- OutDegree(_, _), d = max D : OutDegree(_, D).

.decl HighestInDegree(d:number)
.output HighestInDegree()
HighestInDegree(d) :- InDegree(_, _), d = max D : InDegree(_, D).


// ==== END: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

// some subsets
.decl A( x : number )
.decl B( x : number )
.decl C( x : number )
.decl D( x : number )
.decl E( x : number )


// A
A(0).

// B
B(1).
B(2).
B(3).

// C
C(4).
C(5).
C(6).

// D
D(3).
D(4).

// E
E(6).
E(7).

// the universe
.decl U( x : number )
.output U()
U(X) :- A(X) ; B(X) ; C(X) ; D(X); E(X) .

// an empty set
.decl N( x : number )
.output N()
N(X) :- A(X), B(X).


.decl R1( x : number )
.output R1()
R1(X) :- A(X) ; B(X) , D(X) .

.decl R2( x : number )
.output R2()
R2(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R3( x : number )
.output R3()
R3(X) :- U(X) , !( B(X) , D(X) ) .

.decl R4( x : number )
.output R4()
R4(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R5( x : number )
.output R5()
R5(X) :- U(X) , !!!( B(X) ; D(X) ) .

.decl R6( x : number )
.output R6()
R6(X) :- (!B(X) ; D(X)) , U(X) .


