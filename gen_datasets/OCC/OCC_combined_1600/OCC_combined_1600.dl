// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\edit_distance\edit_distance.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Letter <: symbol
.type Pos <: number
.type Cost <: number

.decl String1			(p:Pos, a:Letter)
.decl String2			(p:Pos, a:Letter)

.input String1
.input String2

.decl End1				(p:Pos)
.decl End2				(p:Pos)
.decl NotEnd1			(p:Pos)
.decl NotEnd2			(p:Pos)

NotEnd1(p) :- String1(p, _), String1(q, _), p < q.
End1(p) :- String1(p, _), !NotEnd1(p).
NotEnd2(p) :- String2(p, _), String2(q, _), p < q.
End2(p) :- String2(p, _), !NotEnd2(p).

.decl Match				(i:Pos, j:Pos, c:Cost)

Match(0, 0, 0).

// Match a character
Match(i + 1, j + 1, s) :- End1(e), i < e, End2(f), j < f, Match(i, j, s), String1(i + 1, a), String2(j + 1, a).

// Indels
Match(i + 1, j, s + 1) :- End1(e), i < e, End2(f), j <= f, Match(i, j, s).
Match(i, j + 1, s + 1) :- End1(e), i <= e, End2(f), j < f, Match(i, j, s).

.decl MinMatch			(i:Pos, j:Pos, c:Cost)
.decl NotMinMatch		(i:Pos, j:Pos, c:Cost)

NotMinMatch(i, j, s) :- Match(i, j, s), Match(i, j, t), t < s.
MinMatch(i, j, s) :- Match(i, j, s), !NotMinMatch(i, j, s).
//MinMatch(i, j, s) :- s = min t : Match(i, j, t).

.decl Result			(c:Cost)

Result(c) :- End1(e), End2(f), MinMatch(e, f, c).
.output Result

// ==== END: d:\work24\souffle-lsp-plugin\example\edit_distance\edit_distance.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()
.decl satellite (x:D,y:D)
.output satellite ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

satellite(X,Y) :-
  orbits(X,Y),
  !intermediate(X,Y),
  !star(Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).



// ==== END: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Limit(weight:number)
Limit(h) :- h = sum w : Edge(_,_,w).

.decl Path(source:symbol,destination:symbol,path:number)
Path(a,c,w) :- Edge(a,c,w).
Path(a,c,w1+w2) :-
  Limit(h),
  Edge(a,b,w1),
  Path(b,c,w2),
    w2 < h-w1.

.decl FindingShorterPath(source:symbol,destination:symbol,weight:number)
FindingShorterPath(a,b,w1) :-
  Path(a,b,w1),
  Path(a,b,w2),
  w2<w1.

.decl ShortestPath(source:symbol,destination:symbol,weight:number)
ShortestPath(a,b,w) :-
  Path(a,b,w),
  !FindingShorterPath(a,b,w).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2020, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// This example shows a simple rewrite system using records
// and equivalence relations. An expression is expressed via
// recursively defined records. Each sub-tree in the expression
// can be rewritten. Equivalent terms are put into the same
// equivalence class.

// Expression
.type Expr=[
   op:symbol,   // operand: +,-,*,+, <=, !, >=, <, >
   left:Expr,   // left operand (if needed)
   right:Expr,  // right operand (if needed)
   nval:number, // number if op is "num"; otherwise not used
   var:symbol   // variable symbol if op is "var"; otherwise not used
]

// Input expressions
.decl A(e:Expr)
A(
   ["!",
      ["<",
       ["+",["num",nil,nil,10,""],["B",nil,nil,20,""],0, ""],
       ["+",["num",nil,nil,30,""],["B",nil,nil,40,""],0, ""], 0,""],
      nil,
      0,""]).

// Term-Rewriter
.decl S(e1:Expr, e2:Expr) eqrel

// Populate input
S(e, e) :-
   A(e).

// Put sub-expression into equivalence class
S(right,right) :-
   S([_,_,right,_,_],_).

S(left,left) :-
   S([_,left,_,_,_],_).

// Recombine sub-expressions from equivalence classes
S([op, newLeft, newRight, num, sym], x) :-
  S([op, left, right, num, sym], x),
  S(left, newLeft),
  S(right, newRight).

// Rewrite rules (examples)

// rewrite rule num1 + num2 => num3 where num3 is num1+num2
S(["num", nil, nil, a+b, ""],x) :-
   S(["+", ["num", _, _, a, _],
           ["num", _, _, b, _], _, _], x).

// rewrite rule !(a < b) => a >= b
S([">=", a, b, 0, ""],x) :-
   S(["!", ["<", a, b, _, _], nil, _, _],x).

// compute size of each expression
.decl ExprSize(x:Expr, m:number)
ExprSize(nil, 0).
ExprSize([op, left, right, num, sym], d1 + d2 + 1) :-
   S([op, left, right, num, sym], _),
   ExprSize(left, d1),
   ExprSize(right, d2).

// find smallest expression for each input
// the solution might not be unique.
.decl B(e1:Expr, e2:Expr)
B(e1, e2) :-
   A(e1),
   min_d = min d: {S(e1, e2), ExprSize(e2, d)},
   S(e1,e2),
   ExprSize(e2, min_d).

.output B

// ==== END: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

.type Node <: symbol
.decl flight      (node1:Node, node2:Node, node3:Node)
.decl QAflies   (node1:Node, node2:Node)
.output QAflies   ()
.decl VAflies   (node1:Node, node2:Node)
.output VAflies   ()
.decl QAonly   (node1:Node, node2:Node)
.output QAonly   ()

QAflies(X,Y) :- flight("QA",X,Y).
QAflies(X,Y) :- flight("QA",X,Z), QAflies(Z,Y).

VAflies(X,Y) :- flight("VA",X,Y).
VAflies(X,Y) :- flight("VA",X,Z), VAflies(Z,Y).

QAonly(X,Y)  :- QAflies(X,Y), ! VAflies(X,Y).

flight("QA","AU","CHI").
flight("QA","AU","JPN").
flight("QA","JPN","DEN").
flight("QA","JPN","CHI").
flight("QA","AU","CHI").
flight("VA","AU","CHI").
flight("VA","JPN","ZA").
flight("VA","JPN","DEN").
flight("VA","DEN","ZA").

// ==== END: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\cba_expr_value\cba_expr_value.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// An example constraint-based analysis:
//
// Given the Lambda term: (\ denotes a lambda)
//
//	(\x. x 3 2) (\y.\z.z)
//
// what is its value?
//


// Step A) model the input code

.type Kind <: symbol

.decl kind(k:Kind)

kind("Lit").
kind("Var").
kind("Abs").
kind("App").

// the global term register - id, kind and index in corresponding relation
.decl term( id:number, k:Kind, i:number )


.type Value <: symbol

.decl lits( i:number, n:Value )

lits( 0, "3" ).
lits( 1, "2" ).

term( 0, "Lit", 0 ).
term( 1, "Lit", 1 ).


.type VarName <: symbol
.decl vars( i:number, n:VarName )

vars( 0, "x" ).
vars( 1, "y" ).
vars( 2, "z" ).

term( 2, "Var", 0 ).
term( 3, "Var", 1 ).
term( 4, "Var", 2 ).


.decl abs( i:number, v:number, b:number)

abs( 0, 0, 8 ).
abs( 1, 1, 7 ).
abs( 2, 2, 4 ).

term( 5, "Abs", 0 ).
term( 6, "Abs", 1 ).
term( 7, "Abs", 2 ).


.decl app( i:number, t1:number, t2:number )

app( 0, 9, 1 ).
app( 1, 2, 0 ).
app( 2, 5, 6 ).

term( 8, "App", 0 ).
term( 9, "App", 1 ).
term(10, "App", 2 ).


////////////////////////////////////////////////////////////////////////////////////////////////////

// Step B) Analysis - get the value computed by the term


.decl data_var( i:number, v:Value )
.decl data_term( i:number, v:Value )
.output data_term()

.decl ctrl_var( i:number, f:number )
.decl ctrl_term( i:number, f:number )


//////////// D - Data Analysis //////////////

// the value of a literal is the value it is representing
data_term( i, v ) :- term(i,"Lit",l), lits( l, v ).

// the value of a variable is the value in the variable assignment
data_term( i, v ) :- term(i,"Var",x), data_var( x, v ).

// the value of an application is the value of the body of the targeted abstraction
data_term( i, v ) :- term(i,"App",x), app(x,t1,_), ctrl_term(t1, f), abs( f, _, b), data_term( b, v ).

// the value of an abstraction is not defined

// parameter binding
data_var( i, v ) :- app( _, a, b ), ctrl_term( a, f ), abs( f, i, _), data_term( b, v).


//////////// C - Control Flow Analysis //////////////

// the value of a variable is the value in the variable assignment
ctrl_term( i, v ) :- term(i,"Var",x), ctrl_var( x, v ).

// the value of an application is the value of the body of the targeted abstraction
ctrl_term( i, v ) :- term(i,"App",x), app(x,t1,_), ctrl_term(t1, f), abs( f, _, b), ctrl_term( b, v ).

// the control flow value of an abstraction is the term itself
ctrl_term( i, v ) :- term( i, "Abs", v ).

// parameter binding
ctrl_var( i, v ) :- app( _, a, b ), ctrl_term( a, f ), abs( f, i, _), ctrl_term( b, v).


// ==== END: d:\work24\souffle-lsp-plugin\example\cba_expr_value\cba_expr_value.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Type Node
.type Node <: symbol

//
// Edges non circular
//

.decl Edge        (n:Node, m:Node, w:number)

Edge("0","1",3).
Edge("1","2",5).
Edge("2","3",1).
Edge("1","4",-6).
Edge("4","2",-1).

//
// Reachable
//

.decl Reachable   (n:Node, m:Node, i:number)
.output Reachable   ()

Reachable(x,y,r)  :- r=w, Edge(x,y,w).
Reachable(x,y,d+w)  :- Edge(x,z,w), Reachable(z,y,d).


.decl ShortestDuplicates(n:Node, m:Node, i:number)
.output ShortestDuplicates()

ShortestDuplicates(x,y,a) :- Reachable(x,y,a), Reachable(x,y,b), a<b.

// ==== END: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Finds the length of the path that visits the most nodes without overlapping itself

.type node <: symbol

.decl edge(x : node, y : node)
.input edge()

// Find all paths between all nodes
.decl length(x : node, y : node, l : number)
length(x,y,l) :- l = 2, edge(x, y).
length(x,y,l+1) :- edge(x, z), length(z, y, l).

// Find the start and end of the path with the most nodes visited
.decl longest_path(x : node, y : node, l : number)
.output longest_path()
longest_path(y, x, l) :- l = max m : length(x, y, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Text <: symbol

.decl food(name:Text, carbs:number, fat:number, protein:number, per:number, measure:Text)
.input food()

.decl recipe(index: number, name:Text, amount: number, measure: Text)
.input recipe()

.decl max_index(result:number)
.output max_index()

max_index(a) :-  a = max a : recipe(a,_,_,_) .

.decl totals(name:Text, amount:number, carbs:number, fat:number, protein:number, cal:number)
.output totals()

totals(name, amount, amount*a/per, amount*b/per, amount*c/per, ((4*amount*a/per)+(9*amount*b/per)+(4*amount*c/per))) :- recipe(_, name, amount, _), food(name, a,b,c,per,_).


.decl calories(result:number)
.output calories()

calories(result) :- result = sum a : totals(_,_,_,_,_,a).

// ==== END: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath2\minpath2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Path(source:symbol,destination:symbol,path:number)

Path(a,c,w) :-
  Edge(a,c,w).

Path(a,c,w1+w2) :-
  Path(a,b,w1),
  Edge(b,c,w2),
  h = sum w :Edge(_,_,w),
  (w1+w2) < h.

.decl ConnectedNodes(source:symbol,destination:symbol)

ConnectedNodes(a,b) :-
  Path(a,b,_).

.decl ShortestPath(source:symbol,destination:symbol,weight:number)

ShortestPath(a,b,w1) :-
  ConnectedNodes(a,b),
  w1 = min w2 : Path(a,b,w2).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath2\minpath2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Mat1(row:number,column:number,value:number)

Mat1(1,1,2).
Mat1(1,2,4).
Mat1(2,1,3).
Mat1(2,2,5).

.output Mat1()


.decl Mat2(row:number,column:number, value:number)

Mat2(1,1,2).
Mat2(1,2,4).
Mat2(1,3,4).
Mat2(2,1,3).
Mat2(2,2,5).
Mat2(2,3,6).

.output Mat2()


.decl Product(i:number,j:number, k:number, value:number)

Product(i,j,k,value1*value2) :-
	Mat1(i,k,value1),Mat2(k,j,value2).


.decl Mat3(row:number,column:number, value:number)

Mat3(i,j, value) :-
	Mat1(i,_,_), Mat2(_,j,_), value = sum x : Product(i,j,_,x).

.output Mat3()


// ==== END: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====

