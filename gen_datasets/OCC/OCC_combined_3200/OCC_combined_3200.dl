.decl fib(n:number, x:number)

fib(0, 0).
fib(1, 1).

fib(n+1, x+y) :- fib(n, x), fib(n-1, y), n < 20.

.output fib

// ==== END: d:\work24\souffle-lsp-plugin\example\fib1\fib1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\grid.dl ====
