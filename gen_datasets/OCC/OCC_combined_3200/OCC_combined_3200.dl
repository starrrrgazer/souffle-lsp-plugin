// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po3\po3.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(4,i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(7, i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(8, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(9, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(10, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(11, i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(12, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(13, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(14, i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(15, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po3\po3.dl ====

