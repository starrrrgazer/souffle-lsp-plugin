// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

// some subsets
.decl A( x : number )
.decl B( x : number )
.decl C( x : number )
.decl D( x : number )
.decl E( x : number )


// A
A(0).

// B
B(1).
B(2).
B(3).

// C
C(4).
C(5).
C(6).

// D
D(3).
D(4).

// E
E(6).
E(7).

// the universe
.decl U( x : number )
.output U()
U(X) :- A(X) ; B(X) ; C(X) ; D(X); E(X) .

// an empty set
.decl N( x : number )
.output N()
N(X) :- A(X), B(X).


.decl R1( x : number )
.output R1()
R1(X) :- A(X) ; B(X) , D(X) .

.decl R2( x : number )
.output R2()
R2(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R3( x : number )
.output R3()
R3(X) :- U(X) , !( B(X) , D(X) ) .

.decl R4( x : number )
.output R4()
R4(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R5( x : number )
.output R5()
R5(X) :- U(X) , !!!( B(X) ; D(X) ) .

.decl R6( x : number )
.output R6()
R6(X) :- (!B(X) ; D(X)) , U(X) .


// ==== END: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\cellular_automata\cellular_automata.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#include "array.dl"

// Cellular Automata
// Simulation of elementary cellular automaton to a given number of generations.

// The termination time, the simulation will stop after the given number of generations.
.decl terminate(time:number)
.input terminate()

// The transition function, giving the value of a cell at time t+1 from the values of that cell and its local environment at time t.
.decl transition(prev:number, center:number, next:number, value:number)
.input transition()

// The value of the cell to the left of the cell specified by the index at the given time, or the default value if it is out of the array bounds.
.decl prev(time:number, index:number, value:number)
prev(t, i, NULL) :- !element(i-1, _), cell(t, i, _), default(NULL).
prev(t, i, x) :- cell(t, i-1, x), element(i, _).

// The value of the cell to the right of the cell specified by the index at the given time, or the default value if it is out of the array bounds.
.decl next(time:number, index:number, value:number)
next(t, i, NULL) :- !element(i+1, _), cell(t, i, _), default(NULL).
next(t, i, x) :- cell(t, i+1, x), element(i, _).

// The cells, referenced by a time and their index in the backing array of elements, and having a value that is either 0 or 1.
.decl cell(time:number, index:number, value:number)
.output cell()

// The value of a cell at time 0 is the value of its backing element.
cell(0, i, x) :- element(i, x).

// The value of a cell at time t+1 is given by the transition function on the value of the local environment at time t.
cell(t+1, i, x) :- !terminate(t), environment(t, i, l, c, r), transition(l, c, r, x).

// The local environment of a cell, giving the value of the specified cell at time t, as well as that of its nearest neighbours.
.decl environment(time:number, index:number, prev:number, center:number, next:number)
.output environment()
environment(t, i, l, c, r) :-
  prev(t, i, l), cell(t, i, c), next(t, i, r).

// ==== END: d:\work24\souffle-lsp-plugin\example\cellular_automata\cellular_automata.dl ====

