// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:/work24/souffle-lsp-plugin/example/amicable/amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====
//
// An example computing all palendroms of a given length.
//

.type Letter <: symbol

.decl str(id:number, a:number, l:Letter, b:number)
.decl len(id:number, l:number)


//////////////////////////////////////////////////////////////////
//          index range          //
//////////////////////////////////////////////////////////////////

.decl p(x:number)

p(0).
p(x) :- str(_,_,_,x).




//////////////////////////////////////////////////////////////////
//          palindromes          //
//////////////////////////////////////////////////////////////////


.decl palin_aux(s:number, a:number, b:number)
palin_aux(s,x,x) :- str(s,_,_,_), p(x).
palin_aux(s,x,y) :- str(s,x,_,y).
palin_aux(s,x,y) :- str(s,x,a,t), palin_aux(s,t,r), str(s,r,a,y).

.decl palindrome(s:number)
.output palindrome()
palindrome(s) :- palin_aux(s,0,l), len(s,l).



//////////////////////////////////////////////////////////////////
//       words to be tested      //
//////////////////////////////////////////////////////////////////

// hello
str(0,0,"h",1).
str(0,1,"e",2).
str(0,2,"l",3).
str(0,3,"l",4).
str(0,4,"o",5).
len(0,5).


// racecar
str(1,0,"r",1).
str(1,1,"a",2).
str(1,2,"c",3).
str(1,3,"e",4).
str(1,4,"c",5).
str(1,5,"a",6).
str(1,6,"r",7).
len(1,7).


// noon
str(2,0,"n",1).
str(2,1,"o",2).
str(2,2,"o",3).
str(2,3,"n",4).
len(2,4).

// never odd or even
str(3,0,"n",1).
str(3,1,"e",2).
str(3,2,"v",3).
str(3,3,"e",4).
str(3,4,"r",5).
str(3,5,"o",6).
str(3,6,"d",7).
str(3,7,"d",8).
str(3,8,"o",9).
str(3,9,"r",10).
str(3,10,"e",11).
str(3,11,"v",12).
str(3,12,"e",13).
str(3,13,"n",14).
len(3,14).



// ==== END: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====

