// Tests rules containing body literals that are independent of the
// head arguments (i.e. they are 'constant' wrt. head arguments).

.decl a(x:number)
a(x) :- b(x), c(y), d(y).

.decl b(x:number)
b(0).
b(x+1) :- a(x), x < 1000000.

.decl c(x:number)
c(0).
c(x+2) :- c(x), x < 1000.

.decl d(x:number)
d(0).
d(x+3) :- d(x), x < 1000.

.decl query(x:number)
.output query()
query(x) :- a(x), x < 10.

// ==== END: d:\work24\souffle-lsp-plugin\example\independent_body3\independent_body3.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Y),
  orbits(_,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\func\func.dl ====
.type String <: symbol

.decl f(v:String, f:String)
.decl succ (v:String, f:String)
.decl arg (v:String, i:String, a:String)
.decl args (a:String, b:String, c:String)
.decl eq  (a:String, b:String)
.output eq  ()


succ("1", "2").
succ("2", "3").
succ("3", "4").

f("x", "g").
f("y", "f").

arg("x", "1", "A").
arg("x", "2", "B").
arg("x", "3", "Z").

arg("y", "1", "C").
arg("y", "2", "D").
arg("y", "3", "W").

eq(a, b) :- f(v, a), f(w, b), args(v, w, "3").

args(v, w, i) :- succ(p, i), arg(v, i, k), arg(w, i, k), args(v, w, p).
args(v, w, "1") :- arg(v, "1", _), arg(w, "1", _).

// ==== END: d:\work24\souffle-lsp-plugin\example\func\func.dl ====

