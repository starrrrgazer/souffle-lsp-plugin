// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====
// Type declarations
.type S <: symbol

// Set output flag depending on stage
.decl A (x:S, y:S)
.output A ()

// Transitive Closure
A(x,z) :- A(x,y), A(y,z).

// Facts
A("a","b").
A("b","c").
A("c","d").
A("d","e").

// ==== END: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====
// Stratifiable two-people game
// Equivalent to the nonstratifiable:
// winning(X) :- move(X,Y), not(winning(X)).
// April, 2011
// Adopted from DES

.type Node <: symbol

.decl move (node1:Node, node2:Node)
.output move ()
.decl odd_move (node1:Node, node2:Node)
.output odd_move ()
.decl canMove (node1:Node)
.output canMove ()
.decl possible_winning (node1:Node)
.output possible_winning ()
.decl winning (node1:Node)
.output winning ()

move("1","2").
move("2","3").
move("3","4").
move("1","3").
move("1","5").

canMove(X):- move(X,_).

possible_winning(X):- odd_move(X,Y), !canMove(Y).

winning(X):- move(X,Y), !possible_winning(Y).

odd_move(X,Y) :- move(X,Y).

odd_move(X,Y) :- move(X,Z1), move(Z1,Z2), odd_move(Z2,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Mat1(row:number,column:number,value:number)

Mat1(1,1,2).
Mat1(1,2,4).
Mat1(2,1,3).
Mat1(2,2,5).

.output Mat1()


.decl Mat2(row:number,column:number, value:number)

Mat2(1,1,2).
Mat2(1,2,4).
Mat2(1,3,4).
Mat2(2,1,3).
Mat2(2,2,5).
Mat2(2,3,6).

.output Mat2()


.decl Product(i:number,j:number, k:number, value:number)

Product(i,j,k,value1*value2) :-
	Mat1(i,k,value1),Mat2(k,j,value2).


.decl Mat3(row:number,column:number, value:number)

Mat3(i,j, value) :-
	Mat1(i,_,_), Mat2(_,j,_), value = sum x : Product(i,j,_,x).

.output Mat3()


// ==== END: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====

