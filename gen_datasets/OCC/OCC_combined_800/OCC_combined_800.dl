// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp Impl {
    .decl R(x: number)
    R(0). R(1). R(2).
}

.comp A<T> {
    .init impl = T
    .decl Base(x: number)
    Base(x) :- impl.R(x).
}

.comp Derived<K> : A<K> {
    .decl Deriv(x:number)
    Deriv(42).
    Deriv(n) :- Base(n).
}

.init d = Derived<Impl>
.init a = A<Impl>

.decl DerivedOut(x: number)
.output DerivedOut()
.decl AOut(x: number)
.output AOut()

DerivedOut(x) :- d.Deriv(x).
AOut(x) :- a.Base(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

.type Node <: symbol
.decl flight      (node1:Node, node2:Node, node3:Node)
.decl QAflies   (node1:Node, node2:Node)
.output QAflies   ()
.decl VAflies   (node1:Node, node2:Node)
.output VAflies   ()
.decl QAonly   (node1:Node, node2:Node)
.output QAonly   ()

QAflies(X,Y) :- flight("QA",X,Y).
QAflies(X,Y) :- flight("QA",X,Z), QAflies(Z,Y).

VAflies(X,Y) :- flight("VA",X,Y).
VAflies(X,Y) :- flight("VA",X,Z), VAflies(Z,Y).

QAonly(X,Y)  :- QAflies(X,Y), ! VAflies(X,Y).

flight("QA","AU","CHI").
flight("QA","AU","JPN").
flight("QA","JPN","DEN").
flight("QA","JPN","CHI").
flight("QA","AU","CHI").
flight("VA","AU","CHI").
flight("VA","JPN","ZA").
flight("VA","JPN","DEN").
flight("VA","DEN","ZA").

// ==== END: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====
//// Hypothetical Queries
//// Source: [Bonn99], extended and adapted
//// Adopted from DES

.type Node <: symbol

.decl student (node1:Node)
.output student ()
.decl course (node1:Node)
.output course ()
.decl pre (node1:Node, node2:Node)
.output pre ()
.decl take (node1:Node, node2:Node)
.output take ()
.decl grad (node1:Node)
.output grad ()

student("adam").
student("bob").
student("pete").
student("scott").
student("tony").

course("eng").
course("his").
course("lp").

take("adam","eng").
take("pete","his").
take("pete","eng").
take("scott","his").
take("scott","lp").
take("tony","his").

pre("eng","lp").
pre("hist","eng").

pre(Pre,Post) :- pre(Pre,X), pre(X,Post).

grad(S) :- take(S,"his"), take(S,"eng").

// ==== END: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




