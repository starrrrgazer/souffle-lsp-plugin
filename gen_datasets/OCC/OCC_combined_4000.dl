// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====
// Stratifiable two-people game
// Equivalent to the nonstratifiable:
// winning(X) :- move(X,Y), not(winning(X)).
// April, 2011
// Adopted from DES

.type Node <: symbol

.decl move (node1:Node, node2:Node)
.output move ()
.decl odd_move (node1:Node, node2:Node)
.output odd_move ()
.decl canMove (node1:Node)
.output canMove ()
.decl possible_winning (node1:Node)
.output possible_winning ()
.decl winning (node1:Node)
.output winning ()

move("1","2").
move("2","3").
move("3","4").
move("1","3").
move("1","5").

canMove(X):- move(X,_).

possible_winning(X):- odd_move(X,Y), !canMove(Y).

winning(X):- move(X,Y), !possible_winning(Y).

odd_move(X,Y) :- move(X,Y).

odd_move(X,Y) :- move(X,Z1), move(Z1,Z2), odd_move(Z2,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type State <: number
.type Letter <: symbol

.decl Q				(q:State)
.decl Init			(q:State)
.decl Final			(q:State)
.decl Tr			(q:State, a:Letter, r:State)

.input Final
.input Tr

Init(0).

Q(q) :- Tr(q, _, _).

.decl Dis			(q:State, r:State)

Dis(q, r) :- Q(q), Q(r), Final(q), !Final(r).
Dis(q, r) :- Tr(q, a, s), Tr(r, a, t), Dis(s, t).
Dis(q, r) :- Dis(r, q).

.decl Equiv		(q:State, r:State)

Equiv(q, r) :- Q(q), Q(r), !Dis(q, r).

.decl NotMinEquiv	(q:State, r:State)
.decl MinEquiv		(q:State, r:State)

NotMinEquiv(q, r) :- Equiv(q, r), Equiv(q, s), s < r.
MinEquiv(q, r) :- Equiv(q, r), !NotMinEquiv(q, r).

.output MinEquiv

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rsg\rsg.dl ====
.type Node <: symbol

.decl RSG (node1:Node, node2:Node)
.output RSG ()
.decl FLAT(node1:Node, node2:Node)
.output FLAT()
.decl UP  (node1:Node, node2:Node)
.output UP  ()
.decl DOWN(node1:Node, node2:Node)
.output DOWN()

RSG(x,y) :- FLAT(x,y).
RSG(x,y) :- UP(x, a), RSG(b, a), DOWN(b, y).

UP("a","e").
UP("a","f").
UP("f","m").
UP("g","n").
UP("h","n").
UP("i","o").
