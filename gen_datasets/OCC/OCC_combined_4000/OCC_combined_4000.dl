// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl fib(n:number, x:number)

fib(0, 0).
fib(1, 1).

fib(n+1, x+y) :- fib(n, x), fib(n-1, y), n < 20.

.output fib

// ==== END: d:\work24\souffle-lsp-plugin\example\fib1\fib1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tree\tree.dl ====

.type Node <: symbol

.decl S      (node1:Node, node2:Node)
.output S      ()
.decl T      (node1:Node, node2:Node)
.output T      ()
.decl R      (node1:Node, node2:Node, node3:Node)

S (x1, x3) :- T(x1, x2), R(x2, _, x3).
T (x1, x4) :- R(x1, _, x2), R(x2, _, x3), T(x3, x4).
T (x1, x3) :- R(x1, a, x2), R(x2, a, x3).


R("1", "a", "2").
R("2", "b", "3").
R("3", "a", "4").
R("4", "a", "5").
R("5", "a", "6").

