// Unary relations
.decl University (a:symbol)
.output University ()
.input University ()
.decl Person (a:symbol)
.output Person ()
.decl Employee (a:symbol)
.output Employee ()
.decl Faculty (a:symbol)
.output Faculty ()
.decl Professor (a:symbol)
.output Professor ()
.decl Course (a:symbol)
.output Course ()
.input Course ()
