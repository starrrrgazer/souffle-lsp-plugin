// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the highest in and out degree nodes in the graph
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

.decl HighestOutDegree(d:number)
.output HighestOutDegree()
HighestOutDegree(d) :- OutDegree(_, _), d = max D : OutDegree(_, D).

.decl HighestInDegree(d:number)
.output HighestInDegree()
HighestInDegree(d) :- InDegree(_, _), d = max D : InDegree(_, D).


// ==== END: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(5,i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(6,i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(7, i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(8, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(9, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(10, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(11, i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(12, i) :- Check(a, _, c, _, _, f), In(a, _, c, _, _, f, i).
A(13, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(14, i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(15, i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\k-permutations\k-permutations.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl S(s:symbol)
.decl P(s:symbol)

.input S

P(x) :- S(x).
P(cat(x, cat(",", y))) :- S(x), P(y), !contains(x, y).

.output P

// ==== END: d:\work24\souffle-lsp-plugin\example\k-permutations\k-permutations.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Find the perfect numbers that occur before the limit
//

.decl gen(x: number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//fc is factors of x, excluding itself
.decl e_factor(x : number, fc : number)
e_factor(x, fc) :- gen(fc), gen(x), x % fc = 0, x!=fc.

//x is equal to the sum of its factors excluding itself
.decl perfect(x : number)
.output perfect()
perfect(x) :- gen(x), x = sum inv : e_factor(x, inv).

// ==== END: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====

