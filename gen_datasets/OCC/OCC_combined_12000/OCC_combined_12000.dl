// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute a Lucas Sequence.

// Maximum sequence element.
.decl lim(l:number)
.input lim()

// Coefficients for the sequence.
.decl pq(p:number, q:number)
.input pq()

// Relation composing the i'th element of this sequence.
// Base cases given in the .facts file.
.decl lucas(i:number, n:number)
.output lucas()
.input lucas()

lucas(I+1, P*N - Q*M) :- lucas(I, N), lucas(I-1, M), pq(P, Q), !lim(I).

// ==== END: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_access-policy\magic_access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

// A copy of the `access-policy' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_access-policy\magic_access-policy.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp Impl {
    .decl R(x: number)
    R(0). R(1). R(2).
}

.comp A<T> {
    .init impl = T
    .decl Base(x: number)
    Base(x) :- impl.R(x).
}

.comp Derived<K> : A<K> {
    .decl Deriv(x:number)
    Deriv(42).
    Deriv(n) :- Base(n).
}

.init d = Derived<Impl>
.init a = A<Impl>

.decl DerivedOut(x: number)
.output DerivedOut()
.decl AOut(x: number)
.output AOut()

DerivedOut(x) :- d.Deriv(x).
AOut(x) :- a.Base(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====
//// Hypothetical Queries
//// Source: [Bonn99], extended and adapted
//// Adopted from DES

.type Node <: symbol

.decl student (node1:Node)
.output student ()
.decl course (node1:Node)
.output course ()
.decl pre (node1:Node, node2:Node)
.output pre ()
.decl take (node1:Node, node2:Node)
.output take ()
.decl grad (node1:Node)
.output grad ()

student("adam").
student("bob").
student("pete").
student("scott").
student("tony").

course("eng").
course("his").
course("lp").

take("adam","eng").
take("pete","his").
take("pete","eng").
take("scott","his").
take("scott","lp").
take("tony","his").

pre("eng","lp").
pre("hist","eng").

pre(Pre,Post) :- pre(Pre,X), pre(X,Post).

grad(S) :- take(S,"his"), take(S,"eng").

// ==== END: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Relation(a:symbol, b:symbol, step:number,turn:symbol)
Relation(a, c, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
    			a!=c.

Relation(d, e, step+1,c) :-
			Relation(a, b, step, a),
			Relation(b, c, step, a),
			Relation(d, e, step, a),
    			a!=c,
			d!=a,
			d!=b.



.output Relation

Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","d",0,"a").
Relation("d","e",0,"a").
Relation("e","f",0,"a").
Relation("f","a",0,"a").


/*
 // Small test case:
Relation("a","b",0,"a").
Relation("b","c",0,"a").
Relation("c","a",0,"a").
*/

.decl Josephus(a:symbol)
Josephus(a) :-
			Relation(a, b, step, a),
			Relation(b, a, step, a).
.output Josephus

// ==== END: d:\work24\souffle-lsp-plugin\example\josephus\josephus.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

.type Node <: symbol

.decl father      (node1:Node, node2:Node)
.decl mother      (node1:Node, node2:Node)
.decl parent      (node1:Node, node2:Node)
.output parent      ()
.decl ancestor    (node1:Node, node2:Node)
.output ancestor    ()
.decl grandmother (node1:Node, node2:Node)
.output grandmother ()
.decl sibling      (node1:Node, node2:Node)
.output sibling      ()
.decl cousin       (node1:Node, node2:Node)
.output cousin       ()
.decl relative       (node1:Node, node2:Node)
.output relative       ()

parent(X,Y) :- father(X,Y).
parent(X,Y) :- mother(X,Y).

ancestor(X,Y) :- parent(X,Y).
ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y).

grandmother(X,Y) :- mother(X,Z), ancestor(Z,Y).

sibling(X,Y) :- parent(Z,X), parent(Z,Y), X != Y.

cousin(X,Y) :- ancestor(Z,X), ancestor(Z,Y), X != Y, !sibling(X,Y), !parent(X,Y).

relative(X,Y) :- sibling(X,Z),parent(Z,Y).

father("tom","amy").
father("tom","adam").
father("jack","fred").
father("tony","carolII").
father("fred","carolIII").
mother("graceI","amy").
mother("amy","fred").
mother("carolI","carolII").
mother("carolII","carolIII").

// ==== END: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Limit(weight:number)
Limit(h) :- h = sum w : Edge(_,_,w).

.decl Path(source:symbol,destination:symbol,path:number)
Path(a,c,w) :- Edge(a,c,w).
Path(a,c,w1+w2) :-
  Limit(h),
  Edge(a,b,w1),
  Path(b,c,w2),
    w2 < h-w1.

.decl FindingShorterPath(source:symbol,destination:symbol,weight:number)
FindingShorterPath(a,b,w1) :-
  Path(a,b,w1),
  Path(a,b,w2),
  w2<w1.

.decl ShortestPath(source:symbol,destination:symbol,weight:number)
ShortestPath(a,b,w) :-
  Path(a,b,w),
  !FindingShorterPath(a,b,w).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(5,i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(6,i) :- Check(a, b, c, d, e, _), In(a, b, c, d, e, _, i).

A(7, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(9, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(10, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(11, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).

A(12, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(13, i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(14, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(15, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).

A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(18, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).

A(19, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====

