//// Test Case adopted from Ocaml datalog

.type Node <: symbol

.decl ship_to       (node1:Node, node2:Node)
.output ship_to       ()
.decl customer_city (node1:Node, node2:Node)
.output customer_city ()
.decl has_ordered   (node1:Node, node2:Node)
.output has_ordered   ()
.decl product_name  (node1:Node, node2:Node)
.output product_name  ()

ship_to(ProdName, City) :- has_ordered(CustNo, ProdNo), customer_city(CustNo, City), product_name(ProdNo, ProdName).

customer_city("1", "london").
customer_city("2", "paris").
