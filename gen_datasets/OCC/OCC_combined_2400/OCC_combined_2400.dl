succ("14", "15").
succ("15", "16").
succ("16", "17").
succ("17", "18").
succ("18", "19").
succ("19", "20").
succ("20", "21").

greaterThanZ("1").
greaterThanZ("2").
greaterThanZ("3").
greaterThanZ("4").
greaterThanZ("5").
greaterThanZ("6").
greaterThanZ("7").
greaterThanZ("8").
greaterThanZ("9").
greaterThanZ("10").
greaterThanZ("11").
greaterThanZ("12").
greaterThanZ("13").
