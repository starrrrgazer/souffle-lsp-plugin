.type Integer <: symbol

.decl plus_mod (x:Integer, y:Integer, r:Integer)
.decl succ (a:Integer, b:Integer)
.decl f(x:Integer, y:Integer)
.output f()

f("0", "0").
f("1", "1").
f(i, r) :- succ(prev, i), succ(pprev, prev),f(prev, x), f(pprev, y), plus_mod(x, y, r).


plus_mod("0", "0", "0").
plus_mod("0", "1", "1").
plus_mod("1", "0", "1").
plus_mod("1", "1", "2").
plus_mod("0", "2", "2").
plus_mod("2", "0", "2").
plus_mod("2", "1", "0").
plus_mod("1", "2", "0").
plus_mod("2", "2", "1").


succ("0", "1").
