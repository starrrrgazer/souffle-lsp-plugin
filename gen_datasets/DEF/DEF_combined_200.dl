// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2020, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// This example shows a simple rewrite system using records
// and equivalence relations. An expression is expressed via
// recursively defined records. Each sub-tree in the expression
// can be rewritten. Equivalent terms are put into the same
// equivalence class.

// Expression
.type Expr=[
   op:symbol,   // operand: +,-,*,+, <=, !, >=, <, >
   left:Expr,   // left operand (if needed)
   right:Expr,  // right operand (if needed)
   nval:number, // number if op is "num"; otherwise not used
   var:symbol   // variable symbol if op is "var"; otherwise not used
]

// Input expressions
.decl A(e:Expr)
A(
   ["!",
      ["<",
       ["+",["num",nil,nil,10,""],["B",nil,nil,20,""],0, ""],
       ["+",["num",nil,nil,30,""],["B",nil,nil,40,""],0, ""], 0,""],
      nil,
      0,""]).

// Term-Rewriter
.decl S(e1:Expr, e2:Expr) eqrel

// Populate input
S(e, e) :-
   A(e).

// Put sub-expression into equivalence class
S(right,right) :-
   S([_,_,right,_,_],_).

S(left,left) :-
   S([_,left,_,_,_],_).

// Recombine sub-expressions from equivalence classes
S([op, newLeft, newRight, num, sym], x) :-
  S([op, left, right, num, sym], x),
  S(left, newLeft),
  S(right, newRight).

// Rewrite rules (examples)

// rewrite rule num1 + num2 => num3 where num3 is num1+num2
S(["num", nil, nil, a+b, ""],x) :-
   S(["+", ["num", _, _, a, _],
           ["num", _, _, b, _], _, _], x).

// rewrite rule !(a < b) => a >= b
S([">=", a, b, 0, ""],x) :-
   S(["!", ["<", a, b, _, _], nil, _, _],x).

// compute size of each expression
.decl ExprSize(x:Expr, m:number)
ExprSize(nil, 0).
ExprSize([op, left, right, num, sym], d1 + d2 + 1) :-
   S([op, left, right, num, sym], _),
   ExprSize(left, d1),
   ExprSize(right, d2).

// find smallest expression for each input
// the solution might not be unique.
.decl B(e1:Expr, e2:Expr)
B(e1, e2) :-
   A(e1),
   min_d = min d: {S(e1, e2), ExprSize(e2, d)},
   S(e1,e2),
   ExprSize(e2, min_d).

.output B

// ==== END: d:\work24\souffle-lsp-plugin\example\rewrite\rewrite.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(3,i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).
A(4,i) :- Check(a, b, _, d, _, _), In(a, b, _, d, _, _, i).
A(5,i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(6,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(7, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(8, i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(9, i) :- Check(_, b, _, _, _, _), In(_, b, _, _, _, _, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Y),
  orbits(_,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\orbits1\orbits1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2021, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// define edge relation of a directed graph
.decl e(x:number, y:number, c:number)

e(1,2,1).
e(2,2,1).
e(2,3,1).
e(3,4,1).
e(1,4,100).

// define shortest path relation
.decl sp(x:number, y:number, c:number) btree_delete

//
// subsumption
//
// A longer path is subsumed by a shorter path, i.e.,
// the longer path is discarded from the relation.
sp(x,y,c1) <= sp(x,y, c2) :-
  c2 <= c1.

//
// base case
//
sp(x,y,c) :-
  e(x,y,c).

//
// inductive case
//
sp(x,z,c1 + c2) :-
  sp(x,y,c1),
  e(y,z,c2).

.output sp

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#include "grid.dl"

// Minesweeper
// Generates minesweeper boards, a cell containing a mine takes the value -1, while all other cells take the value of the number of mines in their local neighbourhood (i.e. in the eight cells to which they are adjacent.

// A mine count for a given cell is valid if it is between 0 and 8 inclusive.
.decl is_valid(x:number)
is_valid(0).
is_valid(x+1) :- is_valid(x), x < 8.

// The cells of the game board, taking the value -1 if the backing grid contains a value for the cell at the specified row and column, of the number of surrounding mines otherwise.
.decl cell(row:number, column:number, variable:number)
.output cell()
cell(i, j, -1) :- x != 0, element(i, j, x).
cell(i, j, x) :-
  x = tl + tc + tr + ml + mr + bl + bc + br,
  is_valid(x),
  neighbourhood(i, j, tl, tc, tr, ml, 0, mr, bl, bc, br).



// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp Impl {
    .decl R(x: number)
    R(0). R(1). R(2).
}

.comp A<T> {
    .init impl = T
    .decl Base(x: number)
    Base(x) :- impl.R(x).
}

.comp Derived<K> : A<K> {
    .decl Deriv(x:number)
    Deriv(42).
    Deriv(n) :- Base(n).
}

.init d = Derived<Impl>
.init a = A<Impl>

.decl DerivedOut(x: number)
.output DerivedOut()
.decl AOut(x: number)
.output AOut()

DerivedOut(x) :- d.Deriv(x).
AOut(x) :- a.Base(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====

