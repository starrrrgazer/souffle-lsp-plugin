// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt



.comp NumGenerator {
    .decl R(n:number)
}

.comp LotsOfNumGenerator : NumGenerator {
    R(0).
    R(n+1) :- R(n), n <= 10.
}

.comp BiggerNumGenerator : LotsOfNumGenerator {
    R(22).
}

.comp NumSelector<T> {
    .init generator = T
    .decl Selected(n: number)
    Selected(n) :- generator.R(n), generator.R(n*2).
}

.comp GoodNumSelector<T> : NumSelector<T> {
    Selected(42).
}

.comp Main<TSelector, TGenerator> {
    .init selector = TSelector<TGenerator>
    .decl Out(n:number)
.output Out()
    Out(x) :- selector.Selected(x).
}

.init main1 = Main<NumSelector, LotsOfNumGenerator>
.init main2 = Main<GoodNumSelector, LotsOfNumGenerator> // selects 42, even if it is not generated
.init main3 = Main<NumSelector, BiggerNumGenerator> // selects 22 = 2*11


// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-multilvl\comp-parametrized-multilvl.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====
// Stratifiable two-people game
// Equivalent to the nonstratifiable:
// winning(X) :- move(X,Y), not(winning(X)).
// April, 2011
// Adopted from DES

.type Node <: symbol

.decl move (node1:Node, node2:Node)
.output move ()
.decl odd_move (node1:Node, node2:Node)
.output odd_move ()
.decl canMove (node1:Node)
.output canMove ()
.decl possible_winning (node1:Node)
.output possible_winning ()
.decl winning (node1:Node)
.output winning ()

move("1","2").
move("2","3").
move("3","4").
move("1","3").
move("1","5").

canMove(X):- move(X,_).

possible_winning(X):- odd_move(X,Y), !canMove(Y).

winning(X):- move(X,Y), !possible_winning(Y).

odd_move(X,Y) :- move(X,Y).

odd_move(X,Y) :- move(X,Z1), move(Z1,Z2), odd_move(Z2,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====

