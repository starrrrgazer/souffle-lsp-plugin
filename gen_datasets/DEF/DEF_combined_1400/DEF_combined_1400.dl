// Type Node
.type Node <: symbol

//
// Edges non circular
//

.decl Edge        (n:Node, m:Node, w:number)

Edge("0","1",3).
Edge("1","2",5).
Edge("2","3",1).
Edge("1","4",-6).
Edge("4","2",-1).

//
// Reachable
//

.decl Reachable   (n:Node, m:Node, i:number)
.output Reachable   ()

Reachable(x,y,r)  :- r=w, Edge(x,y,w).
Reachable(x,y,d+w)  :- Edge(x,z,w), Reachable(z,y,d).


.decl ShortestDuplicates(n:Node, m:Node, i:number)
.output ShortestDuplicates()

ShortestDuplicates(x,y,a) :- Reachable(x,y,a), Reachable(x,y,b), a<b.

// ==== END: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the highest in and out degree nodes in the graph
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

.decl HighestOutDegree(d:number)
.output HighestOutDegree()
HighestOutDegree(d) :- OutDegree(_, _), d = max D : OutDegree(_, D).

.decl HighestInDegree(d:number)
.output HighestInDegree()
HighestInDegree(d) :- InDegree(_, _), d = max D : InDegree(_, D).


// ==== END: d:\work24\souffle-lsp-plugin\example\highest_degree\highest_degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights\flights.dl ====

.type Node <: symbol
.decl flight      (node1:Node, node2:Node, node3:Node)
.decl QAflies   (node1:Node, node2:Node)
.output QAflies   ()
.decl VAflies   (node1:Node, node2:Node)
.output VAflies   ()
.decl QAonly   (node1:Node, node2:Node)
.output QAonly   ()

QAflies(X,Y) :- flight("QA",X,Y).
QAflies(X,Y) :- flight("QA",X,Z), QAflies(Z,Y).

VAflies(X,Y) :- flight("VA",X,Y).
VAflies(X,Y) :- flight("VA",X,Z), VAflies(Z,Y).

QAonly(X,Y)  :- QAflies(X,Y), ! VAflies(X,Y).

flight("QA","AU","CHI").
flight("QA","AU","JPN").
flight("QA","JPN","DEN").
flight("QA","JPN","CHI").
flight("QA","AU","CHI").
flight("VA","AU","CHI").
flight("VA","JPN","ZA").
flight("VA","JPN","DEN").
flight("VA","DEN","ZA").

