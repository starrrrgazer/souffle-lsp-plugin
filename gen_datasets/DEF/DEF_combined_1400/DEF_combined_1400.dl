// The Lehigh University Benchmark (LUBM)
// http://swat.cse.lehigh.edu/projects/lubm/
// ported by Anthony Potter
//
// Unary relations
.decl University (a:symbol)
.output University ()
.input University ()
.decl Person (a:symbol)
.output Person ()
.decl Employee (a:symbol)
.output Employee ()
.decl Faculty (a:symbol)
.output Faculty ()
.decl Professor (a:symbol)
.output Professor ()
.decl Course (a:symbol)
.output Course ()
.input Course ()
.decl AssociateProfessor (a:symbol)
.input AssociateProfessor ()
.decl AssistantProfessor (a:symbol)
.input AssistantProfessor ()
.decl Organization (a:symbol)
.output Organization ()
.decl Chair (a:symbol)
.output Chair ()
.decl Work (a:symbol)
.output Work ()
.decl Lecturer (a:symbol)
.output Lecturer ()
.input Lecturer ()
.decl Student (a:symbol)
.output Student ()
.decl GraduateStudent (a:symbol)
.input GraduateStudent ()
.decl ResearchAssistant (a:symbol)
.input ResearchAssistant ()
.decl GraduateCourse (a:symbol)
.input GraduateCourse ()
.decl UndergraduateStudent (a:symbol)
.input UndergraduateStudent ()
.decl ResearchGroup (a:symbol)
.output ResearchGroup ()
.input ResearchGroup ()
.decl Publication (a:symbol)
.output Publication ()
.input Publication ()
.decl TeachingAssistant (a:symbol)
.output TeachingAssistant ()
.input TeachingAssistant ()
.decl FullProfessor (a:symbol)
.input FullProfessor ()
.decl Department (a:symbol)
.input Department ()

// Binary relations
.decl hasAlumnus (a:symbol, b:symbol)
.output hasAlumnus ()
.decl degreeFrom (a:symbol, b:symbol)
.output degreeFrom ()
.decl member (a:symbol, b:symbol)
.output member ()
.decl teachingAssistantOf (a:symbol, b:symbol)
.input teachingAssistantOf ()
.decl headOf (a:symbol, b:symbol)
.input headOf ()
.decl teacherOf (a:symbol, b:symbol)
.input teacherOf ()
.decl publicationAuthor (a:symbol, b:symbol)
.input publicationAuthor ()
.decl doctoralDegreeFrom (a:symbol, b:symbol)
.input doctoralDegreeFrom ()
.decl undergraduateDegreeFrom (a:symbol, b:symbol)
.input undergraduateDegreeFrom ()
.decl mastersDegreeFrom (a:symbol, b:symbol)
.input mastersDegreeFrom ()
.decl subOrganizationOf (a:symbol, b:symbol)
.output subOrganizationOf ()
.input subOrganizationOf ()
.decl takesCourse (a:symbol, b:symbol)
.input takesCourse ()
.decl worksFor (a:symbol, b:symbol)
.output worksFor ()
.input worksFor ()
.decl memberOf (a:symbol, b:symbol)
.output memberOf ()
.input memberOf ()
.decl advisor (a:symbol, b:symbol)
.input advisor ()
.decl emailAddress (a:symbol, b:symbol)
.input emailAddress ()
.decl telephone (a:symbol, b:symbol)
.input telephone ()
.decl name (a:symbol, b:symbol)
.input name ()
.decl researchInterest (a:symbol, b:symbol)
.input researchInterest ()

// Ontology
University(Y) :- mastersDegreeFrom(_,Y) .
degreeFrom(X,Y) :- hasAlumnus(Y,X) .
hasAlumnus(X,Y) :- degreeFrom(Y,X) .
Employee(X) :- Faculty(X) .
Faculty(X) :- Professor(X) .
Professor(X) :- AssociateProfessor(X) .
Person(Y) :- member(_,Y) .
Professor(X) :- AssistantProfessor(X) .
Professor(X) :- Chair(X) .
worksFor(X,Y) :- headOf(X,Y) .
Person(X) :- degreeFrom(X,_) .
University(Y) :- degreeFrom(_,Y) .
Person(Y) :- hasAlumnus(_,Y) .
TeachingAssistant(X) :- Person(X), teachingAssistantOf(X,Y), Course(Y) .
Chair(X) :- Person(X), headOf(X,Y), Department(Y) .
memberOf(X,Y) :- member(Y,X) .
member(X,Y) :- memberOf(Y,X) .
Course(Y) :- teacherOf(_,Y) .
University(X) :- hasAlumnus(X,_) .
Person(X) :- telephone(X,_) .
Organization(Y) :- subOrganizationOf(_,Y) .
memberOf(X,Y) :- worksFor(X,Y) .
Person(X) :- Employee(X) .
Person(X) :- advisor(X,_) .
Organization(X) :- member(X,_) .
Organization(X) :- Department(X) .
Faculty(X) :- Lecturer(X) .
Person(Y) :- publicationAuthor(_,Y) .
Professor(Y) :- advisor(_,Y) .
Work(X) :- Course(X) .
Professor(X) :- FullProfessor(X) .
degreeFrom(X,Y) :- doctoralDegreeFrom(X,Y) .
TeachingAssistant(X) :- teachingAssistantOf(X,_) .
Person(X) :- undergraduateDegreeFrom(X,_) .
Organization(X) :- University(X) .
Person(X) :- doctoralDegreeFrom(X,_) .
University(Y) :- doctoralDegreeFrom(_,Y) .
Course(Y) :- teachingAssistantOf(_,Y) .
University(Y) :- undergraduateDegreeFrom(_,Y) .
degreeFrom(X,Y) :- mastersDegreeFrom(X,Y) .
Person(X) :- GraduateStudent(X) .
Person(X) :- ResearchAssistant(X) .
Student(X) :- UndergraduateStudent(X) .
degreeFrom(X,Y) :- undergraduateDegreeFrom(X,Y) .
Publication(X) :- publicationAuthor(X,_) .
Person(X) :- mastersDegreeFrom(X,_) .
Organization(X) :- ResearchGroup(X) .
Faculty(X) :- teacherOf(X,_) .
Person(X) :- Chair(X) .
Employee(X) :- Person(X), worksFor(X,Y), Organization(Y) .
Course(X) :- GraduateCourse(X) .
Student(X) :- Person(X), takesCourse(X,Y), Course(Y) .
Person(X) :- TeachingAssistant(X) .
Organization(X) :- subOrganizationOf(X,_) .
Person(X) :- Student(X) .
Person(X) :- emailAddress(X,_) .
subOrganizationOf(X,Z) :- subOrganizationOf(X,Y), subOrganizationOf(Y,Z) .

// ==== END: d:\work24\souffle-lsp-plugin\example\lubm\lubm.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\access-policy\access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:\work24\souffle-lsp-plugin\example\access-policy\access-policy.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Var <: symbol

.decl conf(num : number)
conf(x+1) :- conf(x), !lim(x).
conf(0).

.decl lim(x : number)
.input lim()

.decl var_index(var : Var, index : number)
var_index("a", 0).
var_index("b", 1).
var_index("c", 2).

.decl translation(conf : number, var : Var, truthy : number)
translation(n, var, 1) :- var_index(var, k), conf(n), ((2^k) band n) != 0.
translation(n, var, 0) :- var_index(var, k), conf(n), ((2^k) band n) = 0.

.decl circuit_and(result: Var, op1: Var, op2: Var)
.input circuit_and()
.decl circuit_or(result: Var, op1: Var, op2: Var)
.input circuit_or()
.decl circuit_not(result: Var, op1: Var)
.input circuit_not()
.decl circuit_result(result: Var)
.input circuit_result()

.decl evaluate(conf: number, var: Var, truthy: number)
evaluate(conf, var, value) :-
 translation(conf, var, value).
evaluate(conf, var, v1 band v2) :-
 circuit_and(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, v1 bor v2) :-
 circuit_or(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, lnot v1) :-
 circuit_not(var, op1),
 evaluate(conf, op1, v1).

.decl satisfy(conf: number, var : Var)
.output satisfy()
satisfy(conf, inputvar) :-
 circuit_result(var),
 evaluate(conf, var, 1),
 var_index(inputvar, _),
 translation(conf, inputvar, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====

