// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()
.decl satellite (x:D,y:D)
.output satellite ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

satellite(X,Y) :-
  orbits(X,Y),
  !intermediate(X,Y),
  !star(Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).



// ==== END: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\func\func.dl ====
.type String <: symbol

.decl f(v:String, f:String)
.decl succ (v:String, f:String)
.decl arg (v:String, i:String, a:String)
.decl args (a:String, b:String, c:String)
.decl eq  (a:String, b:String)
.output eq  ()


succ("1", "2").
succ("2", "3").
succ("3", "4").

f("x", "g").
f("y", "f").

arg("x", "1", "A").
arg("x", "2", "B").
arg("x", "3", "Z").

arg("y", "1", "C").
arg("y", "2", "D").
arg("y", "3", "W").

eq(a, b) :- f(v, a), f(w, b), args(v, w, "3").

args(v, w, i) :- succ(p, i), arg(v, i, k), arg(w, i, k), args(v, w, p).
args(v, w, "1") :- arg(v, "1", _), arg(w, "1", _).

