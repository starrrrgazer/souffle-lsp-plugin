// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Path(source:symbol,destination:symbol,path:number)

Path(a,c,w) :-
  Edge(a,c,w).

Path(a,c,w1+w2) :-
  Path(a,b,w1),
  Edge(b,c,w2),
  h = sum w :Edge(_,_,w),
  (w1+w2) < h.

.decl ConnectedNodes(source:symbol,destination:symbol)

ConnectedNodes(a,b) :-
  Path(a,b,_).

.decl ShortestPath(source:symbol,destination:symbol,weight:number)

ShortestPath(a,b,w1) :-
  ConnectedNodes(a,b),
  w1 = min w2 : Path(a,b,w2).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath2\minpath2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Type Node
.type Node <: symbol

//
// Edges non circular
//

.decl Edge        (n:Node, m:Node, w:number)

Edge("0","1",3).
Edge("1","2",5).
Edge("2","3",1).
Edge("1","4",-6).
Edge("4","2",-1).

//
// Reachable
//

.decl Reachable   (n:Node, m:Node, i:number)
.output Reachable   ()

Reachable(x,y,r)  :- r=w, Edge(x,y,w).
Reachable(x,y,d+w)  :- Edge(x,z,w), Reachable(z,y,d).


.decl ShortestDuplicates(n:Node, m:Node, i:number)
.output ShortestDuplicates()

ShortestDuplicates(x,y,a) :- Reachable(x,y,a), Reachable(x,y,b), a<b.

// ==== END: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Find the perfect numbers that occur before the limit
//

.decl gen(x: number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//fc is factors of x, excluding itself
.decl e_factor(x : number, fc : number)
e_factor(x, fc) :- gen(fc), gen(x), x % fc = 0, x!=fc.

//x is equal to the sum of its factors excluding itself
.decl perfect(x : number)
.output perfect()
perfect(x) :- gen(x), x = sum inv : e_factor(x, inv).

// ==== END: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Subtracts the number of `-` from the number of `+`

.type index <: number
.type counter <: number
.type program <: symbol

.decl torun(p : program)
.input torun

.decl progress(i : index, c : counter, p : program)
progress(0,0,p) :- torun(p).
progress(i+1,c+1,p) :- progress(i,c,p), "+"=substr(p,i,1).
progress(i+1,c-1,p) :- progress(i,c,p), "-"=substr(p,i,1).
progress(i+1,c,p) :-
    progress(i,c,p),
    i < strlen(p),
    "+" != substr(p,i,1),
    "-" != substr(p,i,1).

.decl result(c : counter, p : program)
result(c,p) :- progress(strlen(p),c,p).
.output result

// ==== END: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa\dfa.dl ====
//
// Souffle - A Datalog Compiler
// Copyright (c) 2015, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Implements  the general data-flow analysis using the following equation:
//
// out[S] = gen[S] \/ (in[S] - kill[S])
//
// However, in Datalog we can only compute set unions as meet operations. If
// we have intersection, we need to go to its dual problem. We use the following equations
// for this purpose:
//
//  out[S] = U - d_out[S]
//
//  d_out[S] = d_gen[S] \/ (d_in[S] - d_kill[S])
//
//  d_gen[S] = kill[S] \ gen[S]
//
//  d_kill[S] = gen[S]
//
// This code also utilizes component composition to allow the direction of the analysis to be specified.
//



.comp Graph<Node>{

      //
      // input relations
      //

      //
      // Set of edges
      //
      .decl edge(src:Node,des:Node)


      //
      // Start node
      //
      .decl start(node:Node)


      //
      // intermediate relations
      //

      //
      // Set of nodes
      //
      .decl node(node:Node)
      node(node) :- edge(node,_).
      node(node) :- edge(_,node).

}


.comp Gen_Kill<Node,InfoLattice>{

      //
      // input relations
      //

      //
      // Gen function
      //
      .decl gen(node:Node,inf:InfoLattice)


      //
      // Kill function
      //
      .decl kill(node:Node,inf:InfoLattice)


      //
      // start node value
      //
      .decl startvalue(inf:InfoLattice)


      //
      // output relations
      //

      //
      // Out
      //
      .decl out(node:Node,inf:InfoLattice)

}




.comp Gen_Kill_Union<Node,InfoLattice>:  Gen_Kill<Node,InfoLattice>, Graph<Node>{

      //
      // input relations are inherited
      //


      //
      // output relations
      //

      //
      // Out
      //


      out(node,inf) :- gen(node,inf).
      out(node,inf) :- start(node),startvalue(inf).
      out(node,inf) :- out(pred,inf), edge(pred,node), !kill(node,inf).

}




.comp Gen_Kill_Intersection<Node,InfoLattice> : Gen_Kill<Node,InfoLattice>, Graph<Node>{

      //
      // input relations are inherited
      //


      //
      // reduce to gen kill union problem
      //

      .init   gen_kill_union = Gen_Kill_Union<Node,InfoLattice>

      gen_kill_union.start(n) :- start(n).

      gen_kill_union.edge(x,y) :- edge(x,y).

      gen_kill_union.gen(node,inf) :- kill(node,inf), !gen(node,inf).

      gen_kill_union.kill(node,inf) :- gen(node,inf).

      gen_kill_union.startvalue(inf) :- startvalue(inf).


      //
      // output relations
      //

      //
      //  out
      //

      out(node,inf) :- node(node), universe(inf), !gen_kill_union.out(node,inf).
}



.comp Gen_Kill_Union_Backward<Node,InfoLattice> : Gen_Kill<Node,InfoLattice>, Graph<Node>{

      //
      // input relations are inherited
      //


      //
      //  in
      //

      .init gen_kill_union = Gen_Kill_Union<Node,InfoLattice>

      gen_kill_union.start(node) :- start(node).

      gen_kill_union.edge(src,des) :- edge(des,src).

      gen_kill_union.gen(node,inf) :- gen(node,inf).

      gen_kill_union.kill(node,inf) :- kill(node,inf).

      gen_kill_union.startvalue(inf) :- startvalue(inf).


      //
      // output relations
      //

      //
      //  out
      //

      out(node,inf) :- gen_kill_union.out(node,inf).
}

.comp Gen_Kill_Intersection_Backward<Node,InfoLattice> : Gen_Kill<Node,InfoLattice>, Graph<Node>{


      //
      // input relations
      //


      .init gen_kill_intersection = Gen_Kill_Intersection<Node,InfoLattice>


      //
      //  in
      //

      gen_kill_intersection.start(node) :- start(node).

      gen_kill_intersection.edge(src,des) :- edge(des,src).

      gen_kill_intersection.gen(node,inf) :- gen(node,inf).

      gen_kill_intersection.kill(node,inf) :- kill(node,inf).

      gen_kill_intersection.startvalue(inf) :- startvalue(inf).


      //
      // output relations
      //

      //
      //  out
      //

      out(node,inf) :- gen_kill_intersection.out(node,inf).

}


//
// Set of Edge
//

.decl edge(x:number, y:number)
.input edge()

//
// Gen sets
//

.decl gen(x:number, i:symbol)
.input gen()

//
// Use sets
//

.decl use(x:number, i:symbol)
.input use()

//
// Kill sets
//

.decl kill(x:number, i:symbol)
.input kill()



//
// Universe  Lattice
//

.decl universe(inf:symbol)

universe(inf) :- gen(_,inf).
universe(inf) :- kill(_,inf).


//
// Instantiates data flow analysis  components and tests example 2.5 in
// "Data Flow Analysis" book authored by P.Khedker et al.
//

.init Available_Expressions = Gen_Kill_Intersection<number,symbol>

Available_Expressions.edge(x,y) :- edge(x,y).
Available_Expressions.gen(x,i) :- gen(x,i).
Available_Expressions.kill(x,i) :- kill(x,i).
Available_Expressions.startvalue(inf) :-  universe(inf),!kill(1,inf).
Available_Expressions.start(1).



.init Reaching_Definitions = Gen_Kill_Union<number,symbol>

Reaching_Definitions.edge(x,y) :- edge(x,y).
Reaching_Definitions.gen(x,i) :- gen(x,i).
Reaching_Definitions.kill(x,i) :- kill(x,i).
Reaching_Definitions.startvalue(i) :- gen(1,i), !kill(1,i).
Reaching_Definitions.start(1).




.init Live_Variables = Gen_Kill_Union_Backward<number,symbol>

Live_Variables.edge(x,y) :- edge(x,y).
Live_Variables.gen(x,i) :- use(x,i).
Live_Variables.kill(x,i) :- kill(x,i).
Live_Variables.startvalue(i) :- use(8,i), !kill(8,i).
Live_Variables.start(8).


//
// Output
//

.decl available_expressions(n:number, i:symbol)
.output available_expressions()
available_expressions(x,i) :- Available_Expressions.out(x,i).


.decl reaching_definitions(n:number, i:symbol)
.output reaching_definitions()
reaching_definitions(x,i) :- Reaching_Definitions.out(x,i).


.decl live_variables(n:number, i:symbol)
.output live_variables()
live_variables(x,i) :- Live_Variables.out(x,i).






// ==== END: d:\work24\souffle-lsp-plugin\example\dfa\dfa.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_path\shortest_path.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shortest paths between all nodes, the slow way
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find all paths
.decl Length   (n:Node, m:Node, l:number)
Length(x,y,t)  :- t=l, Edge(x,y,l).
Length(x,y,t+l)  :- Edge(x,z,l), Length(z,y,t).

// Filter out the longest path
.decl ShortestPath(n:Node, m:Node, l:number)
.output ShortestPath()
ShortestPath(x, y, a) :- Length(x, y, _), a = min Z : Length(x, y, Z).

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_path\shortest_path.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\input_output\input_output.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
