// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute a Lucas Sequence.

// Maximum sequence element.
.decl lim(l:number)
.input lim()

// Coefficients for the sequence.
.decl pq(p:number, q:number)
.input pq()

// Relation composing the i'th element of this sequence.
// Base cases given in the .facts file.
.decl lucas(i:number, n:number)
.output lucas()
.input lucas()

lucas(I+1, P*N - Q*M) :- lucas(I, N), lucas(I-1, M), pq(P, Q), !lim(I).

// ==== END: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(3,i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).
A(4,i) :- Check(a, b, _, d, _, _), In(a, b, _, d, _, _, i).
A(5,i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(6,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(7, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(8, i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(9, i) :- Check(_, b, _, _, _, _), In(_, b, _, _, _, _, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====

