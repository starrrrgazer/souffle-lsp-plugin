// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====
//
// Souffle - A Datalog Compiler
// Copyright (c) 2015, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// This code computes the dominance relation of a rooted directed graph
// given via its edge set.
//
// The dominance relation is defined as the least fixed-point of
// the following equations:
//   dom(start) := {start}
//   dom(n) := {n} \/ /\_{p in preds(n) dom(p),   for all n <> start
//
// To compute the fixed-point in Datalog, we are required to switch
// to union semantics, hence, the dual problem:
//   non-dom(start) := node-set \ {start}
//   non-dom(start) := node-set \ {n} /\ \/_{p in preds(n)}  non-dom(p), for all n <> start
//


// Additionally, this code computes the immediate dominators.
// The immediate dominator of a node n is the unique node that strictly dominates n but
// does not strictly dominate any other node that strictly dominates n. Every node,
// except the entry node, has an immediate dominator.
//
// We use subsumption to find the 'closest' dominator.
// Base case: immediate_dom(x, y) if y strictly domiantes x.
// Subsumption: for x's two immediate dominators y1 and y2, discard y1 if y2 is dominated by y1.
// This means y2 is lower in the path, hence 'closer' to x.



.comp Dominance<N>{

      //
      // Start node (singleton)
      //
      .decl start(s:N)

      //
      // Set of edges
      //
      .decl edge(s:N,d:N)

      //
      // Set of nodes
      //
      .decl node(n:N)
      node(x) :- edge(x,_).
      node(x) :- edge(_,x).

      //
      // Non-dominance of input graph
      //
      .decl non_dom(s:N,d:N)
      non_dom(x,y) :- start(x), node(y), x!=y.
      non_dom(x,y) :- non_dom(z,y), edge(z,x), !start(x), x!=y .


      //
      // Dominance of input graph
      //
      .decl dom(s:N,d:N)
      dom(x,y) :- node(x), node(y), !non_dom(x,y).

      //
      // Finds nodes that strictly dominate a node
      //
      .decl s_dom(n:N,d:N)
      s_dom(n,d) :- dom(n,d), n != d.

}


.comp ImmediateDominance<N> : Dominance<N>{

      //
      // Immediate Dominator
      //
      .decl imdom(n:N,i:N)
      imdom(n,x) :- s_dom(n,x).
      imdom(n,x1) <= imdom(n, x2) :- dom(x2, x1).

}

//
// The graph is taken from figure 9.38 in
// "Compilers Principles, Techniques and Tools" Edition 2
// by V.Aho et al.
//

.init ImmDom = ImmediateDominance<number>

ImmDom.edge(1, 2).
ImmDom.edge(1, 3).
ImmDom.edge(2, 3).
ImmDom.edge(4, 3).
ImmDom.edge(8, 3).
ImmDom.edge(3, 4).
ImmDom.edge(8, 4).
ImmDom.edge(4, 5).
ImmDom.edge(4, 6).
ImmDom.edge(5, 7).
ImmDom.edge(6, 7).
ImmDom.edge(10, 7).
ImmDom.edge(7, 8).
ImmDom.edge(8, 9).
ImmDom.edge(8, 10).
ImmDom.edge(9, 1).
ImmDom.start(1).


//
// Output
//

.decl dominators(n:number,s:number)
.output dominators()
dominators(n,s) :- ImmDom.dom(n,s).


//
// Output
//

.decl immediate_dom(n:number,s:number)
.output immediate_dom()
immediate_dom(n,s) :- ImmDom.imdom(n,s).



// ==== END: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\sort\sort.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Sorts a list of integers using quicksort
// Due to limitations of input format,
// repeated values in input are not supported

.type value <: number
.type index <: number

.type list = [
    head : value,
    tail : list
]

// Lists that must be sorted
.decl ToSort(start : list)

// Split a list into the values above and below the head value
// Input : Split(head:tail, tail, nil, nil)
// Output : Split(head:tail, nil, below, above)
.decl Split(start : list, notdone : list, below : list, above : list)
Split([p,l],l,nil,nil) :- ToSort([p,l]).
Split([p,l],t,[h,b],a) :- Split([p,l],[h,t],b,a), h < p.
Split([p,l],t,b,[h,a]) :- Split([p,l],[h,t],b,a), h >= p.

// Recursively sort the partitions
ToSort(l) :- Split(_,nil,l,_).
ToSort(l) :- Split(_,nil,_,l).

// Lists that need to be concatenated
.decl ToCat(a : list, b : list)
ToCat(t,b) :- ToCat([_,t],b).

// Result of concatenation
.decl Cat(a : list, b : list, c : list)
Cat(nil, b, b) :- ToCat(nil, b).
Cat([h,a], b, [h,c]) :- ToCat([h,a],b), Cat(a,b,c).

// Result of sorting
.decl Sorted(start : list, end : list)
Sorted(nil,nil).
Sorted([h,t],end) :-
    ToSort([h,t]),
    Split([h,t],nil,b,a),
    Sorted(a,s_a),
    Sorted(b,s_b),
    Cat(s_b,[h,s_a],end).

ToCat(s_b,[h,s_a]) :-
    Split([h,_],nil,b,a),
    Sorted(a,s_a),
    Sorted(b,s_b).

// -- Input -- //

// Collect values from file
.decl InputVals(x : value)
.input InputVals

// Assign each value a unique index; 0,1,2,...
.decl Indexed(x : value, i : index)
Indexed(x, autoinc()) :- InputVals(x).

// Build the list
.decl InList(l : list, i : index)
InList(nil, m) :- m = min x: Indexed(_, x).
InList([h,t], i+1) :- InList(t, i), Indexed(h, i).

// Input the list to the sorting algorithm
ToSort(l) :- InList(l, m), m > max x: Indexed(_, x).

// -- Output -- //

// Get the sorted list from the sorting algorithm
.decl Result(l : list)
Result(s) :- Sorted(l,s), InList(l,m), m > max x: Indexed(_, x).

// Convert a list to a string representation (only works once)
.decl ToString(l : list, s : symbol)
ToString(t, to_string(h)) :- Result([h,t]).
ToString(t, cat(cat(s, ", "), to_string(h))) :- ToString([h,t], s).

// Write output to file
.decl SortedVals(s : symbol)
SortedVals(s) :- ToString(nil, s).
.output SortedVals

// ==== END: d:\work24\souffle-lsp-plugin\example\sort\sort.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(3,i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).
A(4,i) :- Check(a, b, _, d, _, _), In(a, b, _, d, _, _, i).
A(5,i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(6,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(7, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(8, i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(9, i) :- Check(_, b, _, _, _, _), In(_, b, _, _, _, _, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Node <: symbol
.type Card <: number

.decl Edge			(m:Node, n:Node)
.input Edge

Edge(m, n) :- Edge(n, m).

.decl Leaf			(n:Node)
.decl NotLeaf		(n:Node)

NotLeaf(n) :- Edge(a, n), Edge(b, n), a != b.
Leaf(n) :- Edge(_, n), !NotLeaf(n).

.decl InSubtree		(m:Node, n:Node, a:Node)

InSubtree(m, n, n) :- Edge(m, n).
InSubtree(m, n, a) :- Edge(m, n), Edge(n, p), InSubtree(n, p, a), m != p.

.decl TreeCard		(c:Card)
.decl SubtreeCard	(m:Node, n:Node, c:Card)

TreeCard(a + b) :- a = sum 1 : Leaf(_), b = sum 1 : NotLeaf(_).

SubtreeCard(m, n, c) :- Edge(m, n), c = sum 1 : InSubtree(m, n, _).

.decl Centroid		(n:Node)
.decl NotCentroid	(n:Node)

NotCentroid(n) :- TreeCard(c), SubtreeCard(n, _, d), d > c/2.
Centroid(n) :- Edge(n, _), !NotCentroid(n).

.output Centroid

// ==== END: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====

