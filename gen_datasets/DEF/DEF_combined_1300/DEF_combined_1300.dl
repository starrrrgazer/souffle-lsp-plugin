.type Text <: symbol

.decl Movie(id:number,title:Text,rating:Text)
.decl MovieActors(movieid:number,actorsid:number)
.decl Actors(actorid:number,name:Text)

Movie(1,"Movie a","2.3/10").
Movie(2,"Movie b","9.3/10").
Movie(3,"Movie c","8.6/10").

MovieActors(1,1).
MovieActors(1,2).
MovieActors(1,3).
MovieActors(2,2).
MovieActors(2,3).
MovieActors(2,4).
MovieActors(3,1).
MovieActors(3,4).

Actors(1,"John Smith").
Actors(2,"Joe Bloggs").
Actors(3,"Francesca Allsworth").
Actors(4,"Julia Thebest").



.decl MovieActorsText(title:Text, actorname:Text)
.output MovieActorsText()

MovieActorsText(c,d) :- MovieActors(a,b), Movie(a,c,_), Actors(b,d).

.decl JoeBloggsMovies(title:Text)
.output JoeBloggsMovies()

JoeBloggsMovies(a) :- MovieActorsText(a, b), match("Joe Bloggs", b).

.decl ActorsRatings(name:Text, rating:Text)
.output ActorsRatings()

ActorsRatings(a,rating) :- MovieActorsText(movie,a), Movie(_,movie_b,rating), match(movie, movie_b).

// ==== END: d:\work24\souffle-lsp-plugin\example\movies\movies.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_edges\shortest_edges.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shortest outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl ShortestEdgeFromN(n:Node, l:number)
.output ShortestEdgeFromN()

ShortestEdgeFromN(x, l) :- Edge(x, _, _), l = min Z : Edge(x, _, Z).

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_edges\shortest_edges.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Text <: symbol

.decl food(name:Text, carbs:number, fat:number, protein:number, per:number, measure:Text)
.input food()

.decl recipe(index: number, name:Text, amount: number, measure: Text)
.input recipe()

.decl max_index(result:number)
.output max_index()

max_index(a) :-  a = max a : recipe(a,_,_,_) .

.decl totals(name:Text, amount:number, carbs:number, fat:number, protein:number, cal:number)
.output totals()

totals(name, amount, amount*a/per, amount*b/per, amount*c/per, ((4*amount*a/per)+(9*amount*b/per)+(4*amount*c/per))) :- recipe(_, name, amount, _), food(name, a,b,c,per,_).


.decl calories(result:number)
.output calories()

calories(result) :- result = sum a : totals(_,_,_,_,_,a).

// ==== END: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rsg\rsg.dl ====
.type Node <: symbol

.decl RSG (node1:Node, node2:Node)
.output RSG ()
.decl FLAT(node1:Node, node2:Node)
.output FLAT()
.decl UP  (node1:Node, node2:Node)
.output UP  ()
.decl DOWN(node1:Node, node2:Node)
.output DOWN()

RSG(x,y) :- FLAT(x,y).
RSG(x,y) :- UP(x, a), RSG(b, a), DOWN(b, y).

UP("a","e").
UP("a","f").
UP("f","m").
UP("g","n").
UP("h","n").
UP("i","o").
UP("j","o").

FLAT("g","f").
FLAT("m","n").
FLAT("m","o").
FLAT("p","m").

DOWN("l","f").
DOWN("m","f").
DOWN("g","b").
DOWN("h","c").
DOWN("i","d").
DOWN("p","k").

