// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shorted outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
.output OutDegree()

OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
.output InDegree()

InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

// ==== END: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#include "grid.dl"

// Minesweeper
// Generates minesweeper boards, a cell containing a mine takes the value -1, while all other cells take the value of the number of mines in their local neighbourhood (i.e. in the eight cells to which they are adjacent.

// A mine count for a given cell is valid if it is between 0 and 8 inclusive.
.decl is_valid(x:number)
is_valid(0).
is_valid(x+1) :- is_valid(x), x < 8.

// The cells of the game board, taking the value -1 if the backing grid contains a value for the cell at the specified row and column, of the number of surrounding mines otherwise.
.decl cell(row:number, column:number, variable:number)
.output cell()
cell(i, j, -1) :- x != 0, element(i, j, x).
cell(i, j, x) :-
  x = tl + tc + tr + ml + mr + bl + bc + br,
  is_valid(x),
  neighbourhood(i, j, tl, tc, tr, ml, 0, mr, bl, bc, br).



// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

.type Node <: symbol

.decl father      (node1:Node, node2:Node)
.decl mother      (node1:Node, node2:Node)
.decl parent      (node1:Node, node2:Node)
.output parent      ()
.decl ancestor    (node1:Node, node2:Node)
.output ancestor    ()
.decl grandmother (node1:Node, node2:Node)
.output grandmother ()
.decl sibling      (node1:Node, node2:Node)
.output sibling      ()
.decl cousin       (node1:Node, node2:Node)
.output cousin       ()
.decl relative       (node1:Node, node2:Node)
.output relative       ()

parent(X,Y) :- father(X,Y).
parent(X,Y) :- mother(X,Y).

ancestor(X,Y) :- parent(X,Y).
ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y).

grandmother(X,Y) :- mother(X,Z), ancestor(Z,Y).

sibling(X,Y) :- parent(Z,X), parent(Z,Y), X != Y.

cousin(X,Y) :- ancestor(Z,X), ancestor(Z,Y), X != Y, !sibling(X,Y), !parent(X,Y).

relative(X,Y) :- sibling(X,Z),parent(Z,Y).

father("tom","amy").
father("tom","adam").
father("jack","fred").
father("tony","carolII").
father("fred","carolIII").
mother("graceI","amy").
mother("amy","fred").
mother("carolI","carolII").
mother("carolII","carolIII").

// ==== END: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

