// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====
// Stratifiable two-people game
// Equivalent to the nonstratifiable:
// winning(X) :- move(X,Y), not(winning(X)).
// April, 2011
// Adopted from DES

.type Node <: symbol

.decl move (node1:Node, node2:Node)
.output move ()
.decl odd_move (node1:Node, node2:Node)
.output odd_move ()
.decl canMove (node1:Node)
.output canMove ()
.decl possible_winning (node1:Node)
.output possible_winning ()
.decl winning (node1:Node)
.output winning ()

move("1","2").
move("2","3").
move("3","4").
move("1","3").
move("1","5").

canMove(X):- move(X,_).

possible_winning(X):- odd_move(X,Y), !canMove(Y).

winning(X):- move(X,Y), !possible_winning(Y).

odd_move(X,Y) :- move(X,Y).

odd_move(X,Y) :- move(X,Z1), move(Z1,Z2), odd_move(Z2,Y).

// ==== END: d:\work24\souffle-lsp-plugin\example\game2\game2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-multilvl\comp-parametrized-multilvl.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt



.comp NumGenerator {
    .decl R(n:number)
}

.comp LotsOfNumGenerator : NumGenerator {
    R(0).
    R(n+1) :- R(n), n <= 10.
}

.comp BiggerNumGenerator : LotsOfNumGenerator {
    R(22).
}

.comp NumSelector<T> {
    .init generator = T
    .decl Selected(n: number)
    Selected(n) :- generator.R(n), generator.R(n*2).
}

.comp GoodNumSelector<T> : NumSelector<T> {
    Selected(42).
}

.comp Main<TSelector, TGenerator> {
    .init selector = TSelector<TGenerator>
    .decl Out(n:number)
.output Out()
    Out(x) :- selector.Selected(x).
}

.init main1 = Main<NumSelector, LotsOfNumGenerator>
.init main2 = Main<GoodNumSelector, LotsOfNumGenerator> // selects 42, even if it is not generated
.init main3 = Main<NumSelector, BiggerNumGenerator> // selects 22 = 2*11


// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-multilvl\comp-parametrized-multilvl.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

