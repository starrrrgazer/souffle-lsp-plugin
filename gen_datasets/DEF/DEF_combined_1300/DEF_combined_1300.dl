// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

.type Node <: symbol

.decl father      (node1:Node, node2:Node)
.decl mother      (node1:Node, node2:Node)
.decl parent      (node1:Node, node2:Node)
.output parent      ()
.decl ancestor    (node1:Node, node2:Node)
.output ancestor    ()
.decl grandmother (node1:Node, node2:Node)
.output grandmother ()
.decl sibling      (node1:Node, node2:Node)
.output sibling      ()
.decl cousin       (node1:Node, node2:Node)
.output cousin       ()
.decl relative       (node1:Node, node2:Node)
.output relative       ()

parent(X,Y) :- father(X,Y).
parent(X,Y) :- mother(X,Y).

ancestor(X,Y) :- parent(X,Y).
ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y).

grandmother(X,Y) :- mother(X,Z), ancestor(Z,Y).

sibling(X,Y) :- parent(Z,X), parent(Z,Y), X != Y.

cousin(X,Y) :- ancestor(Z,X), ancestor(Z,Y), X != Y, !sibling(X,Y), !parent(X,Y).

relative(X,Y) :- sibling(X,Z),parent(Z,Y).

father("tom","amy").
father("tom","adam").
father("jack","fred").
father("tony","carolII").
father("fred","carolIII").
mother("graceI","amy").
mother("amy","fred").
mother("carolI","carolII").
mother("carolII","carolIII").

// ==== END: d:\work24\souffle-lsp-plugin\example\family\family.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\metro\metro.dl ====
.type Node <: symbol

.decl link(node1:Node, node2:Node, node3:Node)
.decl St_Reachable(node1:Node, node2:Node)
.decl Li_Reachable(node1:Node, node2:Node)
.decl platform2_reach(node1:Node, node2:Node)
.output platform2_reach()


St_Reachable(x, y) :- link(_,x,y).
St_Reachable(x, y) :- St_Reachable(x, z), link(_, z, y).
Li_Reachable(x, u) :- St_Reachable(x, z), link(u, z, _).

platform2_reach("platform2", y) :- St_Reachable("platform2", y), link(_, _, y).

link("4","platform1","platform2").
link("4","platform2","platform3").
link("4","platform3","platform4").
link("1","platform4","platform5").
link("1","platform5","platform6").
link("1","platform7","platform8").
link("9","platform8","platform9").
link("9","platform9","platform10").

