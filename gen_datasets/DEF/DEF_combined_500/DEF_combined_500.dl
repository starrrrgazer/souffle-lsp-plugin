// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Simulates a Deterministic Finite Automata to parse strings

.type state <: symbol
.type string <: symbol
.type index <: number

.decl transition(from : state, on : string, to : state)
.input transition

.decl accepting(x : state)
.input accepting

.decl start(x : state)
.input start

.decl toparse(x : string)
.input toparse

// When parsing `in` we have processed `i` characters and are at state `cur`
.decl parse(in : string, cur : state, i : index)
parse(in,cur,0) :- toparse(in), start(cur).
parse(in,new,i+j) :-
    parse(in,old,i),
    transition(old,diff,new),
    j=strlen(diff),
    diff=substr(in,i,j).
// The rule above can cause the AST translator to fail in old versions of Souffle

.decl accept(in : string)
accept(in) :- parse(in,cur,strlen(in)), accepting(cur).

.decl out(s : string, result : symbol)
out(s, "Accept") :- accept(s).
out(s, "Reject") :- toparse(s), !accept(s).
.output out

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\independent_body3\independent_body3.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Tests rules containing body literals that are independent of the
// head arguments (i.e. they are 'constant' wrt. head arguments).

.decl a(x:number)
a(x) :- b(x), c(y), d(y).

.decl b(x:number)
b(0).
b(x+1) :- a(x), x < 1000000.

.decl c(x:number)
c(0).
c(x+2) :- c(x), x < 1000.

.decl d(x:number)
d(0).
d(x+3) :- d(x), x < 1000.

.decl query(x:number)
.output query()
query(x) :- a(x), x < 10.

// ==== END: d:\work24\souffle-lsp-plugin\example\independent_body3\independent_body3.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\turing1\turing1.dl ====
// Implementation of a Turing Maching in Souffle

.type Alphabet <: symbol
.type State <: symbol
.type Direction <: symbol

//
// Tape of the Turing Machine
//
// A triple (pos, symbol, step) enumerates all symbols of the
// tape at the i-th position in the j-th computational step.
//

.decl Tape(position:number, symbol:Alphabet, step:number)
.output Tape()

// write new symbol from a successful transition.
Tape(position, newSymbol, step + 1) :-
   Tape(position, oldSymbol, step),
   Configuration(position, currentState, step),
   Transition(currentState, _, oldSymbol, newSymbol, _).

// copy tape symbol from previous step at previously written
// position, if not altered by current state transition.
Tape(position, symbol, step + 1) :-
   Tape(position, symbol, step),
   Configuration(writePosition, _, step),
   position != writePosition.

// add blank symbol to the left of the tape, if the position has not been
// written before.
Tape(position, "b", step + 1) :-
   Configuration(position, _, step + 1),
   TapeLimits(step, left, _),
   position < left.

// add blank symbol to the right of the tape, if the position
// has not been written before.
Tape(position, "b", step + 1) :-
   Configuration(position, _, step + 1),
   TapeLimits(step, _, right),
   position > right.

//
// Configuration of the Turing Machine
//
// The configuration defines the current tape position,
// the current state, and the computational step.
//

.decl Configuration(position: number, state:State, step:number)
.output Configuration()

Configuration(position - 1, nextState, step + 1) :-
   Tape(position, oldSymbol, step),
   Configuration(position, currentState, step),
   Transition(currentState, nextState, oldSymbol, _, "L").

Configuration(position + 1, nextState, step + 1) :-
   Tape(position, oldSymbol, step),
   Configuration(position, currentState, step),
   Transition(currentState, nextState, oldSymbol, _, "R").

//
// TapeLimits of Turing Machine
//
// The left and right-most position already written positions
// on the tape. This relation is necessary for producing blank
// symbols for new positions on the tape.
//
.decl TapeLimits(step:number, left:number, right:number)
.output TapeLimits()

// tape limit has not changed
TapeLimits(step + 1, left, right) :-
   TapeLimits(step, left, right),
   Configuration(position, _, step + 1),
   left <= position,
   position <= right.

// tape limit has changed to the left
TapeLimits(step + 1, position, right) :-
   TapeLimits(step, left, right),
   Configuration(position, _, step + 1),
   position < left.

// tape limit has changed to the right
TapeLimits(step + 1, left, position) :-
   TapeLimits(step, left, right),
   Configuration(position, _, step + 1),
   right < position.

//
// Partial Transition Function of Turing Machine
//
// Defines the transition from one state to another,
// the symbols that is necesary to transit, the new symbol that
// is written, and in which direction the turing machine is moving.
// Note that the turing machine stops if no new state can be found.
//

.decl Transition(src:State, dest:State, read:Alphabet, write:Alphabet, d:Direction)

Transition("S0", "S0", "x", "y", "R").
Transition("S0", "S1", "y", "x", "L").
Transition("S1", "S1", "y", "x", "L").

//
// Initial State of the tape
//

// Tape: 001

Tape(0, "x", 0). // first position on tape set to symbol "x"
Tape(1, "x", 0). // second position on tape set to symbol "x"
Tape(2, "y", 0). // third position on tape set to symbol "y"

// Limits of tape for initial state
TapeLimits(0, 0, 2).

// Initial configuration of turing machine
Configuration(0, "S0", 0).

// ==== END: d:\work24\souffle-lsp-plugin\example\turing1\turing1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Var <: symbol

.decl conf(num : number)
conf(x+1) :- conf(x), !lim(x).
conf(0).

.decl lim(x : number)
.input lim()

.decl var_index(var : Var, index : number)
var_index("a", 0).
var_index("b", 1).
var_index("c", 2).

.decl translation(conf : number, var : Var, truthy : number)
translation(n, var, 1) :- var_index(var, k), conf(n), ((2^k) band n) != 0.
translation(n, var, 0) :- var_index(var, k), conf(n), ((2^k) band n) = 0.

.decl circuit_and(result: Var, op1: Var, op2: Var)
.input circuit_and()
.decl circuit_or(result: Var, op1: Var, op2: Var)
.input circuit_or()
.decl circuit_not(result: Var, op1: Var)
.input circuit_not()
.decl circuit_result(result: Var)
.input circuit_result()

.decl evaluate(conf: number, var: Var, truthy: number)
evaluate(conf, var, value) :-
 translation(conf, var, value).
evaluate(conf, var, v1 band v2) :-
 circuit_and(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, v1 bor v2) :-
 circuit_or(var, op1, op2),
 evaluate(conf, op1, v1),
 evaluate(conf, op2, v2).
evaluate(conf, var, lnot v1) :-
 circuit_not(var, op1),
 evaluate(conf, op1, v1).

.decl satisfy(conf: number, var : Var)
.output satisfy()
satisfy(conf, inputvar) :-
 circuit_result(var),
 evaluate(conf, var, 1),
 var_index(inputvar, _),
 translation(conf, inputvar, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\circuit_sat\circuit_sat.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#include "grid.dl"

// Minesweeper
// Generates minesweeper boards, a cell containing a mine takes the value -1, while all other cells take the value of the number of mines in their local neighbourhood (i.e. in the eight cells to which they are adjacent.

// A mine count for a given cell is valid if it is between 0 and 8 inclusive.
.decl is_valid(x:number)
is_valid(0).
is_valid(x+1) :- is_valid(x), x < 8.

// The cells of the game board, taking the value -1 if the backing grid contains a value for the cell at the specified row and column, of the number of surrounding mines otherwise.
.decl cell(row:number, column:number, variable:number)
.output cell()
cell(i, j, -1) :- x != 0, element(i, j, x).
cell(i, j, x) :-
  x = tl + tc + tr + ml + mr + bl + bc + br,
  is_valid(x),
  neighbourhood(i, j, tl, tc, tr, ml, 0, mr, bl, bc, br).



// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\paths\paths.dl ====
// Adopted from DES
// Paths in a Graph
//
// Datalog Formulation

.type Node <: symbol

.decl path   (node1:Node, node2:Node)
.output path   ()
.decl edge   (node1:Node, node2:Node)
.output edge   ()

edge("a","b").
edge("a","c").
edge("b","a").
edge("b","d").

path(X,Y) :- path(X,Z), edge(Z,Y).
path(X,Y) :- edge(X,Y).


// ==== END: d:\work24\souffle-lsp-plugin\example\paths\paths.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp Impl {
    .decl R(x: number)
    R(0). R(1). R(2).
}

.comp A<T> {
    .init impl = T
    .decl Base(x: number)
    Base(x) :- impl.R(x).
}

.comp Derived<K> : A<K> {
    .decl Deriv(x:number)
    Deriv(42).
    Deriv(n) :- Base(n).
}

.init d = Derived<Impl>
.init a = A<Impl>

.decl DerivedOut(x: number)
.output DerivedOut()
.decl AOut(x: number)
.output AOut()

DerivedOut(x) :- d.Deriv(x).
AOut(x) :- a.Base(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized-inherit\comp-parametrized-inherit.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\2sat\2sat.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Var <: symbol
.type Neg <: symbol
.type Val <: symbol
.type Card <: number
.type Ans <: symbol

.decl Clause		(m:Neg, u:Var, n:Neg, v:Var)
.input Clause

.decl Not			(m:Neg, n:Neg)

Not("Pos", "Neg").
Not("Neg", "Pos").

.decl Impl			(m:Neg, u:Var, n:Neg, v:Var)

// Translate clauses into implications, (x V y) becomes (not x => y) and (not y => x)
Impl(m, u, n, v) :- Not(m, p), Clause(p, u, n, v).
Impl(m, u, n, v) :- Not(m, p), Clause(n, v, p, u).

// Closure under transitivity of implication
Impl(m, u, n, v) :- Impl(m, u, p, w), Impl(p, w, n, v).

.decl Incon			(u:Var)

// Any inconsistencies?
Incon(u) :- Impl("Pos", u, "Neg", u), Impl("Neg", u, "Pos", u).

.decl Satisfiable	(s:Ans)

Satisfiable("Yes") :- !Incon(_).
Satisfiable("No") :- Incon(_).

.output Satisfiable

// ==== END: d:\work24\souffle-lsp-plugin\example\2sat\2sat.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\earley\earley.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Label <: number

.type NT <: symbol
.type Letter <: symbol
.type Symbol = NT | Letter

.type Pos <: number

// Head stored in position 0 of prod
.decl Prod				(x:Label, p:Pos, s:Symbol)
.decl String			(c:Pos, a:Letter)
.input Prod
.input String

.decl EndProd			(x:Label, p:Pos)
.decl EndString			(c:Pos)

.decl NotEndProd		(x:Label, p:Pos)
.decl NotEndString		(c:Pos)

NotEndProd(x, p) :- Prod(x, p, _), Prod(x, q, _), p < q.
EndProd(x, p + 1) :- Prod(x, p, _), !NotEndProd(x, p).

NotEndString(c) :- String(c, _), String(d, _), c < d.
EndString(c + 1) :- String(c, _), !NotEndString(c).

// Adapted from Earley parser - Wikipedia

// Current parse position in the string is c, production x has been matched
// up to position p in the body starting at position j in the input string.
.decl State			(c:Pos, x:Label, p:Pos, j:Pos)

// Initialization: at input position 1, production 1 has matched 0 symbols from origin 1.
State(1, 1, 1, 1).

// Prediction
State(c, x, 1, c) :- State(c, y, p, _), Prod(x, 0, n), Prod(y, p, n).

// Scanning
State(c + 1, x, p + 1, j) :- String(c, a), State(c, x, p, j), Prod(x, p, a).

// Completion
State(c, x, p + 1, j) :- State(c, y, q, k), EndProd(y, q), Prod(y, 0, n), State(k, x, p, j), Prod(x, p, n).

.type Answer <: symbol
.decl Accept			(s:Answer)

Accept("Yes") :- State(c, 1, q, 1), EndString(c), EndProd(1, q).
.output Accept

// ==== END: d:\work24\souffle-lsp-plugin\example\earley\earley.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tree\tree.dl ====

.type Node <: symbol

.decl S      (node1:Node, node2:Node)
.output S      ()
.decl T      (node1:Node, node2:Node)
.output T      ()
.decl R      (node1:Node, node2:Node, node3:Node)

S (x1, x3) :- T(x1, x2), R(x2, _, x3).
T (x1, x4) :- R(x1, _, x2), R(x2, _, x3), T(x3, x4).
T (x1, x3) :- R(x1, a, x2), R(x2, a, x3).


R("1", "a", "2").
R("2", "b", "3").
R("3", "a", "4").
R("4", "a", "5").
R("5", "a", "6").

