#include "grid.dl"

// Minesweeper
// Generates minesweeper boards, a cell containing a mine takes the value -1, while all other cells take the value of the number of mines in their local neighbourhood (i.e. in the eight cells to which they are adjacent.

// A mine count for a given cell is valid if it is between 0 and 8 inclusive.
.decl is_valid(x:number)
is_valid(0).
is_valid(x+1) :- is_valid(x), x < 8.

// The cells of the game board, taking the value -1 if the backing grid contains a value for the cell at the specified row and column, of the number of surrounding mines otherwise.
.decl cell(row:number, column:number, variable:number)
.output cell()
cell(i, j, -1) :- x != 0, element(i, j, x).
cell(i, j, x) :-
  x = tl + tc + tr + ml + mr + bl + bc + br,
  is_valid(x),
  neighbourhood(i, j, tl, tc, tr, ml, 0, mr, bl, bc, br).



// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Find the perfect numbers that occur before the limit
//

.decl gen(x: number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//fc is factors of x, excluding itself
.decl e_factor(x : number, fc : number)
e_factor(x, fc) :- gen(fc), gen(x), x % fc = 0, x!=fc.

//x is equal to the sum of its factors excluding itself
.decl perfect(x : number)
.output perfect()
perfect(x) :- gen(x), x = sum inv : e_factor(x, inv).

// ==== END: d:\work24\souffle-lsp-plugin\example\perfect_numbers\perfect_numbers.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\inline_nats\inline_nats.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Inlining is very effective here, as it avoids needing to compute the
// 10000^2 tuples for nat_pair.

.decl nat(x:number)
nat(0).
nat(x+1) :- x < 10000, nat(x).

.decl nat_pair(x:number, y:number) inline
nat_pair(x, y) :- nat(x), nat(y).

.decl query(x:number)
query(x) :- nat_pair(x, x), x < 2.

.output query()



// ==== END: d:\work24\souffle-lsp-plugin\example\inline_nats\inline_nats.dl ====

