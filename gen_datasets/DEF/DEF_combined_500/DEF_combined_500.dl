// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//triangle

.type Text <: symbol

.decl addrecurse(b:number, result:Text, level:number)

addrecurse(b,cat(cat("*",result),"*"),level+1) :- addrecurse(b,result,level), level!=b.

addrecurse(12,"*",0).


.decl out(result:Text)
.output out()

out(result) :- addrecurse(_,result,_).


// ==== END: d:\work24\souffle-lsp-plugin\example\triangle\triangle.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Mat1(row:number,column:number,value:number)

Mat1(1,1,2).
Mat1(1,2,4).
Mat1(2,1,3).
Mat1(2,2,5).

.output Mat1()


.decl Mat2(row:number,column:number, value:number)

Mat2(1,1,2).
Mat2(1,2,4).
Mat2(1,3,4).
Mat2(2,1,3).
Mat2(2,2,5).
Mat2(2,3,6).

.output Mat2()


.decl Product(i:number,j:number, k:number, value:number)

Product(i,j,k,value1*value2) :-
	Mat1(i,k,value1),Mat2(k,j,value2).


.decl Mat3(row:number,column:number, value:number)

Mat3(i,j, value) :-
	Mat1(i,_,_), Mat2(_,j,_), value = sum x : Product(i,j,_,x).

.output Mat3()


// ==== END: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

// some subsets
.decl A( x : number )
.decl B( x : number )
.decl C( x : number )
.decl D( x : number )
.decl E( x : number )


// A
A(0).

// B
B(1).
B(2).
B(3).

// C
C(4).
C(5).
C(6).

// D
D(3).
D(4).

// E
E(6).
E(7).

// the universe
.decl U( x : number )
.output U()
U(X) :- A(X) ; B(X) ; C(X) ; D(X); E(X) .

// an empty set
.decl N( x : number )
.output N()
N(X) :- A(X), B(X).


.decl R1( x : number )
.output R1()
R1(X) :- A(X) ; B(X) , D(X) .

.decl R2( x : number )
.output R2()
R2(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R3( x : number )
.output R3()
R3(X) :- U(X) , !( B(X) , D(X) ) .

.decl R4( x : number )
.output R4()
R4(X) :- U(X) , !( B(X) ; D(X) ) .

.decl R5( x : number )
.output R5()
R5(X) :- U(X) , !!!( B(X) ; D(X) ) .

.decl R6( x : number )
.output R6()
R6(X) :- (!B(X) ; D(X)) , U(X) .


// ==== END: d:\work24\souffle-lsp-plugin\example\dnf\dnf.dl ====

