// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====
//// Farmer-Wolf-Goat-Cabbage Puzzle
//// Adopted from DES

.type Node <: symbol

.decl safe  (node1:Node, node2:Node, node3:Node, node4:Node)
.output safe  ()
.decl state (node1:Node, node2:Node, node3:Node, node4:Node)
.output state ()
.decl opp   (node1:Node, node2:Node)
.output opp   ()

// Initial state
state("n","n","n","n").
// Farmer takes Wolf
state(X,X,U,V) :-
  safe(X,X,U,V),
  opp(X,X1),
  state(X1,X1,U,V).
// Farmer takes Goat
state(X,Y,X,V) :-
  safe(X,Y,X,V),
  opp(X,X1),
  state(X1,Y,X1,V).
// Farmer takes Cabbage
state(X,Y,U,X) :-
  safe(X,Y,U,X),
  opp(X,X1),
  state(X1,Y,U,X1).
// Farmer goes by himself
state(X,Y,U,V) :-
  safe(X,Y,U,V),
  opp(X,X1),
  state(X1,Y,U,V).

// Opposite shores (n/s)
opp("n","s").
opp("s","n").

// Farmer is with Goat

// TODO: This triggers segfault
// safe(X,Y,X,V) :- safe(X,_,X,_).

// Rewrite non-ground rule  'safe(X,Y,X,V)' to:
safe("n","s","n","s").
safe("n","n","n","n").
safe("n","s","n","n").
safe("n","n","n","s").
safe("s","s","s","s").
safe("s","n","s","n").
safe("s","s","s","n").
safe("s","n","s","s").

// Farmer is not with Goat
safe(X,X,X1,X) :- opp(X,X1).


// ==== END: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====
//
// An example computing all palendroms of a given length.
//

.type Letter <: symbol

.decl str(id:number, a:number, l:Letter, b:number)
.decl len(id:number, l:number)


//////////////////////////////////////////////////////////////////
//          index range          //
//////////////////////////////////////////////////////////////////

.decl p(x:number)

p(0).
p(x) :- str(_,_,_,x).




//////////////////////////////////////////////////////////////////
//          palindromes          //
//////////////////////////////////////////////////////////////////


.decl palin_aux(s:number, a:number, b:number)
palin_aux(s,x,x) :- str(s,_,_,_), p(x).
palin_aux(s,x,y) :- str(s,x,_,y).
palin_aux(s,x,y) :- str(s,x,a,t), palin_aux(s,t,r), str(s,r,a,y).

.decl palindrome(s:number)
.output palindrome()
palindrome(s) :- palin_aux(s,0,l), len(s,l).



//////////////////////////////////////////////////////////////////
//       words to be tested      //
//////////////////////////////////////////////////////////////////

// hello
str(0,0,"h",1).
str(0,1,"e",2).
str(0,2,"l",3).
str(0,3,"l",4).
str(0,4,"o",5).
len(0,5).


// racecar
str(1,0,"r",1).
str(1,1,"a",2).
str(1,2,"c",3).
str(1,3,"e",4).
str(1,4,"c",5).
str(1,5,"a",6).
str(1,6,"r",7).
len(1,7).


// noon
str(2,0,"n",1).
str(2,1,"o",2).
str(2,2,"o",3).
str(2,3,"n",4).
len(2,4).

// never odd or even
str(3,0,"n",1).
str(3,1,"e",2).
str(3,2,"v",3).
str(3,3,"e",4).
str(3,4,"r",5).
str(3,5,"o",6).
str(3,6,"d",7).
str(3,7,"d",8).
str(3,8,"o",9).
str(3,9,"r",10).
str(3,10,"e",11).
str(3,11,"v",12).
str(3,12,"e",13).
str(3,13,"n",14).
len(3,14).



