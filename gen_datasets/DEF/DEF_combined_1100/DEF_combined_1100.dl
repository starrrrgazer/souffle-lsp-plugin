// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\ranpo\ranpo.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, _, e, _), In(a, b, c, _, e, _, i).
A(3,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(4,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(5,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(6,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(7, i) :- Check(_,_, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(_, b, _, d, _, f), In(_, b, _, d, _, f, i).
A(9, i) :- Check(a, b, _, d, _, f), In(a, b, _, d, _, f, i).

// ==== END: d:\work24\souffle-lsp-plugin\example\ranpo\ranpo.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Mat1(row:number,column:number,value:number)

Mat1(1,1,2).
Mat1(1,2,4).
Mat1(2,1,3).
Mat1(2,2,5).

.output Mat1()


.decl Mat2(row:number,column:number, value:number)

Mat2(1,1,2).
Mat2(1,2,4).
Mat2(1,3,4).
Mat2(2,1,3).
Mat2(2,2,5).
Mat2(2,3,6).

.output Mat2()


.decl Product(i:number,j:number, k:number, value:number)

Product(i,j,k,value1*value2) :-
	Mat1(i,k,value1),Mat2(k,j,value2).


.decl Mat3(row:number,column:number, value:number)

Mat3(i,j, value) :-
	Mat1(i,_,_), Mat2(_,j,_), value = sum x : Product(i,j,_,x).

.output Mat3()


// ==== END: d:\work24\souffle-lsp-plugin\example\mmult\mmult.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\paths\paths.dl ====
// Adopted from DES
// Paths in a Graph
//
// Datalog Formulation

.type Node <: symbol

.decl path   (node1:Node, node2:Node)
.output path   ()
.decl edge   (node1:Node, node2:Node)
.output edge   ()

edge("a","b").
edge("a","c").
edge("b","a").
edge("b","d").

path(X,Y) :- path(X,Z), edge(Z,Y).
path(X,Y) :- edge(X,Y).


// ==== END: d:\work24\souffle-lsp-plugin\example\paths\paths.dl ====

