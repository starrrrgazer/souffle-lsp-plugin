// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute a Lucas Sequence.

// Maximum sequence element.
.decl lim(l:number)
.input lim()

// Coefficients for the sequence.
.decl pq(p:number, q:number)
.input pq()

// Relation composing the i'th element of this sequence.
// Base cases given in the .facts file.
.decl lucas(i:number, n:number)
.output lucas()
.input lucas()

lucas(I+1, P*N - Q*M) :- lucas(I, N), lucas(I-1, M), pq(P, Q), !lim(I).

// ==== END: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\tc\tc.dl ====
//// Reproduced from [FD92]
//// Adopted from DES

.type Node <: symbol

.decl tcl  (node1:Node, node2:Node)
.output tcl  ()
.decl tcr  (node1:Node, node2:Node)
.output tcr  ()
.decl base (node1:Node, node2:Node)
.output base ()
.input base ()
.decl tc (node1:Node, node2:Node)
.output tc ()

// Left-Recursive Transitive Closure
tcl(X, Y) :- base(X,Y).
tcl(X,Y) :- tcl(X,Z), base(Z,Y).

// Right-recursive Transitive Closure
tcr(X,Y) :- base(X,Y).
tcr(X,Y) :- base(X, Z),tcr(Z,Y).

// Double-recursive Transitive Closure
tc(X,Y) :- base(X,Y).
tc(X,Y) :- tc(X,Z),tc(Z,Y).

// base relation
base("a","b").
base("b","c").
base("c","d").

// ==== END: d:\work24\souffle-lsp-plugin\example\tc\tc.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

