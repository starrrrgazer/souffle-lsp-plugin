// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(5,i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(6,i) :- Check(a, b, c, d, e, _), In(a, b, c, d, e, _, i).

A(7, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(8, i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(9, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(10, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(11, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).

A(12, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(13, i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(14, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(15, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).

A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(18, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).

A(19, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po1\po1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type State <: number
.type Letter <: symbol

.decl Q				(q:State)
.decl Init			(q:State)
.decl Final			(q:State)
.decl Tr			(q:State, a:Letter, r:State)

.input Final
.input Tr

Init(0).

Q(q) :- Tr(q, _, _).

.decl Dis			(q:State, r:State)

Dis(q, r) :- Q(q), Q(r), Final(q), !Final(r).
Dis(q, r) :- Tr(q, a, s), Tr(r, a, t), Dis(s, t).
Dis(q, r) :- Dis(r, q).

.decl Equiv		(q:State, r:State)

Equiv(q, r) :- Q(q), Q(r), !Dis(q, r).

.decl NotMinEquiv	(q:State, r:State)
.decl MinEquiv		(q:State, r:State)

NotMinEquiv(q, r) :- Equiv(q, r), Equiv(q, s), s < r.
MinEquiv(q, r) :- Equiv(q, r), !NotMinEquiv(q, r).

.output MinEquiv

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights2\flights2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Airport <: symbol
.type Hour <: number
.type Route = [
	source : Airport,
	destination : Airport,
	start : Hour,
	duration : Hour
]

// List of flights
.decl flight(r : Route)
flight(["Sydney", "Melbourne", 8, 2]).
flight(["Sydney", "Melbourne", 20, 2]).
flight(["Sydney", "Singapore", 6, 10]).
flight(["Melbourne", "Auckland", 14, 4]).
flight(["Sydney", "Auckland", 12, 3]).
flight(["Singapore", "Tokyo", 21, 12]).
flight(["Singapore", "Dubai", 10, 11]).
flight(["Singapore", "London", 14, 14]).
flight(["Dubai", "London", 5, 6]).
flight(["London", "New York", 17, 15]).
flight(["London", "New York", 5, 15]).
flight(["London", "Oslo", 15, 3]).
flight(["London", "Paris", 10, 3]).
flight(["London", "Reykjavik", 8, 5]).
flight(["Oslo", "Reykjavik", 9, 4]).
flight(["Oslo", "Reykjavik", 21, 4]).
flight(["Los Angeles", "New York", 14, 5]).
flight(["Tokyo", "Los Angeles", 4, 14]).
flight(["Singapore", "Los Angeles", 9, 14]).
flight(["Singapore", "Los Angeles", 17, 14]).
flight(["Tokyo", "Vancouver", 12, 10]).
flight(["Singapore", "Vancouver", 18, 14]).
flight(["Los Angeles", "Vancouver", 5, 5]).

// Input starting airport and time
.decl travel(s : Airport, t : Hour)
.input travel()

// Find all connecting flights from starting airport
.decl connection(s : Airport, d : Airport, t : Hour, h : Hour)
.output connection()
connection(s, d, (t + h) % 24, (24 + t - tx) % 24 + h) :- travel(s, tx), flight([s, d, t, h]).
connection(s, d, (tx + h) % 24, hx + (24 + t - tx) % 24 + h) :- connection(s, x, tx, hx), flight([x, d, t, h]).

// Total time in hours to reach destination airport
.decl total_time(d : Airport, h : Hour)
.output total_time()
total_time(d, h) :- connection(s, d, _, _), h = min x : connection(s, d, _, x).

// ==== END: d:\work24\souffle-lsp-plugin\example\flights2\flights2.dl ====

