// Find the shorted outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
.output OutDegree()

OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
.output InDegree()

InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

// ==== END: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====
//
// Souffle - A Datalog Compiler
// Copyright (c) 2015, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// This code computes the dominance relation of a rooted directed graph
// given via its edge set.
//
// The dominance relation is defined as the least fixed-point of
// the following equations:
//   dom(start) := {start}
//   dom(n) := {n} \/ /\_{p in preds(n) dom(p),   for all n <> start
//
// To compute the fixed-point in Datalog, we are required to switch
// to union semantics, hence, the dual problem:
//   non-dom(start) := node-set \ {start}
//   non-dom(start) := node-set \ {n} /\ \/_{p in preds(n)}  non-dom(p), for all n <> start
//


// Additionally, this code computes the immediate dominators.
// The immediate dominator of a node n is the unique node that strictly dominates n but
// does not strictly dominate any other node that strictly dominates n. Every node,
// except the entry node, has an immediate dominator.
//
// We use subsumption to find the 'closest' dominator.
// Base case: immediate_dom(x, y) if y strictly domiantes x.
// Subsumption: for x's two immediate dominators y1 and y2, discard y1 if y2 is dominated by y1.
// This means y2 is lower in the path, hence 'closer' to x.



.comp Dominance<N>{

      //
      // Start node (singleton)
      //
      .decl start(s:N)

      //
      // Set of edges
      //
      .decl edge(s:N,d:N)

      //
      // Set of nodes
      //
      .decl node(n:N)
      node(x) :- edge(x,_).
      node(x) :- edge(_,x).

      //
      // Non-dominance of input graph
      //
      .decl non_dom(s:N,d:N)
      non_dom(x,y) :- start(x), node(y), x!=y.
      non_dom(x,y) :- non_dom(z,y), edge(z,x), !start(x), x!=y .


      //
      // Dominance of input graph
      //
      .decl dom(s:N,d:N)
      dom(x,y) :- node(x), node(y), !non_dom(x,y).

      //
      // Finds nodes that strictly dominate a node
      //
      .decl s_dom(n:N,d:N)
      s_dom(n,d) :- dom(n,d), n != d.

}


.comp ImmediateDominance<N> : Dominance<N>{

      //
      // Immediate Dominator
      //
      .decl imdom(n:N,i:N)
      imdom(n,x) :- s_dom(n,x).
      imdom(n,x1) <= imdom(n, x2) :- dom(x2, x1).

}

//
// The graph is taken from figure 9.38 in
// "Compilers Principles, Techniques and Tools" Edition 2
// by V.Aho et al.
//

.init ImmDom = ImmediateDominance<number>

ImmDom.edge(1, 2).
ImmDom.edge(1, 3).
ImmDom.edge(2, 3).
ImmDom.edge(4, 3).
ImmDom.edge(8, 3).
ImmDom.edge(3, 4).
ImmDom.edge(8, 4).
ImmDom.edge(4, 5).
ImmDom.edge(4, 6).
ImmDom.edge(5, 7).
ImmDom.edge(6, 7).
ImmDom.edge(10, 7).
ImmDom.edge(7, 8).
ImmDom.edge(8, 9).
ImmDom.edge(8, 10).
ImmDom.edge(9, 1).
ImmDom.start(1).


//
// Output
//

.decl dominators(n:number,s:number)
.output dominators()
dominators(n,s) :- ImmDom.dom(n,s).


//
// Output
//

.decl immediate_dom(n:number,s:number)
.output immediate_dom()
immediate_dom(n,s) :- ImmDom.imdom(n,s).



// ==== END: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Solves the n-queens problem

// Side length of the board.
.decl size( n : number )
.input size()


// The maximal compatible sets -- n queens.
.decl solution( qs : QueenList )
.printsize solution
solution(qs) :- compatible(qs, s), size(s).


// Natural numbers from 1 to the size of the board.
.decl up_to_size( x : number )
up_to_size(1).
up_to_size(x + 1) :- up_to_size(x), !size(x).


// A cartesian coordinate for a board square.
.type Position = [ x : number, y : number ]


// This relation holds the position of each square of the board.
.decl on_board( p : Position )
on_board([x, y]) :- up_to_size(x), up_to_size(y).


// Mutually-non-attacking list of queen positions.
.type QueenList = [ p : Position, qs : QueenList ]


// Arguments are not on the same diagonal.
.decl non_diagonals( p : Position, q : Position )
non_diagonals([px, py], [qx, qy]) :- px - qx != py - qy, qx - px != py - qy, on_board([px, py]), on_board([qx, qy]).


// Holds if p and q do not attack each other.
.decl sympathetic( p : Position, q : Position )
sympathetic(p, q) :- non_diagonals(p, q), px != qx, py != qy, p=[px, py], q=[qx,qy].


// Holds if the head of qs is mutually non-attacking with its tail, which should itself be compatible.
// Generated column by column, left to right.
.decl compatible( qs : QueenList, n : number )
compatible([p, nil], 1) :- on_board(p). //, p = [1,y].
compatible([p, [head, tail]], n+1) :- sympathetic(p, head), compatible([p, tail], n), compatible([head, tail], n), p = [px, py], head = [hx, hy], px > hx.

// ==== END: d:\work24\souffle-lsp-plugin\example\nqueens\nqueens.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po3\po3.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, _, c, d, e, f), In(a, _, c, d, e, f, i).
A(3,i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(4,i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(7, i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(8, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(9, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(10, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(11, i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(12, i) :- Check(a, b, c, _, _, f), In(a, b, c, _, _, f, i).
A(13, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(14, i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(15, i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).




