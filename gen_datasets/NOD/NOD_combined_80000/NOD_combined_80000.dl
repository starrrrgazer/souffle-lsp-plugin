// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Limit(weight:number)
Limit(h) :- h = sum w : Edge(_,_,w).

.decl Path(source:symbol,destination:symbol,path:number)
Path(a,c,w) :- Edge(a,c,w).
Path(a,c,w1+w2) :-
  Limit(h),
  Edge(a,b,w1),
  Path(b,c,w2),
    w2 < h-w1.

.decl FindingShorterPath(source:symbol,destination:symbol,weight:number)
FindingShorterPath(a,b,w1) :-
  Path(a,b,w1),
  Path(a,b,w2),
  w2<w1.

.decl ShortestPath(source:symbol,destination:symbol,weight:number)
ShortestPath(a,b,w) :-
  Path(a,b,w),
  !FindingShorterPath(a,b,w).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2021, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// define edge relation of a directed graph
.decl e(x:number, y:number, c:number)

e(1,2,1).
e(2,2,1).
e(2,3,1).
e(3,4,1).
e(1,4,100).

// define shortest path relation
.decl sp(x:number, y:number, c:number) btree_delete

//
// subsumption
//
// A longer path is subsumed by a shorter path, i.e.,
// the longer path is discarded from the relation.
sp(x,y,c1) <= sp(x,y, c2) :-
  c2 <= c1.

//
// base case
//
sp(x,y,c) :-
  e(x,y,c).

//
// inductive case
//
sp(x,z,c1 + c2) :-
  sp(x,y,c1),
  e(y,z,c2).

.output sp

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_path2\shortest_path2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\flights2\flights2.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Airport <: symbol
.type Hour <: number
.type Route = [
	source : Airport,
	destination : Airport,
	start : Hour,
	duration : Hour
]

// List of flights
.decl flight(r : Route)
flight(["Sydney", "Melbourne", 8, 2]).
flight(["Sydney", "Melbourne", 20, 2]).
flight(["Sydney", "Singapore", 6, 10]).
flight(["Melbourne", "Auckland", 14, 4]).
flight(["Sydney", "Auckland", 12, 3]).
flight(["Singapore", "Tokyo", 21, 12]).
flight(["Singapore", "Dubai", 10, 11]).
flight(["Singapore", "London", 14, 14]).
flight(["Dubai", "London", 5, 6]).
flight(["London", "New York", 17, 15]).
flight(["London", "New York", 5, 15]).
flight(["London", "Oslo", 15, 3]).
flight(["London", "Paris", 10, 3]).
flight(["London", "Reykjavik", 8, 5]).
flight(["Oslo", "Reykjavik", 9, 4]).
flight(["Oslo", "Reykjavik", 21, 4]).
flight(["Los Angeles", "New York", 14, 5]).
flight(["Tokyo", "Los Angeles", 4, 14]).
flight(["Singapore", "Los Angeles", 9, 14]).
flight(["Singapore", "Los Angeles", 17, 14]).
flight(["Tokyo", "Vancouver", 12, 10]).
flight(["Singapore", "Vancouver", 18, 14]).
flight(["Los Angeles", "Vancouver", 5, 5]).

// Input starting airport and time
.decl travel(s : Airport, t : Hour)
.input travel()

// Find all connecting flights from starting airport
.decl connection(s : Airport, d : Airport, t : Hour, h : Hour)
.output connection()
connection(s, d, (t + h) % 24, (24 + t - tx) % 24 + h) :- travel(s, tx), flight([s, d, t, h]).
connection(s, d, (tx + h) % 24, hx + (24 + t - tx) % 24 + h) :- connection(s, x, tx, hx), flight([x, d, t, h]).

// Total time in hours to reach destination airport
.decl total_time(d : Airport, h : Hour)
.output total_time()
total_time(d, h) :- connection(s, d, _, _), h = min x : connection(s, d, _, x).

// ==== END: d:\work24\souffle-lsp-plugin\example\flights2\flights2.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/magic_access-policy/magic_access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

// A copy of the `access-policy' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:/work24/souffle-lsp-plugin/example/magic_access-policy/magic_access-policy.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\fib\fib.dl ====
.type Integer <: symbol

.decl plus_mod (x:Integer, y:Integer, r:Integer)
.decl succ (a:Integer, b:Integer)
.decl f(x:Integer, y:Integer)
.output f()

f("0", "0").
f("1", "1").
f(i, r) :- succ(prev, i), succ(pprev, prev),f(prev, x), f(pprev, y), plus_mod(x, y, r).


plus_mod("0", "0", "0").
plus_mod("0", "1", "1").
plus_mod("1", "0", "1").
plus_mod("1", "1", "2").
plus_mod("0", "2", "2").
plus_mod("2", "0", "2").
plus_mod("2", "1", "0").
plus_mod("1", "2", "0").
plus_mod("2", "2", "1").


succ("0", "1").
succ("1", "2").
succ("2", "3").
succ("3", "4").
succ("4", "5").
succ("5", "6").
succ("6", "7").
succ("7", "8").
succ("8", "9").
succ("9", "10").
succ("10", "11").
succ("11", "12").
succ("12", "13").
succ("13", "14").
succ("14", "15").
succ("15", "16").
succ("16", "17").
succ("17", "18").
succ("18", "19").
succ("19", "20").


