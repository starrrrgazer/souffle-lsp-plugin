// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute the factorial function.

// fact(i, n) holds iff i! = n
.decl fact(i:number, n:number)
.output fact()

// Calculate only up to the lowest value satisfying lim(n)
.decl lim(n:number)
.input lim()

fact(I+1, N*(I+1)) :- fact(I, N), !lim(I).

// Ground Fact: 0! := 1
fact(0, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\factorial\factorial.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()
.decl satellite (x:D,y:D)
.output satellite ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

satellite(X,Y) :-
  orbits(X,Y),
  !intermediate(X,Y),
  !star(Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).



// ==== END: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====

// ==== BEGIN: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl gen(x : number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//factors excluding 1
.decl factor(num : number, fc : number)
factor(x, fc) :- gen(x), gen(fc), x % fc = 0, fc != 1.

//finds if there exist two numbers which multiply to x
.decl prod(num : number)
prod(x) :- gen(x), gen(a), gen(b), b != x, a != x, x = a*b.

//finds the prime factors
.decl p_factor(x : number, fc : number)
.output p_factor()
p_factor(x, fc) :- factor(x, fc), !prod(fc).

// ==== END: d:/work24/souffle-lsp-plugin/example/factoring/factoring.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#include "grid.dl"

// Minesweeper
// Generates minesweeper boards, a cell containing a mine takes the value -1, while all other cells take the value of the number of mines in their local neighbourhood (i.e. in the eight cells to which they are adjacent.

// A mine count for a given cell is valid if it is between 0 and 8 inclusive.
.decl is_valid(x:number)
is_valid(0).
is_valid(x+1) :- is_valid(x), x < 8.

// The cells of the game board, taking the value -1 if the backing grid contains a value for the cell at the specified row and column, of the number of surrounding mines otherwise.
.decl cell(row:number, column:number, variable:number)
.output cell()
cell(i, j, -1) :- x != 0, element(i, j, x).
cell(i, j, x) :-
  x = tl + tc + tr + ml + mr + bl + bc + br,
  is_valid(x),
  neighbourhood(i, j, tl, tc, tr, ml, 0, mr, bl, bc, br).



// ==== END: d:\work24\souffle-lsp-plugin\example\minesweeper\minesweeper.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Type Node
.type Node <: symbol

//
// Edges non circular
//

.decl Edge        (n:Node, m:Node, w:number)

Edge("0","1",3).
Edge("1","2",5).
Edge("2","3",1).
Edge("1","4",-6).
Edge("4","2",-1).

//
// Reachable
//

.decl Reachable   (n:Node, m:Node, i:number)
.output Reachable   ()

Reachable(x,y,r)  :- r=w, Edge(x,y,w).
Reachable(x,y,d+w)  :- Edge(x,z,w), Reachable(z,y,d).


.decl ShortestDuplicates(n:Node, m:Node, i:number)
.output ShortestDuplicates()

ShortestDuplicates(x,y,a) :- Reachable(x,y,a), Reachable(x,y,b), a<b.

// ==== END: d:\work24\souffle-lsp-plugin\example\weighted_distances\weighted_distances.dl ====

