.decl InstanceVar(instanceVariable:VarRef)
InstanceVar(var) :- LoadInstanceFieldIndex(var, _, _, _).
InstanceVar(var) :- StoreInstanceFieldIndex(_, var, _, _).

.decl Superclass(subclass:Type, superclass:Type)
