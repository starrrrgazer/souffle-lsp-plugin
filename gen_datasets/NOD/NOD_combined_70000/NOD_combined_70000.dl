// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find pairs of amicable numbers up to a limit
// A pair of numbers are amicable if the sum of their factors add up to each other

// Build search range
.decl num(x : number)
num(1).
num(x+1) :- num(x), x < l, lim(l).

// Search limit
.decl lim(n : number)
.input lim

// Find factors of x excluding itself
.decl factor(x : number, f : number)
factor(x, f) :- num(x), num(f), f <= x / 2, x % f = 0.

// Compute the sum of all the factors of x
.decl factor_sum(x : number, fs : number)
factor_sum(x, f) :- num(x), f = sum i : factor(x, i).

// Find pairs of numbers whose factors add up to each other
.decl amicable(a : number, b : number)
.output amicable()
amicable(a, b) :- factor_sum(a, b), factor_sum(b, a), a < b.

// ==== END: d:\work24\souffle-lsp-plugin\example\amicable\amicable.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\comp-parametrized\comp-parametrized.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt


.comp CallGraph {
    .decl CallGraphEdge(caller: number, callee: number)
.output CallGraphEdge()
    .decl Node(n: number)
    Node(1).
    Node(n + 1) :- Node(n), n < 10.
}

.comp CHACallGraph : CallGraph {
    CallGraphEdge(x, y + 1) :- Node(x), Node(y+1), x = y.
    CallGraphEdge(x + 1, y) :- Node(x+1), Node(y), x = y, x < 5.
}

.comp CICallGraph : CallGraph {
    CallGraphEdge(1,4).
}

.comp Main<CallGraphFlavour> {
    .init cg = CallGraphFlavour

    .decl NoWayBack(x: number, y: number)
.output NoWayBack()
    NoWayBack(x, y) :-
        cg.Node(x), cg.Node(y),
        cg.CallGraphEdge(x, y), !cg.CallGraphEdge(y, x).
}

.init cha_main = Main<CHACallGraph>
.init ci_main = Main<CICallGraph>

// ==== END: d:\work24\souffle-lsp-plugin\example\comp-parametrized\comp-parametrized.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute a Lucas Sequence.

// Maximum sequence element.
.decl lim(l:number)
.input lim()

// Coefficients for the sequence.
.decl pq(p:number, q:number)
.input pq()

// Relation composing the i'th element of this sequence.
// Base cases given in the .facts file.
.decl lucas(i:number, n:number)
.output lucas()
.input lucas()

lucas(I+1, P*N - Q*M) :- lucas(I, N), lucas(I-1, M), pq(P, Q), !lim(I).

// ==== END: d:\work24\souffle-lsp-plugin\example\lucas\lucas.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\clique\clique.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//// Test Case adopted from Ocaml datalog

.type Node <: symbol

.decl reachable   (node1:Node, node2:Node)
.output reachable   ()
.decl same_clique (node1:Node, node2:Node)
.output same_clique ()
.decl edge        (node1:Node, node2:Node)
.output edge        ()

reachable(X,Y)   :- edge(X,Y).
reachable(X,Y)   :- edge(X,Z), reachable(Z,Y).
same_clique(X,Y) :- reachable(X,Y), reachable(Y,X).

edge("0", "1").
edge("1", "2").
edge("2", "3").
edge("3", "4").
edge("4", "5").
edge("5", "0").
edge("5", "6").
edge("6", "7").
edge("7", "8").
edge("8", "9").
edge("9", "10").
edge("10", "7").

