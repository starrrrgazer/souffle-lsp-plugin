MovieActorsText(c,d) :- MovieActors(a,b), Movie(a,c,_), Actors(b,d).

.decl JoeBloggsMovies(title:Text)
.output JoeBloggsMovies()

JoeBloggsMovies(a) :- MovieActorsText(a, b), match("Joe Bloggs", b).

