// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====
// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).



// ==== END: d:\work24\souffle-lsp-plugin\example\prime2\prime2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\speed\speed.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl CurrentNode(DistanceToSink:number, deadline:number)

CurrentNode(20,10).
.output CurrentNode()


.decl NeighborNode(DistanceToSink:number,DelayToNeighbor:number, id:symbol)

NeighborNode(8,1,"a").
NeighborNode(7,8,"b").
NeighborNode(11,10,"c").
NeighborNode(4,2,"d").
.output NeighborNode()



.decl CandidateNode(DistanceToNeighbor:number,DelayToNeighbor:number, id:symbol)
CandidateNode(distance1-distance,delay,id) :-
	NeighborNode(distance,delay,id),  CurrentNode(distance1,deadline), distance<distance1, ((distance1-distance)/delay)>=(distance1/deadline).
.output CandidateNode()



.decl NextHop(id:symbol, speed:number)
NextHop(id,speed) :-
	CandidateNode(distance1,delay1,id), speed = max (distance/delay) : CandidateNode(distance,delay,_), speed=distance1/delay1.
.output NextHop()


// ==== END: d:\work24\souffle-lsp-plugin\example\speed\speed.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====
//
// An example computing all palendroms of a given length.
//

.type Letter <: symbol

.decl str(id:number, a:number, l:Letter, b:number)
.decl len(id:number, l:number)


//////////////////////////////////////////////////////////////////
//          index range          //
//////////////////////////////////////////////////////////////////

.decl p(x:number)

p(0).
p(x) :- str(_,_,_,x).




//////////////////////////////////////////////////////////////////
//          palindromes          //
//////////////////////////////////////////////////////////////////


.decl palin_aux(s:number, a:number, b:number)
palin_aux(s,x,x) :- str(s,_,_,_), p(x).
palin_aux(s,x,y) :- str(s,x,_,y).
palin_aux(s,x,y) :- str(s,x,a,t), palin_aux(s,t,r), str(s,r,a,y).

.decl palindrome(s:number)
.output palindrome()
palindrome(s) :- palin_aux(s,0,l), len(s,l).



//////////////////////////////////////////////////////////////////
//       words to be tested      //
//////////////////////////////////////////////////////////////////

// hello
str(0,0,"h",1).
str(0,1,"e",2).
str(0,2,"l",3).
str(0,3,"l",4).
str(0,4,"o",5).
len(0,5).


// racecar
str(1,0,"r",1).
str(1,1,"a",2).
str(1,2,"c",3).
str(1,3,"e",4).
str(1,4,"c",5).
str(1,5,"a",6).
str(1,6,"r",7).
len(1,7).


// noon
str(2,0,"n",1).
str(2,1,"o",2).
str(2,2,"o",3).
str(2,3,"n",4).
len(2,4).

// never odd or even
str(3,0,"n",1).
str(3,1,"e",2).
str(3,2,"v",3).
str(3,3,"e",4).
str(3,4,"r",5).
str(3,5,"o",6).
str(3,6,"d",7).
str(3,7,"d",8).
str(3,8,"o",9).
str(3,9,"r",10).
str(3,10,"e",11).
str(3,11,"v",12).
str(3,12,"e",13).
str(3,13,"n",14).
len(3,14).



// ==== END: d:\work24\souffle-lsp-plugin\example\palindrome\palindrome.dl ====

