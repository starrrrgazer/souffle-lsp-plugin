// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====
// Orbits of cosmological objects
// Rafael Caballero-Rold\'an, 2007
// Adopted from DES

.type D <: symbol

.decl star    (x:D)
.output star    ()
.decl orbits  (x:D,y:D)
.output orbits  ()
.decl planet  (x:D)
.output planet  ()
.decl intermediate (x:D,y:D)
.output intermediate ()
.decl satellite (x:D,y:D)
.output satellite ()

star("sun").
orbits("earth", "sun").
orbits("moon", "earth").

orbits(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).

satellite(X,Y) :-
  orbits(X,Y),
  !intermediate(X,Y),
  !star(Y).

planet(X) :-
  orbits(X,Y),
  star(Y),
  !intermediate(X,Y).

intermediate(X,Y) :-
  orbits(X,Z),
  orbits(Z,Y).



// ==== END: d:\work24\souffle-lsp-plugin\example\orbits\orbits.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\shortest_edges\shortest_edges.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shortest outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl ShortestEdgeFromN(n:Node, l:number)
.output ShortestEdgeFromN()

ShortestEdgeFromN(x, l) :- Edge(x, _, _), l = min Z : Edge(x, _, Z).

