// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\edit_distance\edit_distance.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Letter <: symbol
.type Pos <: number
.type Cost <: number

.decl String1			(p:Pos, a:Letter)
.decl String2			(p:Pos, a:Letter)

.input String1
.input String2

.decl End1				(p:Pos)
.decl End2				(p:Pos)
.decl NotEnd1			(p:Pos)
.decl NotEnd2			(p:Pos)

NotEnd1(p) :- String1(p, _), String1(q, _), p < q.
End1(p) :- String1(p, _), !NotEnd1(p).
NotEnd2(p) :- String2(p, _), String2(q, _), p < q.
End2(p) :- String2(p, _), !NotEnd2(p).

.decl Match				(i:Pos, j:Pos, c:Cost)

Match(0, 0, 0).

// Match a character
Match(i + 1, j + 1, s) :- End1(e), i < e, End2(f), j < f, Match(i, j, s), String1(i + 1, a), String2(j + 1, a).

// Indels
Match(i + 1, j, s + 1) :- End1(e), i < e, End2(f), j <= f, Match(i, j, s).
Match(i, j + 1, s + 1) :- End1(e), i <= e, End2(f), j < f, Match(i, j, s).

.decl MinMatch			(i:Pos, j:Pos, c:Cost)
.decl NotMinMatch		(i:Pos, j:Pos, c:Cost)

NotMinMatch(i, j, s) :- Match(i, j, s), Match(i, j, t), t < s.
MinMatch(i, j, s) :- Match(i, j, s), !NotMinMatch(i, j, s).
//MinMatch(i, j, s) :- s = min t : Match(i, j, t).

.decl Result			(c:Cost)

Result(c) :- End1(e), End2(f), MinMatch(e, f, c).
.output Result

// ==== END: d:\work24\souffle-lsp-plugin\example\edit_distance\edit_distance.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Finds the length of the path that visits the most nodes without overlapping itself

.type node <: symbol

.decl edge(x : node, y : node)
.input edge()

// Find all paths between all nodes
.decl length(x : node, y : node, l : number)
length(x,y,l) :- l = 2, edge(x, y).
length(x,y,l+1) :- edge(x, z), length(z, y, l).

// Find the start and end of the path with the most nodes visited
.decl longest_path(x : node, y : node, l : number)
.output longest_path()
longest_path(y, x, l) :- l = max m : length(x, y, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====
//// Hypothetical Queries
//// Source: [Bonn99], extended and adapted
//// Adopted from DES

.type Node <: symbol

.decl student (node1:Node)
.output student ()
.decl course (node1:Node)
.output course ()
.decl pre (node1:Node, node2:Node)
.output pre ()
.decl take (node1:Node, node2:Node)
.output take ()
.decl grad (node1:Node)
.output grad ()

student("adam").
student("bob").
student("pete").
student("scott").
student("tony").

course("eng").
course("his").
course("lp").

take("adam","eng").
take("pete","his").
take("pete","eng").
take("scott","his").
take("scott","lp").
take("tony","his").

pre("eng","lp").
pre("hist","eng").

pre(Pre,Post) :- pre(Pre,X), pre(X,Post).

grad(S) :- take(S,"his"), take(S,"eng").

// ==== END: d:\work24\souffle-lsp-plugin\example\grad\grad.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type State <: number
.type Letter <: symbol

.decl Q				(q:State)
.decl Init			(q:State)
.decl Final			(q:State)
.decl Tr			(q:State, a:Letter, r:State)

.input Final
.input Tr

Init(0).

Q(q) :- Tr(q, _, _).

.decl Dis			(q:State, r:State)

Dis(q, r) :- Q(q), Q(r), Final(q), !Final(r).
Dis(q, r) :- Tr(q, a, s), Tr(r, a, t), Dis(s, t).
Dis(q, r) :- Dis(r, q).

.decl Equiv		(q:State, r:State)

Equiv(q, r) :- Q(q), Q(r), !Dis(q, r).

.decl NotMinEquiv	(q:State, r:State)
.decl MinEquiv		(q:State, r:State)

NotMinEquiv(q, r) :- Equiv(q, r), Equiv(q, s), s < r.
MinEquiv(q, r) :- Equiv(q, r), !NotMinEquiv(q, r).

.output MinEquiv

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_min\dfa_min.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find all disconnected node pairs
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

// Find the connected nodes
.decl Connected(n:Node, m:Node)
Connected(n, n) :- Edge(n, _, _).
Connected(n, n) :- Edge(_, n, _).
Connected(n, m) :- Edge(n, m, _).
Connected(n, m) :- Edge(n, z, _), Connected(z, m).

// Find nodes without a connection
.decl DisConnected(n:Node, m:Node)
.output DisConnected()
DisConnected(n, m) :- Edge(n, _, _), Edge(_, m, _), !Connected(n, m).
DisConnected(n, m) :- Edge(n, _, _), Edge(m, _, _), !Connected(n, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\disconnected\disconnected.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Text <: symbol

.decl food(name:Text, carbs:number, fat:number, protein:number, per:number, measure:Text)
.input food()

.decl recipe(index: number, name:Text, amount: number, measure: Text)
.input recipe()

.decl max_index(result:number)
.output max_index()

max_index(a) :-  a = max a : recipe(a,_,_,_) .

.decl totals(name:Text, amount:number, carbs:number, fat:number, protein:number, cal:number)
.output totals()

totals(name, amount, amount*a/per, amount*b/per, amount*c/per, ((4*amount*a/per)+(9*amount*b/per)+(4*amount*c/per))) :- recipe(_, name, amount, _), food(name, a,b,c,per,_).


.decl calories(result:number)
.output calories()

calories(result) :- result = sum a : totals(_,_,_,_,_,a).

// ==== END: d:\work24\souffle-lsp-plugin\example\recipes\recipes.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_access-policy\magic_access-policy.dl ====
// Example adapted (hacked) from Olson, Gunter, Madhusudan CCS'08, Data is random

// A copy of the `access-policy' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

.type String <: symbol

.decl view_employee(x : String, p:String, ssn:String, s:number, e:String, d:String, pos:String, bday:number)
.output view_employee()
.decl view_cwPriv(n : String, person :String, bank1Priv :number, bank2Priv : number)
.input view_cwPriv()
.decl view_bank1(n :String, Data1 :number, Data2 :number)
.input view_bank1()
.decl view_bank2(n :String, Data1 : number, Data2:number)
.input view_bank2()

.decl employee(person : String, ssn:String, salary : number, email: String, dept : String, pos : String, bday : number)
.input employee()

.decl inslogtable(user :String, person :String, day : number)
.input inslogtable()

.decl insurance(user : String)
.input insurance()

.decl bank1(d:number, d2:number)
.input bank1()
.decl bank2(d:number, d2:number)
.input bank2()

.decl inscwPriv(user : String, x:number, y:number)
.input inscwPriv()
.decl delcwPriv(user:String, x:number, y:number)
.input delcwPriv()
.decl cwPriv(person:String, bank1Priv : number, Bank2Privi : number)
.input cwPriv()


view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday) :-
  employee(Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  User=Person, view_employee("alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, SSN, Salary, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, Dept,"Manager", _),
  view_employee("Alice", Person, SSN, Salary, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, Email, Dept, Position, Bday) :-
  view_employee("Alice", User, _, _, _, _, _, _),
  view_employee("Alice", Person, _, _, Email, Dept, Position, Bday).

view_employee(User, Person, "0", 0, " ", " ", " ", Bday) :-
  insurance(User),
  view_employee("Alice", Person, _, _, _, _, _, Bday),
  inslogtable(User, Person, 92311).

view_cwPriv("Bob", Person, Bank1Priv, Bank2Priv) :-
  cwPriv(Person, Bank1Priv, Bank2Priv).

view_bank1("Bob", Data1, Data2) :-
  bank1(Data1, Data2).

view_bank1(User, Data1, Data2) :-
  view_cwPriv("Bob", User, 1, _),
  delcwPriv(User, 1, _), inscwPriv(User, 1, 0),
  view_bank1("Bob", Data1, Data2).

view_bank2("Bob", Data1, Data2) :-
  bank2(Data1, Data2).

view_bank2(User, Data1, Data2) :-
  view_cwPriv("Bob", User, _, 1),
  delcwPriv(User, _, 1),
  inscwPriv(User, 0, 1),
  view_bank2("Bob", Data1, Data2).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_access-policy\magic_access-policy.dl ====

