// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Subtracts the number of `-` from the number of `+`

.type index <: number
.type counter <: number
.type program <: symbol

.decl torun(p : program)
.input torun

.decl progress(i : index, c : counter, p : program)
progress(0,0,p) :- torun(p).
progress(i+1,c+1,p) :- progress(i,c,p), "+"=substr(p,i,1).
progress(i+1,c-1,p) :- progress(i,c,p), "-"=substr(p,i,1).
progress(i+1,c,p) :-
    progress(i,c,p),
    i < strlen(p),
    "+" != substr(p,i,1),
    "-" != substr(p,i,1).

.decl result(c : counter, p : program)
result(c,p) :- progress(strlen(p),c,p).
.output result

// ==== END: d:\work24\souffle-lsp-plugin\example\counter\counter.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\profile_default\profile_default.dl ====
// Souffle - A Datalog Compiler
