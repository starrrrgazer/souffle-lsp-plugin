// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Finds the length of the path that visits the most nodes without overlapping itself

.type node <: symbol

.decl edge(x : node, y : node)
.input edge()

// Find all paths between all nodes
.decl length(x : node, y : node, l : number)
length(x,y,l) :- l = 2, edge(x, y).
length(x,y,l+1) :- edge(x, z), length(z, y, l).

// Find the start and end of the path with the most nodes visited
.decl longest_path(x : node, y : node, l : number)
.output longest_path()
longest_path(y, x, l) :- l = max m : length(x, y, m).

// ==== END: d:\work24\souffle-lsp-plugin\example\longest_path\longest_path.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\factorial\factorial.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Compute the factorial function.

// fact(i, n) holds iff i! = n
.decl fact(i:number, n:number)
.output fact()

// Calculate only up to the lowest value satisfying lim(n)
.decl lim(n:number)
.input lim()

fact(I+1, N*(I+1)) :- fact(I, N), !lim(I).

// Ground Fact: 0! := 1
fact(0, 1).


// ==== END: d:\work24\souffle-lsp-plugin\example\factorial\factorial.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\rsg\rsg.dl ====
.type Node <: symbol

.decl RSG (node1:Node, node2:Node)
.output RSG ()
.decl FLAT(node1:Node, node2:Node)
.output FLAT()
.decl UP  (node1:Node, node2:Node)
.output UP  ()
.decl DOWN(node1:Node, node2:Node)
.output DOWN()

RSG(x,y) :- FLAT(x,y).
RSG(x,y) :- UP(x, a), RSG(b, a), DOWN(b, y).

UP("a","e").
UP("a","f").
UP("f","m").
UP("g","n").
UP("h","n").
UP("i","o").
UP("j","o").

FLAT("g","f").
FLAT("m","n").
FLAT("m","o").
FLAT("p","m").

DOWN("l","f").
DOWN("m","f").
DOWN("g","b").
DOWN("h","c").
DOWN("i","d").
DOWN("p","k").

