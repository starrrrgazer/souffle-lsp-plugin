// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Generate the Catalan numbers

// Generated catalan numbers will never exceed lim(n).
.decl lim(n : number)
.input lim()

.decl naturals(n : number)
naturals(0).
naturals(n+1) :- naturals(n), n < s, lim(s).

// Binomial Coefficients
.decl choose(n : number, k : number, v : number)
choose(n, n, 1) :- naturals(n).
choose(n, (n - k), v) :- choose(n, k, v).
choose(n+1, k+1, v1 + v2) :- choose(n, k, v1), choose(n, k+1, v2).

.decl catalan(n : number, v: number)
.output catalan()
catalan(n, v) :- choose(2*n, n, c), naturals(v), v=c/(n+1).



// ==== END: d:\work24\souffle-lsp-plugin\example\catalan\catalan.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath3\minpath3.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2019, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// Shortest Path Computation
//

.type Node <: symbol
.type Distance <: number

//
// start node
//
.decl start(u:Node)
.input start

//
//  edge relation of directed graph
//

.decl edge(u:Node, v:Node, dist:Distance)
.input edge

//
// node relation
//

.decl node(u:Node)

node(u) :-
   edge(u, _, _);
   edge(_, u, _).

//
// order predecessor nodes by ordinal Distance
//

.decl lessPred(u1:Node, u2:Node, v:Node)

lessPred(u1, u2, v) :-
   edge(u1, v, _),
   edge(u2, v, _),
   ord(u1) < ord(u2).

//
// compute strict transitive predecessor nodes
//

.decl transPred(u1:Node, u2:Node, v:Node)

transPred(u1, u3, v) :-
   lessPred(u1, u2, v),
   lessPred(u2, u3, v).

//
// successor relation among predecessor node
//

.decl succPred(before:Node, after:Node, v:Node)
succPred(u1, u2, v) :-
   lessPred(u1, u2, v),
   !transPred(u1, u2, v).

//
// determine first predecessor of a node
//

.decl firstPred(u:Node, v:Node)

firstPred(u, v) :-
   edge(u, v, _),
   !succPred(_, u, v).

//
// determine last predecessor of a node
//

.decl lastPred(u:Node, v:Node)

lastPred(u, v) :-
   edge(u, v, _),
   !succPred(u, _, v).

//
// step function that computes stepwise the shortest distance
// of a node.
//

.decl step(i:number, u:Node, w:Distance, next:Node)

/* compute shortest distance for first predecessor node
 * NB: this step is performed assuming that the computation
 * hasn't finished yet.
 */
step(i+1, v, d1 + d2, u) :-
   again(i),
   shortestStepPath(i, u, d2),
   firstPred(u, v),
   edge(u, v, d1).

/* compute shortest distance for subsequent predecessor nodes;
 * one of the previous predecessors was smaller than shortest path from
 * current predecessor.
 */

step(i, v, d, u2) :-
   step(i, v, d, u1),
   succPred(u1, u2, v),
   edge(u2, v, d1),
   shortestStepPath(i-1, u2, d2),
   d <= d1 + d2.

/* compute shortest distance for subsequent predecessor nodes;
 * all previous predecessors' shortest paths are longer than the
 * shortest path of current predecessors.
 */

step(i, v, d1 + d2, u2) :-
   step(i, v, d, u1),
   succPred(u1, u2, v),
   edge(u2, v, d1),
   shortestStepPath(i-1, u2, d2),
   d1 + d2 < d.

//
// compute shortest distance of a node in the i-th step
//

.decl shortestStepPath(i:number, u:Node, d:Distance)

/* initial shortest distance for start node for first step */
shortestStepPath(i, u, 0) :-
   again(i),
   start(u).

/* initial shortest distance for all other nodes for subsequent steps */
shortestStepPath(0, u, largeDist) :-
   node(u),
   !start(u),
   largeDist = sum d: {edge(_,_,d)}.

/* shortest distance for all other steps */
shortestStepPath(i, v, d) :-
   step(i, v, d, u),
   lastPred(u, v).

//
// Predicate which determines whether another step is required.
//

.decl again(i:Distance)

/* at least two iterations are required */
again(0).
again(1).

/* if we find at least one node whose result has changed in the
 * previous step, a new step is required.
 */

again(i+1) :-
   shortestStepPath(i, u, wi),
   shortestStepPath(i-1, u, wi_1),
   i > 0,
   wi < wi_1.

//
// last step
//

.decl lastStep(i:number)

lastStep(i) :-
   again(i),
   !again(i+1).

//
// shortest path
//

.decl shortestPath(u:Node, dist:Distance)

shortestPath(u, d) :-
   lastStep(i),
   shortestStepPath(i, u, d).

.output shortestPath


// ==== END: d:\work24\souffle-lsp-plugin\example\minpath3\minpath3.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====
// A copy of the `prime2' test, this time using
// the magic set transformation
.pragma "magic-transform" "*"

// Computes all prime numbers between 2 and 500

//// ----- declarations -----

// the search range
.decl nat(x:number)

// the primes within the range
.decl prime(x:number)
.output prime()


// -- auxiliary relations --
.decl succ(a:number,b:number)
.decl add(a:number,b:number,r:number)
.decl mul(a:number,b:number,r:number)

.decl candidate(x:number)
.decl prod(x:number)


////////////////////////////////////////////////////

// build up search range
nat(0).
nat(x+1) :- nat(x), x<500.

//// --- basic operations ---

// build successor relation
succ(a,b) :- nat(a), nat(b), b=a+1.

// build addition relation
add(a,0,a) :- nat(a).
add(a,b,r) :- succ(pb,b), add(a,pb,pr), succ(pr,r).

// build multiplication relation
mul(a,0,0) :- nat(a).
mul(a,b,r) :- succ(pb,b), mul(a,pb,pr), add(a,pr,r).



// --- compute prime numbers ---

candidate(x) :- nat(x), x!=0, x!=1.

// build list of products
prod(x) :- candidate(a), candidate(b), mul(a,b,x).

// define prime numbers
prime(x) :- candidate(x), !prod(x).

// ==== END: d:\work24\souffle-lsp-plugin\example\magic_prime2\magic_prime2.dl ====

