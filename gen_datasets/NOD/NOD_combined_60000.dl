.type Text <: symbol

.decl Movie(id:number,title:Text,rating:Text)
.decl MovieActors(movieid:number,actorsid:number)
.decl Actors(actorid:number,name:Text)

Movie(1,"Movie a","2.3/10").
Movie(2,"Movie b","9.3/10").
