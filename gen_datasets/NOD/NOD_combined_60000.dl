// Andersen's points-to analysis

// Define the domain of variables
.type var <: symbol

// Take addresses of other variables, i.e., y = &x;
.decl AddressOf(y:var, x:var)
.input AddressOf()

// Assign Statements, i.e.,  y = x;
.decl Assign(y:var, x:var)
.input Assign()

// Load Statements, i.e., y = *x;
.decl Load(y:var, x:var)
.input Load()

// Store Statements, i.e., *y = x;
.decl Store(y:var, x:var)
.input Store()

// PointsTo Relation, i.e., whether y may point to x
.decl PointsTo(y:var, x:var)
.output PointsTo()

PointsTo(y, x) :-
 AddressOf(y, x).

PointsTo(y, x) :-
 Assign(y, z),
 PointsTo(z, x).

PointsTo(y, w) :-
 Load(y, x),
 PointsTo(x, z),
 PointsTo(z, w).

PointsTo(z, w) :-
 Store(y, x),
 PointsTo(y, z),
 PointsTo(x, w).

// ==== END: d:\work24\souffle-lsp-plugin\example\andersen\andersen.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====
//// Farmer-Wolf-Goat-Cabbage Puzzle
//// Adopted from DES

.type Node <: symbol

.decl safe  (node1:Node, node2:Node, node3:Node, node4:Node)
.output safe  ()
.decl state (node1:Node, node2:Node, node3:Node, node4:Node)
.output state ()
.decl opp   (node1:Node, node2:Node)
.output opp   ()

// Initial state
state("n","n","n","n").
// Farmer takes Wolf
state(X,X,U,V) :-
  safe(X,X,U,V),
  opp(X,X1),
  state(X1,X1,U,V).
// Farmer takes Goat
state(X,Y,X,V) :-
  safe(X,Y,X,V),
  opp(X,X1),
  state(X1,Y,X1,V).
// Farmer takes Cabbage
state(X,Y,U,X) :-
  safe(X,Y,U,X),
  opp(X,X1),
  state(X1,Y,U,X1).
// Farmer goes by himself
state(X,Y,U,V) :-
  safe(X,Y,U,V),
  opp(X,X1),
  state(X1,Y,U,V).

// Opposite shores (n/s)
opp("n","s").
opp("s","n").

// Farmer is with Goat

// TODO: This triggers segfault
// safe(X,Y,X,V) :- safe(X,_,X,_).

// Rewrite non-ground rule  'safe(X,Y,X,V)' to:
safe("n","s","n","s").
safe("n","n","n","n").
safe("n","s","n","n").
safe("n","n","n","s").
safe("s","s","s","s").
safe("s","n","s","n").
safe("s","s","s","n").
safe("s","n","s","s").

// Farmer is not with Goat
safe(X,X,X1,X) :- opp(X,X1).


// ==== END: d:\work24\souffle-lsp-plugin\example\puzzle\puzzle.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(5,i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(6,i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(7, i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(8, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(9, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(10, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(11, i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(12, i) :- Check(a, _, c, _, _, f), In(a, _, c, _, _, f, i).
A(13, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(14, i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(15, i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====

