// Find the shortest outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl ShortestEdgeFromN(n:Node, l:number)
.output ShortestEdgeFromN()

ShortestEdgeFromN(x, l) :- Edge(x, _, _), l = min Z : Edge(x, _, Z).

// ==== END: d:\work24\souffle-lsp-plugin\example\shortest_edges\shortest_edges.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\factoring\factoring.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl gen(x : number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//factors excluding 1
.decl factor(num : number, fc : number)
factor(x, fc) :- gen(x), gen(fc), x % fc = 0, fc != 1.

//finds if there exist two numbers which multiply to x
.decl prod(num : number)
prod(x) :- gen(x), gen(a), gen(b), b != x, a != x, x = a*b.

//finds the prime factors
.decl p_factor(x : number, fc : number)
.output p_factor()
p_factor(x, fc) :- factor(x, fc), !prod(fc).

// ==== END: d:\work24\souffle-lsp-plugin\example\factoring\factoring.dl ====

