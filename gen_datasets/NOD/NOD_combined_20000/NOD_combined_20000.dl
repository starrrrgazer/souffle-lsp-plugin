// The Lehigh University Benchmark (LUBM)
// http://swat.cse.lehigh.edu/projects/lubm/
// ported by Anthony Potter
//
// Unary relations
.decl University (a:symbol)
.output University ()
.input University ()
.decl Person (a:symbol)
.output Person ()
.decl Employee (a:symbol)
.output Employee ()
.decl Faculty (a:symbol)
.output Faculty ()
.decl Professor (a:symbol)
.output Professor ()
.decl Course (a:symbol)
.output Course ()
.input Course ()
.decl AssociateProfessor (a:symbol)
.input AssociateProfessor ()
.decl AssistantProfessor (a:symbol)
.input AssistantProfessor ()
.decl Organization (a:symbol)
.output Organization ()
.decl Chair (a:symbol)
.output Chair ()
.decl Work (a:symbol)
.output Work ()
.decl Lecturer (a:symbol)
.output Lecturer ()
.input Lecturer ()
.decl Student (a:symbol)
.output Student ()
.decl GraduateStudent (a:symbol)
.input GraduateStudent ()
.decl ResearchAssistant (a:symbol)
.input ResearchAssistant ()
.decl GraduateCourse (a:symbol)
.input GraduateCourse ()
.decl UndergraduateStudent (a:symbol)
.input UndergraduateStudent ()
.decl ResearchGroup (a:symbol)
.output ResearchGroup ()
.input ResearchGroup ()
.decl Publication (a:symbol)
.output Publication ()
.input Publication ()
.decl TeachingAssistant (a:symbol)
.output TeachingAssistant ()
.input TeachingAssistant ()
.decl FullProfessor (a:symbol)
.input FullProfessor ()
.decl Department (a:symbol)
.input Department ()

// Binary relations
.decl hasAlumnus (a:symbol, b:symbol)
.output hasAlumnus ()
.decl degreeFrom (a:symbol, b:symbol)
.output degreeFrom ()
.decl member (a:symbol, b:symbol)
.output member ()
.decl teachingAssistantOf (a:symbol, b:symbol)
.input teachingAssistantOf ()
.decl headOf (a:symbol, b:symbol)
.input headOf ()
.decl teacherOf (a:symbol, b:symbol)
.input teacherOf ()
.decl publicationAuthor (a:symbol, b:symbol)
.input publicationAuthor ()
.decl doctoralDegreeFrom (a:symbol, b:symbol)
.input doctoralDegreeFrom ()
.decl undergraduateDegreeFrom (a:symbol, b:symbol)
.input undergraduateDegreeFrom ()
.decl mastersDegreeFrom (a:symbol, b:symbol)
.input mastersDegreeFrom ()
.decl subOrganizationOf (a:symbol, b:symbol)
.output subOrganizationOf ()
.input subOrganizationOf ()
.decl takesCourse (a:symbol, b:symbol)
.input takesCourse ()
.decl worksFor (a:symbol, b:symbol)
.output worksFor ()
.input worksFor ()
.decl memberOf (a:symbol, b:symbol)
.output memberOf ()
.input memberOf ()
.decl advisor (a:symbol, b:symbol)
.input advisor ()
.decl emailAddress (a:symbol, b:symbol)
.input emailAddress ()
.decl telephone (a:symbol, b:symbol)
.input telephone ()
.decl name (a:symbol, b:symbol)
.input name ()
.decl researchInterest (a:symbol, b:symbol)
.input researchInterest ()

// Ontology
University(Y) :- mastersDegreeFrom(_,Y) .
degreeFrom(X,Y) :- hasAlumnus(Y,X) .
hasAlumnus(X,Y) :- degreeFrom(Y,X) .
Employee(X) :- Faculty(X) .
Faculty(X) :- Professor(X) .
Professor(X) :- AssociateProfessor(X) .
Person(Y) :- member(_,Y) .
Professor(X) :- AssistantProfessor(X) .
Professor(X) :- Chair(X) .
worksFor(X,Y) :- headOf(X,Y) .
Person(X) :- degreeFrom(X,_) .
University(Y) :- degreeFrom(_,Y) .
Person(Y) :- hasAlumnus(_,Y) .
TeachingAssistant(X) :- Person(X), teachingAssistantOf(X,Y), Course(Y) .
Chair(X) :- Person(X), headOf(X,Y), Department(Y) .
memberOf(X,Y) :- member(Y,X) .
member(X,Y) :- memberOf(Y,X) .
Course(Y) :- teacherOf(_,Y) .
University(X) :- hasAlumnus(X,_) .
Person(X) :- telephone(X,_) .
Organization(Y) :- subOrganizationOf(_,Y) .
memberOf(X,Y) :- worksFor(X,Y) .
Person(X) :- Employee(X) .
Person(X) :- advisor(X,_) .
Organization(X) :- member(X,_) .
Organization(X) :- Department(X) .
Faculty(X) :- Lecturer(X) .
Person(Y) :- publicationAuthor(_,Y) .
Professor(Y) :- advisor(_,Y) .
Work(X) :- Course(X) .
Professor(X) :- FullProfessor(X) .
degreeFrom(X,Y) :- doctoralDegreeFrom(X,Y) .
TeachingAssistant(X) :- teachingAssistantOf(X,_) .
Person(X) :- undergraduateDegreeFrom(X,_) .
Organization(X) :- University(X) .
Person(X) :- doctoralDegreeFrom(X,_) .
University(Y) :- doctoralDegreeFrom(_,Y) .
Course(Y) :- teachingAssistantOf(_,Y) .
University(Y) :- undergraduateDegreeFrom(_,Y) .
degreeFrom(X,Y) :- mastersDegreeFrom(X,Y) .
Person(X) :- GraduateStudent(X) .
Person(X) :- ResearchAssistant(X) .
Student(X) :- UndergraduateStudent(X) .
degreeFrom(X,Y) :- undergraduateDegreeFrom(X,Y) .
Publication(X) :- publicationAuthor(X,_) .
Person(X) :- mastersDegreeFrom(X,_) .
Organization(X) :- ResearchGroup(X) .
Faculty(X) :- teacherOf(X,_) .
Person(X) :- Chair(X) .
Employee(X) :- Person(X), worksFor(X,Y), Organization(Y) .
Course(X) :- GraduateCourse(X) .
Student(X) :- Person(X), takesCourse(X,Y), Course(Y) .
Person(X) :- TeachingAssistant(X) .
Organization(X) :- subOrganizationOf(X,_) .
Person(X) :- Student(X) .
Person(X) :- emailAddress(X,_) .
subOrganizationOf(X,Z) :- subOrganizationOf(X,Y), subOrganizationOf(Y,Z) .

// ==== END: d:\work24\souffle-lsp-plugin\example\lubm\lubm.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minimum_spanning_tree\minimum_spanning_tree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2021, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

#define FALSE 0
#define TRUE 1

.decl graph(x:symbol, y:symbol, w:number)
.input graph()

.decl node(node_id:symbol)
node(x) :- graph(x,_,_) ; graph(_,x,_).

.decl edge(id:number, x:symbol, y:symbol, w:number)
edge(autoinc(),x,y,w) :- graph(x,y,w).

.decl edgePosition(id:number, pos:number)
edgePosition(id,0) :- edgeFirst(id).
edgePosition(id2,i+1) :- edgePosition(id1,i), edgeNext(id1,id2).

.decl edgeFirst(id1:number)
edgeFirst(id1) :- edge(id1,_,_,_), !edgeNext(_,id1).

.decl edgeNextCandidate(id1:number, id2:number)
edgeNextCandidate(id1, id2) :-
    edge(id1, _, _, w1),
    id2 = min id : { edge(id, _, _, w), w = w1, id > id1 }.

.decl edgeNext(id1:number, id2:number)
edgeNext(id1, id2) :-
    edge(id1, _, _, w1),
    w2 = min w : { edge(_, _, _, w), w > w1 },
    id2 = min id : { edge(id, _, _, w), w = w2 },
    !edgeNextCandidate(id1,_).

edgeNext(id1,id2) :- edgeNextCandidate(id1,id2).

.decl startNode(node_id: symbol)
startNode(node_id) :- edge(0, node_id, _, _).

.decl validStep(step:number)
validStep(0).
validStep(step+1) :- validStep(step), step < count : node(_).

.decl addedNode(step:number, node_id:symbol)
addedNode(0, start) :- startNode(start).
addedNode(step+1, node_id) :-
    validStep(step+1),
    (addedNode(step, node_id) ; chosenNode(step, node_id)).

.decl unaddedNode(step:number, node_id:symbol)
unaddedNode(0, node_id) :- node(node_id), !startNode(node_id).
unaddedNode(prev_step+1, node_id) :-
    unaddedNode(prev_step, node_id),
    chosenEdge(prev_step, new_edge_id),
    edge(new_edge_id, _, y, _),
    node_id != y.

.decl validEdge(step:number, edge_id: number)
validEdge(step, edge_id) :-
    reachableEdge(step, edge_id),
    edge(edge_id, _, node_id, _),
    unaddedNode(step, node_id),
    unusedEdge(step, edge_id).

.decl reachableEdge(step:number, edge_id:number)
reachableEdge(step, edge_id) :-
    addedNode(step, node_id),
    edge(edge_id, node_id, _, _).

.decl unusedEdge(step:number, edge_id:number)
unusedEdge(0, edge_id) :- edge(edge_id,_,_,_).
unusedEdge(prev_step+1, edge_id) :-
    unusedEdge(prev_step, edge_id),
    chosenEdge(prev_step, new_edge_id),
    new_edge_id != edge_id.

.decl notValidEdge(step:number, edge_id:number)
notValidEdge(step, edge_id) :-
    validStep(step),
    chosenEdge(prev_step, edge_id),
    prev_step < step.
notValidEdge(step, edge_id) :-
    unaddedNode(step, node_id),
    edge(edge_id, node_id, _, _).
notValidEdge(step, edge_id) :-
    addedNode(step, node_id),
    edge(edge_id, _, node_id, _).

.decl chosenEdge(step:number, edge_id:number)
chosenEdge(step, edge_id) :-
    chosenEdgeInductive(step, edge_position, TRUE),
    edgePosition(edge_id, edge_position).

.decl chosenEdgeInductive(step:number, edge_position:number, is_chosen:number)

chosenEdgeInductive(step, -1, FALSE) :- validStep(step).

chosenEdgeInductive(step, cur_edge_pos, is_chosen) :-
    chosenEdgeInductive(step, prev_edge_pos, FALSE),
    edgePosition(edge_id, cur_edge_pos),
    cur_edge_pos = prev_edge_pos + 1,
    ((validEdge(step, edge_id), is_chosen = TRUE) ;
     (notValidEdge(step, edge_id), is_chosen = FALSE)).

.decl chosenNode(step:number, node_id:symbol)
chosenNode(step, node_id) :-
    chosenEdge(step, edge_id),
    edge(edge_id, _, node_id, _).

.decl prims_trace(step:number, edge_id:number, x:symbol, y:symbol, w:number)
prims_trace(step, edge_id, x, y, w) :-
    chosenEdge(step, edge_id),
    edge(edge_id, x, y, w).

.decl minimum_spanning_tree(c:number)
minimum_spanning_tree(sum w : { prims_trace(_,_,_,_,w) }).

.output minimum_spanning_tree

// ==== END: d:\work24\souffle-lsp-plugin\example\minimum_spanning_tree\minimum_spanning_tree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\trans\trans.dl ====
// Type declarations
.type S <: symbol

// Set output flag depending on stage
.decl A (x:S, y:S)
.output A ()

// Transitive Closure
A(x,z) :- A(x,y), A(y,z).

// Facts
A("a","b").
A("b","c").
A("c","d").
A("d","e").

