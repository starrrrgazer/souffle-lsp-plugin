//
// Souffle - A Datalog Compiler
// Copyright (c) 2015, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// This code computes the dominance relation of a rooted directed graph
// given via its edge set.
//
// The dominance relation is defined as the least fixed-point of
// the following equations:
//   dom(start) := {start}
//   dom(n) := {n} \/ /\_{p in preds(n) dom(p),   for all n <> start
//
// To compute the fixed-point in Datalog, we are required to switch
// to union semantics, hence, the dual problem:
//   non-dom(start) := node-set \ {start}
//   non-dom(start) := node-set \ {n} /\ \/_{p in preds(n)}  non-dom(p), for all n <> start
//


// Additionally, this code computes the immediate dominators.
// The immediate dominator of a node n is the unique node that strictly dominates n but
// does not strictly dominate any other node that strictly dominates n. Every node,
// except the entry node, has an immediate dominator.
//
// We use subsumption to find the 'closest' dominator.
// Base case: immediate_dom(x, y) if y strictly domiantes x.
// Subsumption: for x's two immediate dominators y1 and y2, discard y1 if y2 is dominated by y1.
// This means y2 is lower in the path, hence 'closer' to x.



.comp Dominance<N>{

      //
      // Start node (singleton)
      //
      .decl start(s:N)

      //
      // Set of edges
      //
      .decl edge(s:N,d:N)

      //
      // Set of nodes
      //
      .decl node(n:N)
      node(x) :- edge(x,_).
      node(x) :- edge(_,x).

      //
      // Non-dominance of input graph
      //
      .decl non_dom(s:N,d:N)
      non_dom(x,y) :- start(x), node(y), x!=y.
      non_dom(x,y) :- non_dom(z,y), edge(z,x), !start(x), x!=y .


      //
      // Dominance of input graph
      //
      .decl dom(s:N,d:N)
      dom(x,y) :- node(x), node(y), !non_dom(x,y).

      //
      // Finds nodes that strictly dominate a node
      //
      .decl s_dom(n:N,d:N)
      s_dom(n,d) :- dom(n,d), n != d.

}


.comp ImmediateDominance<N> : Dominance<N>{

      //
      // Immediate Dominator
      //
      .decl imdom(n:N,i:N)
      imdom(n,x) :- s_dom(n,x).
      imdom(n,x1) <= imdom(n, x2) :- dom(x2, x1).

}

//
// The graph is taken from figure 9.38 in
// "Compilers Principles, Techniques and Tools" Edition 2
// by V.Aho et al.
//

.init ImmDom = ImmediateDominance<number>

ImmDom.edge(1, 2).
ImmDom.edge(1, 3).
ImmDom.edge(2, 3).
ImmDom.edge(4, 3).
ImmDom.edge(8, 3).
ImmDom.edge(3, 4).
ImmDom.edge(8, 4).
ImmDom.edge(4, 5).
ImmDom.edge(4, 6).
ImmDom.edge(5, 7).
ImmDom.edge(6, 7).
ImmDom.edge(10, 7).
ImmDom.edge(7, 8).
ImmDom.edge(8, 9).
ImmDom.edge(8, 10).
ImmDom.edge(9, 1).
ImmDom.start(1).


//
// Output
//

.decl dominators(n:number,s:number)
.output dominators()
dominators(n,s) :- ImmDom.dom(n,s).


//
// Output
//

.decl immediate_dom(n:number,s:number)
.output immediate_dom()
immediate_dom(n,s) :- ImmDom.imdom(n,s).



// ==== END: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====
//
// Example: data flow analysis
//
// This example is computing live variables.
//


//// --- definitions --- ////

.type Node <: symbol

// control flow graph (input)
.decl cf_edge(x:Node,y:Node)


// mark nodes in the graph using and defining variables
.type Var <: symbol

.decl use(x:Node, v:Var)
.decl def(x:Node, v:Var)

//// --- result --- ////

.decl live_vars_in(x:Node, v:Var)
.output live_vars_in()
.decl live_vars_out(x:Node, v:Var)
.output live_vars_out()

//////////////////////////////////////////////////

cf_edge("A","B").
cf_edge("B","C").
cf_edge("C","C").
cf_edge("C","D").
cf_edge("B","D").
cf_edge("D","E").


// use and def

def("A", "x1").

use("B", "x1").
def("B", "x2").

use("C", "x2").
def("C", "x2").

use("D", "x2").
def("D", "x3").

use("E", "x2").
use("E", "x3").

//////////////////////////////////////////////////

live_vars_in(x,v) :- use(x,v).
live_vars_in(x,v) :- !def(x,v), live_vars_out(x,v).

live_vars_out(x,v) :- cf_edge(x,y), live_vars_in(y,v).





// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_live_vars\dfa_live_vars.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\fib\fib.dl ====
.type Integer <: symbol

.decl plus_mod (x:Integer, y:Integer, r:Integer)
.decl succ (a:Integer, b:Integer)
.decl f(x:Integer, y:Integer)
.output f()

f("0", "0").
f("1", "1").
f(i, r) :- succ(prev, i), succ(pprev, prev),f(prev, x), f(pprev, y), plus_mod(x, y, r).


plus_mod("0", "0", "0").
plus_mod("0", "1", "1").
plus_mod("1", "0", "1").
plus_mod("1", "1", "2").
plus_mod("0", "2", "2").
plus_mod("2", "0", "2").
plus_mod("2", "1", "0").
plus_mod("1", "2", "0").
plus_mod("2", "2", "1").


succ("0", "1").
succ("1", "2").
succ("2", "3").
succ("3", "4").
succ("4", "5").
succ("5", "6").
succ("6", "7").
succ("7", "8").
succ("8", "9").
succ("9", "10").
succ("10", "11").
succ("11", "12").
succ("12", "13").
succ("13", "14").
succ("14", "15").
succ("15", "16").
succ("16", "17").
succ("17", "18").
succ("18", "19").
succ("19", "20").


// ==== END: d:\work24\souffle-lsp-plugin\example\fib\fib.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\not_match\not_match.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//// Test-case for string matching

.decl inputData(s:symbol)
.input inputData

.decl outputData(s:symbol)
.output outputData

outputData(x) :- inputData(x), !match("a.*", x).

// ==== END: d:\work24\souffle-lsp-plugin\example\not_match\not_match.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\k-permutations\k-permutations.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl S(s:symbol)
.decl P(s:symbol)

.input S

P(x) :- S(x).
P(cat(x, cat(",", y))) :- S(x), P(y), !contains(x, y).

.output P

// ==== END: d:\work24\souffle-lsp-plugin\example\k-permutations\k-permutations.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Simulates a Deterministic Finite Automata to parse strings

.type state <: symbol
.type string <: symbol
.type index <: number

.decl transition(from : state, on : string, to : state)
.input transition

.decl accepting(x : state)
.input accepting

.decl start(x : state)
.input start

.decl toparse(x : string)
.input toparse

// When parsing `in` we have processed `i` characters and are at state `cur`
.decl parse(in : string, cur : state, i : index)
parse(in,cur,0) :- toparse(in), start(cur).
parse(in,new,i+j) :-
    parse(in,old,i),
    transition(old,diff,new),
    j=strlen(diff),
    diff=substr(in,i,j).
// The rule above can cause the AST translator to fail in old versions of Souffle

.decl accept(in : string)
accept(in) :- parse(in,cur,strlen(in)), accepting(cur).

.decl out(s : string, result : symbol)
out(s, "Accept") :- accept(s).
out(s, "Reject") :- toparse(s), !accept(s).
.output out

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, _, _, d, e, f), In(a, _, _, d, e, f, i).
A(3,i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(4,i) :- Check(a, _, _, _, e, f), In(a, _, _, _, e, f, i).
A(5,i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(6,i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(7, i) :- Check(a, b, _, d, e, f), In(a, b, _, d, e, f, i).
A(8, i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(9, i) :- Check(a, b, _, _, _, f), In(a, b, _, _, _, f, i).
A(10, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(11, i) :- Check(a, b, c, _, e, f), In(a, b, c, _, e, f, i).
A(12, i) :- Check(a, _, c, _, _, f), In(a, _, c, _, _, f, i).
A(13, i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(14, i) :- Check(a, b, c, d, _, f), In(a, b, c, d, _, f, i).
A(15, i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po5\po5.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====
//
// Souffle - A Datalog Compiler
// Copyright (c) 2015, Oracle and/or its affiliates. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

//
// This code computes the dominance relation of a rooted directed graph
// given via its edge set.
//
// The dominance relation is defined as the least fixed-point of
// the following equations:
//   dom(start) := {start}
//   dom(n) := {n} \/ /\_{p in preds(n) dom(p),   for all n <> start
//
// To compute the fixed-point in Datalog, we are required to switch
// to union semantics, hence, the dual problem:
//   non-dom(start) := node-set \ {start}
//   non-dom(start) := node-set \ {n} /\ \/_{p in preds(n)}  non-dom(p), for all n <> start
//


// Additionally, this code computes the immediate dominators.
// The immediate dominator of a node n is the unique node that strictly dominates n but
// does not strictly dominate any other node that strictly dominates n. Every node,
// except the entry node, has an immediate dominator.
//
// We use subsumption to find the 'closest' dominator.
// Base case: immediate_dom(x, y) if y strictly domiantes x.
// Subsumption: for x's two immediate dominators y1 and y2, discard y1 if y2 is dominated by y1.
// This means y2 is lower in the path, hence 'closer' to x.



.comp Dominance<N>{

      //
      // Start node (singleton)
      //
      .decl start(s:N)

      //
      // Set of edges
      //
      .decl edge(s:N,d:N)

      //
      // Set of nodes
      //
      .decl node(n:N)
      node(x) :- edge(x,_).
      node(x) :- edge(_,x).

      //
      // Non-dominance of input graph
      //
      .decl non_dom(s:N,d:N)
      non_dom(x,y) :- start(x), node(y), x!=y.
      non_dom(x,y) :- non_dom(z,y), edge(z,x), !start(x), x!=y .


      //
      // Dominance of input graph
      //
      .decl dom(s:N,d:N)
      dom(x,y) :- node(x), node(y), !non_dom(x,y).

      //
      // Finds nodes that strictly dominate a node
      //
      .decl s_dom(n:N,d:N)
      s_dom(n,d) :- dom(n,d), n != d.

}


.comp ImmediateDominance<N> : Dominance<N>{

      //
      // Immediate Dominator
      //
      .decl imdom(n:N,i:N)
      imdom(n,x) :- s_dom(n,x).
      imdom(n,x1) <= imdom(n, x2) :- dom(x2, x1).

}

//
// The graph is taken from figure 9.38 in
// "Compilers Principles, Techniques and Tools" Edition 2
// by V.Aho et al.
//

.init ImmDom = ImmediateDominance<number>

ImmDom.edge(1, 2).
ImmDom.edge(1, 3).
ImmDom.edge(2, 3).
ImmDom.edge(4, 3).
ImmDom.edge(8, 3).
ImmDom.edge(3, 4).
ImmDom.edge(8, 4).
ImmDom.edge(4, 5).
ImmDom.edge(4, 6).
ImmDom.edge(5, 7).
ImmDom.edge(6, 7).
ImmDom.edge(10, 7).
ImmDom.edge(7, 8).
ImmDom.edge(8, 9).
ImmDom.edge(8, 10).
ImmDom.edge(9, 1).
ImmDom.start(1).


//
// Output
//

.decl dominators(n:number,s:number)
.output dominators()
dominators(n,s) :- ImmDom.dom(n,s).


//
// Output
//

.decl immediate_dom(n:number,s:number)
.output immediate_dom()
immediate_dom(n,s) :- ImmDom.imdom(n,s).



// ==== END: d:\work24\souffle-lsp-plugin\example\dominance\dominance.dl ====

