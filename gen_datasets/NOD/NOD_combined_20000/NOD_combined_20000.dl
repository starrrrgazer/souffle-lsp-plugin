// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\equal\equal.dl ====
.type Integer <: symbol

.decl succ (a:Integer, b:Integer)
.decl equal(x:Integer, y:Integer, r:Integer)
.output equal()
.decl isEqual(r:Integer)
.output isEqual()

equal("0", "0", "1").
equal(m, n, r) :- succ(pm, m) , succ(pn, n), equal(pm, pn, r).

isEqual(r) :- equal("5", "7", r).

succ("0", "1").
succ("1", "2").
succ("2", "3").
succ("3", "4").
succ("4", "5").
succ("5", "6").
succ("6", "7").
succ("7", "8").
succ("8", "9").
succ("9", "10").
succ("10", "11").
succ("11", "12").
succ("12", "13").
succ("13", "14").
succ("14", "15").
succ("15", "16").
succ("16", "17").
succ("17", "18").
succ("18", "19").
succ("19", "20").


