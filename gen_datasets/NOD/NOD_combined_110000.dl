.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(_, b, c, d, e, _), In(_, b, c, d, e, _, i).
A(2,i) :- Check(a, _, c, d, e, _), In(a, _, c, d, e, _, i).
A(3,i) :- Check(a, b, _, _, e, f), In(a, b, _, _, e, f, i).
A(4,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(5,i) :- Check(a, _, _, _, _, f), In(a, _, _, _, _, f, i).
A(6,i) :- Check(_, b, c, d, _, f), In(_, b, c, d, _, f, i).
A(7, i) :- Check(_, b, c, _, e, f), In(_, b, c, _, e, f, i).
A(8, i) :- Check(_, b, _, d, e, f), In(_, b, _, d, e, f, i).
A(9, i) :- Check(_, _, c, d, e, f), In(_, _, c, d, e, f, i).
A(10, i) :- Check(_, b, c, d, _, _), In(_, b, c, d, _, _, i).
A(11, i) :- Check(_, b, c, _, _, f), In(_, b, c, _, _, f, i).
A(12, i) :- Check(_, b, _, _, e, f), In(_, b, _, _, e, f, i).
A(13, i) :- Check(_, _, _, d, e, f), In(_, _, _, d, e, f, i).
A(14, i) :- Check(_, b, c, _, _, _), In(_, b, c, _, _, _, i).
A(15, i) :- Check(_, b, _, _, _, f), In(_, b, _, _, _, f, i).
A(16, i) :- Check(_, _, _, _, e, f), In(_, _, _, _, e, f, i).
A(17, i) :- Check(_, b, c, d, e, f), In(_, b, c, d, e, f, i).
A(18, i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).




// ==== END: d:\work24\souffle-lsp-plugin\example\po2\po2.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.type Node <: symbol
.type Card <: number

.decl Edge			(m:Node, n:Node)
.input Edge

Edge(m, n) :- Edge(n, m).

.decl Leaf			(n:Node)
.decl NotLeaf		(n:Node)

NotLeaf(n) :- Edge(a, n), Edge(b, n), a != b.
Leaf(n) :- Edge(_, n), !NotLeaf(n).

.decl InSubtree		(m:Node, n:Node, a:Node)

InSubtree(m, n, n) :- Edge(m, n).
InSubtree(m, n, a) :- Edge(m, n), Edge(n, p), InSubtree(n, p, a), m != p.

.decl TreeCard		(c:Card)
.decl SubtreeCard	(m:Node, n:Node, c:Card)

TreeCard(a + b) :- a = sum 1 : Leaf(_), b = sum 1 : NotLeaf(_).

SubtreeCard(m, n, c) :- Edge(m, n), c = sum 1 : InSubtree(m, n, _).

.decl Centroid		(n:Node)
.decl NotCentroid	(n:Node)

NotCentroid(n) :- TreeCard(c), SubtreeCard(n, _, d), d > c/2.
Centroid(n) :- Edge(n, _), !NotCentroid(n).

.output Centroid

// ==== END: d:\work24\souffle-lsp-plugin\example\centroids\centroids.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl Edge(vertex1:symbol,vertex2:symbol,weight:number)
Edge(a,b,w) :-
  Edge(b,a,w).

Edge("a","a",1).
Edge("a","b",1).
Edge("a","c",2).
Edge("b","d",2).
Edge("b","e",3).
Edge("c","d",3).
Edge("c","e",4).
Edge("d","f",1).
Edge("e","f",6).

.decl Limit(weight:number)
Limit(h) :- h = sum w : Edge(_,_,w).

.decl Path(source:symbol,destination:symbol,path:number)
Path(a,c,w) :- Edge(a,c,w).
Path(a,c,w1+w2) :-
  Limit(h),
  Edge(a,b,w1),
  Path(b,c,w2),
    w2 < h-w1.

.decl FindingShorterPath(source:symbol,destination:symbol,weight:number)
FindingShorterPath(a,b,w1) :-
  Path(a,b,w1),
  Path(a,b,w2),
  w2<w1.

.decl ShortestPath(source:symbol,destination:symbol,weight:number)
ShortestPath(a,b,w) :-
  Path(a,b,w),
  !FindingShorterPath(a,b,w).

.output ShortestPath




// ==== END: d:\work24\souffle-lsp-plugin\example\minpath1\minpath1.dl ====

