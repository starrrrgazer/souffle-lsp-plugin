// Souffle - A Datalog Compiler
// Copyright (c) 2017, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl CurrentNode(DistanceToSink:number, deadline:number)

CurrentNode(20,10).
.output CurrentNode()


.decl NeighborNode(DistanceToSink:number,DelayToNeighbor:number, id:symbol)

NeighborNode(8,1,"a").
NeighborNode(7,8,"b").
NeighborNode(11,10,"c").
NeighborNode(4,2,"d").
.output NeighborNode()



.decl CandidateNode(DistanceToNeighbor:number,DelayToNeighbor:number, id:symbol)
CandidateNode(distance1-distance,delay,id) :-
	NeighborNode(distance,delay,id),  CurrentNode(distance1,deadline), distance<distance1, ((distance1-distance)/delay)>=(distance1/deadline).
.output CandidateNode()



.decl NextHop(id:symbol, speed:number)
NextHop(id,speed) :-
	CandidateNode(distance1,delay1,id), speed = max (distance/delay) : CandidateNode(distance,delay,_), speed=distance1/delay1.
.output NextHop()


// ==== END: d:\work24\souffle-lsp-plugin\example\speed\speed.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2018, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Simulates a Deterministic Finite Automata to parse strings

.type state <: symbol
.type string <: symbol
.type index <: number

.decl transition(from : state, on : string, to : state)
.input transition

.decl accepting(x : state)
.input accepting

.decl start(x : state)
.input start

.decl toparse(x : string)
.input toparse

// When parsing `in` we have processed `i` characters and are at state `cur`
.decl parse(in : string, cur : state, i : index)
parse(in,cur,0) :- toparse(in), start(cur).
parse(in,new,i+j) :-
    parse(in,old,i),
    transition(old,diff,new),
    j=strlen(diff),
    diff=substr(in,i,j).
// The rule above can cause the AST translator to fail in old versions of Souffle

.decl accept(in : string)
accept(in) :- parse(in,cur,strlen(in)), accepting(cur).

.decl out(s : string, result : symbol)
out(s, "Accept") :- accept(s).
out(s, "Reject") :- toparse(s), !accept(s).
.output out

// ==== END: d:\work24\souffle-lsp-plugin\example\dfa_parse\dfa_parse.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

// Find the shorted outward edge for every Node
.type Node <: symbol

.decl Edge(n:Node, m:Node, w:number)
.input Edge()

.decl OutDegree(n:Node, l:number)
.output OutDegree()

OutDegree(x, l) :- Edge(x, _, _), l = sum 1 : Edge(x, _, _).

.decl InDegree(n:Node, l:number)
.output InDegree()

InDegree(x, l) :- Edge(_, x, _), l = sum 1 : Edge(_, x, _).

// ==== END: d:\work24\souffle-lsp-plugin\example\degree\degree.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\factoring\factoring.dl ====
// Souffle - A Datalog Compiler
// Copyright (c) 2016, The Souffle Developers. All rights reserved
// Licensed under the Universal Permissive License v 1.0 as shown at:
// - https://opensource.org/licenses/UPL
// - <souffle root>/licenses/SOUFFLE-UPL.txt

.decl gen(x : number)
gen(1).
gen(x+1) :- gen(x), !lim(x).

.decl lim(x : number)
lim(100).

//factors excluding 1
.decl factor(num : number, fc : number)
factor(x, fc) :- gen(x), gen(fc), x % fc = 0, fc != 1.

//finds if there exist two numbers which multiply to x
.decl prod(num : number)
prod(x) :- gen(x), gen(a), gen(b), b != x, a != x, x = a*b.

//finds the prime factors
.decl p_factor(x : number, fc : number)
.output p_factor()
p_factor(x, fc) :- factor(x, fc), !prod(fc).

// ==== END: d:\work24\souffle-lsp-plugin\example\factoring\factoring.dl ====

// ==== BEGIN: d:\work24\souffle-lsp-plugin\example\po4\po4.dl ====
.decl Check(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number)
.input Check()
.decl In(n1:number, n2:number, n3:number, n4:number, n5:number, n6: number, in:number)
.input In()
.decl A(l:number, o:number)
.output A()

A(1,i) :- Check(a, b, c, d, e, f), In(a, b, c, d, e, f, i).
A(2,i) :- Check(a, b, c, d, _, _), In(a, b, c, d, _, _, i).
A(3,i) :- Check(a, _, c, d, _, _), In(a, _, c, d, _, _, i).
A(4,i) :- Check(a, b, _, d, _, _), In(a, b, _, d, _, _, i).
A(5,i) :- Check(a, b, c, _, _, _), In(a, b, c, _, _, _, i).
A(6,i) :- Check(_, _, c, d, _, _), In(_, _, c, d, _, _, i).
A(7, i) :- Check(a, b, _, _, _, _), In(a, b, _, _, _, _, i).
A(8, i) :- Check(a, _, _, _, _, _), In(a, _, _, _, _, _, i).
A(9, i) :- Check(_, b, _, _, _, _), In(_, b, _, _, _, _, i).

