//
// Compute the sum of a graph
//

.decl Edge      (x:number, y:number, z:number)
.decl Linksum      (x:number, y:number, z:number)
.output Linksum      ()
.decl A (x:number, y:number, z:number)
.decl R (x:number, y:number)

Linksum(X,Y,N) :- Edge(X,Y,N).
Linksum(X,Y,R) :- Edge(X,Z,N), Linksum(Z,Y,M), A(M, N, R).

A(X,Y,X+Y) :- R(X,Y).

Edge(1,2,1).
Edge(1,3,1).
Edge(2,6,1).
Edge(2,4,1).
Edge(4,2,1).
Edge(3,5,1).
Edge(3,4,1).
Edge(5,6,1).

R(0,0).
R(1,0).
R(1,1).
R(2,0).
R(2,1).
R(2,2).
R(0,3).
R(1,3).
R(3,2).
R(3,3).
R(0,4).
R(4,1).
R(2,4).
R(3,4).
R(4,4).
R(0,5).
R(1,5).
R(2,5).
R(3,5).
R(4,5).
R(5,5).
R(5,0).
R(5,1).
R(5,2).
R(5,3).
R(5,4).
R(5,5).

